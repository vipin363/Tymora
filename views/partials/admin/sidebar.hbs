<div class="mo-overlay" id="logoutModal" style="display:none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 10000;">
    <div class="lo-box"
        style="background:#fff; border-radius:16px; width:380px; padding:28px; box-shadow:0 16px 40px rgba(0,0,0,.12); margin: 100px auto;">
        <h3 style="color:#0f172a; font-size:1rem; font-weight:700; margin-bottom:8px;">Confirm Logout</h3>
        <p style="color:#64748b; font-size:0.84rem; margin-bottom:22px;">Are you sure you want to log out of the admin
            panel?</p>
        <div style="display:flex; justify-content:flex-end; gap:12px;">
            <button onclick="closeLogoutModal()"
                style="padding:9px 20px; border-radius:8px; border:1px solid #d1d5db; background:transparent; cursor:pointer;">Cancel</button>
            <button onclick="window.location.href='/admin/logout'"
                style="padding:9px 20px; border-radius:8px; border:none; background:#ef4444; color:#fff; cursor:pointer; font-weight:700;">Logout</button>
        </div>
    </div>
</div>

<script>
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');
        if (sidebar) sidebar.classList.toggle('open');
        if (overlay) overlay.classList.toggle('open');
    }
    function openLogoutModal() { 
        const modal = document.getElementById('logoutModal');
        if (modal) modal.style.display = 'block'; 
    }
    function closeLogoutModal() { 
        const modal = document.getElementById('logoutModal');
        if (modal) modal.style.display = 'none'; 
    }
</script>
