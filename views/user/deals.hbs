<link rel="stylesheet" href="/deals.css">

<!-- HERO SECTION -->
<section class="deals-hero">
  <div class="hero-bg-glow"></div>
  <div class="hero-content reveal-item">
    <div class="hero-eyebrow">EXCLUSIVE ACCESS</div>
    <h1 class="hero-title">Deals & <span class="accent-gold">Offers</span></h1>
    <p class="hero-desc">Save more with active coupons, seasonal campaigns, and limited-time luxury offers curated for
      you.</p>
    <div class="hero-stats">
      <div class="stat-box">
        <span class="stat-num">{{couponCount}}</span>
        <span class="stat-label">Active Coupons</span>
      </div>
      <div class="stat-box">
        <span class="stat-num">{{offerCount}}</span>
        <span class="stat-label">Special Offers</span>
      </div>
    </div>
  </div>
</section>

<!-- Sentinel: sits exactly where the filter bar starts. When this leaves the viewport top, the bar becomes sticky -->
<div class="filter-sentinel" id="filterSentinel"></div>

<!-- SEARCH & FILTERS -->
<section class="deals-filters" id="dealsFilters">
  <div class="filter-container">
    <div class="search-box">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="dealSearch" placeholder="Search by name, code or description..." onkeyup="filterDeals()">
    </div>
    <div class="filter-chips">
      <button class="chip active" data-filter="all" onclick="setFilter('all')">All Deals</button>
      <button class="chip" data-filter="coupon" onclick="setFilter('coupon')">Coupons</button>
      <button class="chip" data-filter="offer" onclick="setFilter('offer')">Offers</button>
    </div>
  </div>
</section>

<!-- Placeholder: same height as the filter bar, shown only when bar is fixed to prevent content jump -->
<div class="filter-placeholder" id="filterPlaceholder"></div>

<!-- MAIN CONTENT -->
<section class="deals-grid-section">
  {{#if totalDealsCount}}
  <div class="deals-grid" id="dealsGrid">

    <!-- COUPONS -->
    {{#each coupons}}
    <div class="deal-card coupon-card reveal-scroll deal-item" data-type="coupon"
      data-text="{{toLowerCase this.code}} {{toLowerCase this.title}} {{toLowerCase this.description}}">
      <div class="deal-badge-top">COUPON</div>
      <div class="deal-body">
        <div class="deal-value">{{this.discountStr}}</div>
        <h3 class="deal-title">{{this.title}}</h3>
        {{#if this.description}}
        <p class="deal-desc">{{this.description}}</p>
        {{/if}}

        <ul class="deal-reqs">
          <li><i class="fas fa-shopping-bag"></i> Min. Order: ₹{{this.minPurchase}}</li>
          {{#if this.maxDiscountLimit}}
          <li><i class="fas fa-tag"></i> Max Discount: ₹{{this.maxDiscountLimit}}</li>
          {{/if}}
          <li><i class="far fa-clock"></i> Valid till {{this.endDateFormatted}}</li>
        </ul>
      </div>
      <div class="deal-footer">
        <div class="code-display">{{this.code}}</div>
        <button class="copy-btn" onclick="copyToClipboard('{{this.code}}', this)">
          <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          Copy
        </button>
      </div>
    </div>
    {{/each}}

    <!-- OFFERS -->
    {{#each offers}}
    <div class="deal-card offer-card reveal-scroll deal-item" data-type="offer"
      data-text="{{toLowerCase this.name}} {{toLowerCase this.offerBadgeText}} {{toLowerCase this.description}}">
      <div class="deal-badge-top">{{#if this.offerBadgeText}}{{this.offerBadgeText}}{{else}}OFFER{{/if}}</div>
      <div class="deal-body">
        <div class="deal-value">{{this.discountStr}}</div>
        <h3 class="deal-title">{{this.name}}</h3>
        {{#if this.description}}
        <p class="deal-desc">{{this.description}}</p>
        {{/if}}

        <ul class="deal-reqs">
          {{#if this.minPurchaseAmount}}
          <li><i class="fas fa-shopping-bag"></i> Min. Order: ₹{{this.minPurchaseAmount}}</li>
          {{/if}}

          {{#if this.applicableProducts.length}}
          <li><i class="fas fa-box"></i> Selected Products</li>
          {{/if}}
          {{#if this.applicableCategories.length}}
          <li><i class="fas fa-layer-group"></i> Selected Categories</li>
          {{/if}}
          {{#if this.applicableBrands.length}}
          <li><i class="fas fa-star"></i> Selected Brands</li>
          {{/if}}
          {{#ifEquals this.offerType "global"}}
          <li><i class="fas fa-globe"></i> Sitewide Global Offer</li>
          {{/ifEquals}}

          <li><i class="far fa-clock"></i> Valid till {{this.endDateFormatted}}</li>
        </ul>
      </div>
      <div class="deal-footer">
        <button class="shop-now-btn" onclick="window.location.href='/user/shop'">Shop Collection</button>
      </div>
    </div>
    {{/each}}

  </div>

  <!-- EMPTY STATE (Hidden by default, shown by JS when filters yield 0 results) -->
  <div id="noResults" class="empty-state" style="display: none;">
    <svg viewBox="0 0 24 24" width="64" height="64" stroke="#475569" fill="none" stroke-width="1.5">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <h3>No Deals Found</h3>
    <p>Try adjusting your filters or search query.</p>
  </div>

  {{else}}
  <!-- EMPTY STATE (Server side) -->
  <div class="empty-state reveal-item">
    <svg viewBox="0 0 24 24" width="64" height="64" stroke="#D4AF37" fill="none" stroke-width="1.5">
      <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
    </svg>
    <h3>No Active Deals Right Now</h3>
    <p>Check back later for upcoming seasonal promotions, exclusive coupons, and limited-time luxury offers.</p>
    <button class="btn-luxury-outline" onclick="window.location.href='/user/shop'" style="margin-top:20px;">Explore
      Collection</button>
  </div>
  {{/if}}
</section>

<!-- TOAST -->
<div id="copyToast" class="toast-notification">
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5">
    <polyline points="20 6 9 17 4 12"></polyline>
  </svg>
  <span>Coupon copied successfully!</span>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
  let currentFilter = 'all';

  function setFilter(type) {
    currentFilter = type;
    document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
    document.querySelector(`.chip[data-filter="${type}"]`).classList.add('active');
    filterDeals();
  }

  function filterDeals() {
    const query = document.getElementById('dealSearch').value.toLowerCase();
    const items = document.querySelectorAll('.deal-item');
    let visibleCount = 0;

    items.forEach(item => {
      const type = item.getAttribute('data-type');
      const text = item.getAttribute('data-text');

      const matchType = currentFilter === 'all' || type === currentFilter;
      const matchText = text.includes(query);

      if (matchType && matchText) {
        item.style.display = 'flex';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    const noResults = document.getElementById('noResults');
    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'flex' : 'none';
    }
  }

  function copyToClipboard(code, btn) {
    navigator.clipboard.writeText(code).then(() => {
      const origText = btn.innerHTML;
      btn.innerHTML = `<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Copied`;
      btn.classList.add('copied');

      showToast();

      setTimeout(() => {
        btn.innerHTML = origText;
        btn.classList.remove('copied');
      }, 2000);
    });
  }

  function showToast() {
    const toast = document.getElementById('copyToast');
    toast.classList.add('show');
    setTimeout(() => {
      toast.classList.remove('show');
    }, 3000);
  }

  // ── Smart Sticky Filter Bar via IntersectionObserver ──────────────
  const filterBar = document.getElementById('dealsFilters');
  const sentinel = document.getElementById('filterSentinel');
  const placeholder = document.getElementById('filterPlaceholder');

  function activateSticky() {
    // Measure real navbar height dynamically
    const nav = document.querySelector('nav');
    const navH = nav ? nav.getBoundingClientRect().height : 70;
    const barH = filterBar.getBoundingClientRect().height;

    filterBar.style.top = navH + 'px';
    filterBar.classList.add('is-sticky');

    // Placeholder prevents the page content from jumping up
    placeholder.style.height = barH + 'px';
    placeholder.classList.add('active');
  }

  function deactivateSticky() {
    filterBar.style.top = '';
    filterBar.classList.remove('is-sticky');
    placeholder.style.height = '';
    placeholder.classList.remove('active');
  }

  if (sentinel && filterBar && placeholder) {
    function handleSticky() {
      const nav = document.querySelector('nav');
      const navH = nav ? nav.getBoundingClientRect().height : 70;
      // Where is the sentinel's top relative to the viewport?
      const sentinelTop = sentinel.getBoundingClientRect().top;

      if (sentinelTop <= navH) {
        // Sentinel has gone above/at the navbar bottom → activate sticky
        if (!filterBar.classList.contains('is-sticky')) {
          const barH = filterBar.getBoundingClientRect().height;
          filterBar.style.top = navH + 'px';
          filterBar.classList.add('is-sticky');
          placeholder.style.height = barH + 'px';
          placeholder.classList.add('active');
        }
      } else {
        // Sentinel is still below navbar → deactivate sticky
        if (filterBar.classList.contains('is-sticky')) {
          filterBar.style.top = '';
          filterBar.classList.remove('is-sticky');
          placeholder.style.height = '';
          placeholder.classList.remove('active');
        }
      }
    }

    window.addEventListener('scroll', handleSticky, { passive: true });
    window.addEventListener('resize', handleSticky, { passive: true });
    // Run once on load in case user is already scrolled
    handleSticky();
  }

  // Init GSAP animations
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);

      gsap.fromTo('.reveal-item',
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, duration: 1, stagger: 0.15, ease: 'power3.out' }
      );

      document.querySelectorAll('.reveal-scroll').forEach(el => {
        gsap.fromTo(el,
          { opacity: 0, y: 40 },
          {
            scrollTrigger: { trigger: el, start: 'top 85%' },
            opacity: 1, y: 0, duration: 0.8, ease: 'power3.out'
          }
        );
      });
    }
  });
</script>