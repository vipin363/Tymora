<link href="/userAllProducts.css" rel="stylesheet">
<link href="/userCart.css" rel="stylesheet">
<style>
  .cart-item-card.oos {
    opacity: 0.6;
  }
  .cart-item-card.oos .qty-btn,
  .cart-item-card.oos .qty-input {
    pointer-events: none;
    opacity: 0.35;
  }
  .ci-oos-badge {
    display: inline-block;
    margin-top: 6px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #e05252;
    border: 1px solid #e05252;
    padding: 2px 10px;
    border-radius: 20px;
    font-family: 'Montserrat', sans-serif;
  }
  .btn-checkout.blocked {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }
  .checkout-blocked-msg {
    margin-top: 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #e05252;
    text-align: center;
    font-family: 'Montserrat', sans-serif;
  }
  .ci-view-product {
    display: inline-block;
    margin-top: 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--gold, #d4af37);
    text-decoration: none;
    font-family: 'Montserrat', sans-serif;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s, opacity 0.2s;
    opacity: 0.85;
  }
  .ci-view-product:hover {
    border-bottom-color: var(--gold, #d4af37);
    opacity: 1;
  }
</style>

<div class="cart-container">
  <!-- BREADCRUMB -->
 <div class="breadcrumb">
  <a href="/user/home">Home</a>&nbsp;›&nbsp;<span>CART</span>
</div>

  <!-- HEADER -->
  <div class="cart-header">
    <h1 class="cart-title">My <em>Cart</em></h1>
  </div>

  <div class="divider"></div>

  {{#if isEmpty}}
    <!-- EMPTY STATE -->
    <div class="empty-cart">
      <div class="empty-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </div>
      <h2>Your cart is empty</h2>
      <p>Discover our masterpieces and elevate your collection.</p>
      <a href="/user/shop" class="btn-shop-now">Explore Collection</a>
    </div>
  {{else}}
    <!-- MAIN CART CONTENT -->
    <div class="cart-main">
      
      <!-- CART ITEMS LIST -->
      <div class="cart-items-wrapper">
        {{#each cartItems}}
      <div class="cart-item-card {{#if this.isOutOfStock}}oos{{/if}}" data-id="{{this.id}}" data-stock="{{this.stock}}" data-product-id="{{this.productId}}" data-oos="{{#if this.isOutOfStock}}true{{else}}false{{/if}}">
           <div class="ci-image-wrap">
              <img src="{{this.img}}" alt="{{this.name}}">
            </div>
            
            <div class="ci-details">
              <div class="ci-brand">{{this.brand}}</div>
              <div class="ci-name">{{this.name}}</div>
              <div class="ci-price">₹{{formatCurrency this.price}}</div>
           {{#if this.isOutOfStock}}
                <span class="ci-oos-badge">OUT OF STOCK</span>
              {{else}}
                {{#if (lt this.stock 5)}}
                  <div class="ci-stock lowstock">Only {{this.stock}} left</div>
                {{/if}}
              {{/if}}
              <a href="/user/product/{{this.productId}}" class="ci-view-product">VIEW PRODUCT</a>
            </div>
            
            <div class="ci-controls">
              <div class="qty-selector">
                <button class="qty-btn minus-btn" data-id="{{this.id}}">-</button>
                <input type="text" class="qty-input" value="{{this.qty}}" readonly>
                <button class="qty-btn plus-btn" data-id="{{this.id}}">+</button>
              </div>
               <div class="ci-total">₹{{formatCurrency this.total}}</div>
            </div>

            <button class="ci-remove-btn" title="Remove Item" onclick="openRemoveModal('{{this.id}}')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 6L6 18M6 6l12 12"/>
              </svg>
            </button>
          </div>
        {{/each}}
      </div>

      <!-- ORDER SUMMARY -->
      <div class="cart-summary-wrapper">
        <div class="cart-summary-box">
          <h3 class="summary-title">Order Summary</h3>
          
         <div class="summary-items">
            {{#each cartItems}}
              <div class="summary-item-row" data-summary-id="{{this.id}}">
                <div class="summary-item-name">{{this.name}} <span class="summary-item-qty">×{{this.qty}}</span></div>
                <div class="summary-item-price">₹{{formatCurrency this.total}}</div>
              </div>
            {{/each}}
          </div>
          
          <div class="summary-divider"></div>
          
          <div class="summary-total-row">
            <span class="total-label">TOTAL</span>
             <span class="total-amount">₹{{formatCurrency subtotal}}</span>
          </div>

          <button class="btn-checkout {{#if hasOutOfStock}}blocked{{/if}}" id="checkoutBtn" {{#if hasOutOfStock}}disabled{{/if}} onclick="window.location.href='/user/checkout'">Proceed to Checkout</button>
          {{#if hasOutOfStock}}
            <div class="checkout-blocked-msg">Remove unavailable items to continue checkout.</div>
          {{/if}}
          <a href="/user/shop" class="btn-continue-shopping">Continue Shopping</a>
        </div>
      </div>
      
    </div>
  {{/if}}

</div>

<!-- REMOVE CONFIRMATION MODAL -->
<div class="modal-overlay" id="remove-modal" onclick="if(event.target===this)hideRemoveModal()">
  <div class="modal-box">
    <div class="modal-icon-wrap red-bg">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
      </svg>
    </div>
    <div class="modal-title-text">Remove Item?</div>
    <p class="modal-desc-text">Are you sure you want to remove this exquisite timepiece from your cart?</p>
    
    <div class="modal-buttons" style="margin-top:24px; display:flex; gap:16px;">
      <button class="modal-btn-cancel" onclick="hideRemoveModal()">Keep It</button>
      <button class="modal-btn-red" id="confirmRemoveBtn">Remove</button>
    </div>
  </div>
</div>

<script src="/js/cart.js"></script>
