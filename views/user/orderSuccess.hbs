<link href="/orderSuccess.css" rel="stylesheet">

<div class="os-wrapper">
  <div class="os-container">

    <!-- 1. HERO -->
    <div class="os-hero">
      <div class="os-icon">
        <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h1 class="os-title">Order Secured</h1>
      <p class="os-subtitle">Thank you for your order. Your masterwork is being prepared for delivery.</p>
      {{#if order.totalSaved}}
      <div class="os-savings">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M20 6L9 17l-5-5"></path>
        </svg>
        You saved ₹{{formatCurrency order.totalSaved}} on this order
      </div>
      {{/if}}
    </div>

    <!-- 2. INFO BAR -->
    <div class="os-info-bar">
      <div class="os-info-card">
        <div class="os-info-label">Order Number</div>
        <div class="os-info-val">#{{order.orderId}}</div>
      </div>
      <div class="os-info-card">
        <div class="os-info-label">Date</div>
        <div class="os-info-val">{{order.orderDateFormatted}}</div>
      </div>
      <div class="os-info-card">
        <div class="os-info-label">Est. Delivery</div>
        <div class="os-info-val">{{order.estimatedDeliveryFormatted}}</div>
      </div>
      <div class="os-info-card">
        <div class="os-info-label">Payment</div>
        <div class="os-info-val">{{order.paymentMethod}}</div>
      </div>
    </div>

    <!-- 3. TRACKING PROGRESS -->
    <div class="os-progress-box">
      <h3 class="os-progress-title">Shipment Status</h3>
      <div class="os-steps">
        {{#each order.trackingTimeline}}
        <div class="os-step {{#if this.completed}}active{{/if}}">
          <div class="os-step-dot">
            {{#if this.completed}}
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            {{/if}}
          </div>
          <div class="os-step-label">{{this.status}}</div>
        </div>
        {{/each}}
        <!-- Future statuses (greyed) -->
        <div class="os-step"><div class="os-step-dot"></div><div class="os-step-label">Confirmed</div></div>
        <div class="os-step"><div class="os-step-dot"></div><div class="os-step-label">Packed</div></div>
        <div class="os-step"><div class="os-step-dot"></div><div class="os-step-label">Shipped</div></div>
        <div class="os-step"><div class="os-step-dot"></div><div class="os-step-label">Delivered</div></div>
      </div>
    </div>

    <!-- 4. DETAILS GRID -->
    <div class="os-details-grid">

      <!-- Left: Products -->
      <div class="os-shipment">
        <h3 class="os-shipment-title">Vault Contents</h3>
        {{#each order.products}}
        <div class="os-prod-card">
          {{#if this.productImage}}
          <div class="os-prod-img">
            <img src="{{this.productImage}}" alt="{{this.productName}}">
          </div>
          {{/if}}
          <div class="os-prod-info">
            <div class="os-prod-name">{{this.productName}}</div>
            <div class="os-prod-specs">{{this.variantSpecs}} · Qty: {{this.quantity}}</div>
            {{#if (gt this.discountPercent 0)}}
            <div class="os-prod-specs" style="color: #4ade80;">{{this.discountPercent}}% OFF</div>
            {{/if}}
            <div class="os-prod-warranty">
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              2 Year Warranty
            </div>
          </div>
          <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 12px;">
            <div class="os-prod-price">₹{{formatCurrency this.itemTotal}}</div>
            {{#if (eq ../order.orderStatus "Delivered")}}
            <button class="btn-os-secondary" style="padding: 6px 12px; font-size: 9px; border-color: var(--gold); color: var(--gold);" onclick="openAddReviewModal('{{this.productId}}', '{{../order.orderId}}')">Add Review</button>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>

      <!-- Right: Financials + Address -->
      <div class="os-financial">
        <div class="os-fin-title">Financial Summary</div>

        <div class="os-fin-row">
          <span>Total MRP</span>
          <span>₹{{formatCurrency order.subtotalMrp}}</span>
        </div>
        <div class="os-fin-row" style="color: #4ade80;">
          <span>Discount</span>
          <span>- ₹{{formatCurrency order.discount}}</span>
        </div>
        <div class="os-fin-row">
          <span>Delivery</span>
          <span>{{#if (eq order.deliveryCharge 0)}}Free{{else}}₹{{formatCurrency order.deliveryCharge}}{{/if}}</span>
        </div>
        <div class="os-fin-row">
          <span>COD Charge</span>
          <span>₹{{formatCurrency order.codCharge}}</span>
        </div>
        <div class="os-fin-row">
          <span>CGST (9%)</span>
          <span>₹{{formatCurrency order.cgst}}</span>
        </div>
        <div class="os-fin-row">
          <span>SGST (9%)</span>
          <span>₹{{formatCurrency order.sgst}}</span>
        </div>

        <div class="os-fin-total">
          <span>Amount Payable</span>
          <span>₹{{formatCurrency order.totalAmount}}</span>
        </div>

        <div class="os-address">
          <div class="os-add-title">Delivering To</div>
          <div class="os-add-text">
            <strong>{{order.shippingAddress.fullName}}</strong><br>
            {{order.shippingAddress.addressLine}}<br>
            {{order.shippingAddress.city}}, {{order.shippingAddress.state}} {{order.shippingAddress.pincode}}<br>
            +91 {{order.shippingAddress.phone}}
          </div>
        </div>
      </div>

    </div>

    <!-- 5. ACTIONS -->
    <div class="os-actions">
      <button class="btn-os-primary" onclick="window.location.href='/user/orders'">Track My Orders</button>
      <button class="btn-os-secondary" onclick="window.location.href='/user/home'">Continue Exploring</button>
      {{#if order.canReturn}}
      <button class="btn-os-secondary" onclick="window.location.href='/user/orders/invoice/{{order.orderId}}'">Download Invoice</button>
      {{else}}
      <button class="btn-os-secondary" style="opacity: 0.5; cursor: not-allowed;" title="Invoice available after delivery" disabled>Download Invoice</button>
      {{/if}}
      
      {{#if order.canCancel}}
      <button class="btn-os-secondary" style="border-color: #ef4444; color: #ef4444;" onclick="openCancelModal('{{order.orderId}}')">Cancel Order</button>
      {{/if}}
      
      {{#if order.canReturn}}
      <button class="btn-os-secondary" style="border-color: #f59e0b; color: #f59e0b;" onclick="openReturnModal('{{order.orderId}}')">Return Order</button>
      {{/if}}
    </div>

  </div>
</div>

<!-- Cancel Order Modal -->
<div class="mo-modal-overlay" id="cancelModalOverlay" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(5px); z-index: 9999; display: none; align-items: center; justify-content: center;">
  <div class="mo-modal" style="background: #111; border: 1px solid rgba(201,168,76,0.3); border-radius: 12px; width: 400px; max-width: 90vw; padding: 30px; box-shadow: 0 20px 40px rgba(0,0,0,0.6);">
    <h3 style="color: var(--gold); font-family: 'Playfair Display', serif; margin-bottom: 16px; font-size: 1.5rem;">Cancel Order</h3>
    <p style="color: var(--muted); font-size: 13px; margin-bottom: 20px; line-height: 1.5;">Are you sure you want to cancel order <strong id="cancelOrderIdText"></strong>? This action cannot be undone.</p>
    <textarea id="cancelReasonInput" placeholder="Optional: Please tell us why you are cancelling this order..." style="width: 100%; height: 80px; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 12px; color: #fff; font-family: inherit; margin-bottom: 20px; resize: none; font-size: 13px;"></textarea>
    <div class="mo-modal-actions" style="display: flex; gap: 12px; justify-content: flex-end;">
      <button class="btn-os-secondary" style="background:transparent; color:#fff; border:1px solid #fff; padding: 10px 20px;" onclick="closeCancelModal()">Keep Order</button>
      <button class="btn-os-primary" style="background: #ef4444; color: #fff; border: none; padding: 10px 20px;" id="confirmCancelBtn">Confirm Cancel</button>
    </div>
  </div>
</div>

<!-- Return Order Modal -->
<div class="mo-modal-overlay" id="returnModalOverlay" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(5px); z-index: 9999; display: none; align-items: center; justify-content: center;">
  <div class="mo-modal" style="background: #111; border: 1px solid rgba(201,168,76,0.3); border-radius: 12px; width: 450px; max-width: 90vw; padding: 30px; box-shadow: 0 20px 40px rgba(0,0,0,0.6);">
    <h3 style="color: var(--gold); font-family: 'Playfair Display', serif; margin-bottom: 16px; font-size: 1.5rem;">Request Return</h3>
    
    <div style="margin-bottom: 20px; max-height: 150px; overflow-y: auto;">
      <p style="color: var(--white); font-size: 12px; margin-bottom: 8px;">Select Products to Return:</p>
      {{#each order.products}}
      <label style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px; font-size: 13px; color: var(--muted);">
        <input type="checkbox" class="return-product-cb" value="{{this.variantId}}" style="accent-color: var(--gold);">
        <img src="{{this.productImage}}" style="width: 30px; height: 30px; object-fit: contain; border-radius: 4px; background: #000;">
        {{this.productName}} (Qty: {{this.quantity}})
      </label>
      {{/each}}
    </div>

    <textarea id="returnReasonInput" placeholder="Mandatory: Please explain why you are returning the selected items..." style="width: 100%; height: 80px; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 12px; color: #fff; font-family: inherit; margin-bottom: 15px; resize: none; font-size: 13px;"></textarea>
    
    <p style="color: var(--white); font-size: 12px; margin-bottom: 8px;">Upload Evidence Images (Max 3):</p>
    <input type="file" id="returnEvidenceInput" multiple accept="image/*" style="width: 100%; margin-bottom: 20px; color: var(--muted); font-size: 12px;">

    <div class="mo-modal-actions" style="display: flex; gap: 12px; justify-content: flex-end;">
      <button class="btn-os-secondary" style="background:transparent; color:#fff; border:1px solid #fff; padding: 10px 20px;" onclick="closeReturnModal()">Cancel</button>
      <button class="btn-os-primary" style="background: #f59e0b; color: #000; border: none; padding: 10px 20px;" id="confirmReturnBtn">Submit Request</button>
    </div>
  </div>
</div>

<!-- Add Review Modal -->
<div class="mo-modal-overlay" id="addReviewModalOverlay" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(5px); z-index: 9999; display: none; align-items: center; justify-content: center;">
  <div class="mo-modal" style="background: #111; border: 1px solid rgba(201,168,76,0.3); border-radius: 12px; width: 400px; max-width: 90vw; padding: 30px; box-shadow: 0 20px 40px rgba(0,0,0,0.6);">
    <h3 style="color: var(--gold); font-family: 'Playfair Display', serif; margin-bottom: 16px; font-size: 1.5rem;">Rate Your Masterpiece</h3>
    <p style="color: var(--muted); font-size: 12px; margin-bottom: 20px;">Your feedback shapes our legacy.</p>

    <select id="reviewRatingInput" style="width: 100%; padding: 12px; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; color: #fff; margin-bottom: 15px; font-family: inherit;">
      <option value="" disabled selected>Select a Rating</option>
      <option value="5">5 ★ - Absolute Perfection</option>
      <option value="4">4 ★ - Very Good</option>
      <option value="3">3 ★ - Average</option>
      <option value="2">2 ★ - Needs Improvement</option>
      <option value="1">1 ★ - Disappointing</option>
    </select>

    <textarea id="reviewTextInput" placeholder="Tell us about the craftsmanship, feel, and experience..." style="width: 100%; height: 100px; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 12px; color: #fff; font-family: inherit; margin-bottom: 20px; resize: none; font-size: 13px;"></textarea>

    <div class="mo-modal-actions" style="display: flex; gap: 12px; justify-content: flex-end;">
      <button class="btn-os-secondary" style="background:transparent; color:#fff; border:1px solid #fff; padding: 10px 20px;" onclick="closeAddReviewModal()">Cancel</button>
      <button class="btn-os-primary" style="background: var(--gold); color: #000; border: none; padding: 10px 20px;" id="submitReviewBtn">Submit Review</button>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script>
  gsap.from('.os-hero', { y: -30, opacity: 0, duration: 1, ease: 'power3.out' });
  gsap.from('.os-info-card', { y: 20, opacity: 0, duration: 0.8, stagger: 0.1, delay: 0.3 });
  gsap.from('.os-progress-box', { y: 20, opacity: 0, duration: 0.8, delay: 0.5 });
  gsap.from('.os-shipment, .os-financial', { y: 30, opacity: 0, duration: 0.8, stagger: 0.2, delay: 0.7 });

  let targetCancelId = null;

  function openCancelModal(orderId) {
    targetCancelId = orderId;
    document.getElementById('cancelOrderIdText').innerText = '#' + orderId;
    document.getElementById('cancelReasonInput').value = '';
    document.getElementById('cancelModalOverlay').style.display = 'flex';
  }

  function closeCancelModal() {
    targetCancelId = null;
    document.getElementById('cancelModalOverlay').style.display = 'none';
  }

  const confirmBtn = document.getElementById('confirmCancelBtn');
  if (confirmBtn) {
    confirmBtn.addEventListener('click', async () => {
      if (!targetCancelId) return;
      
      const reason = document.getElementById('cancelReasonInput').value.trim();
      const btn = document.getElementById('confirmCancelBtn');
      btn.disabled = true;
      btn.innerText = 'Cancelling...';

      try {
        const res = await fetch('/user/orders/cancel', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderId: targetCancelId, reason })
        });
        const data = await res.json();
        
        if (data.success) {
          window.location.reload();
        } else {
          alert(data.message || 'Failed to cancel order.');
          btn.disabled = false;
          btn.innerText = 'Confirm Cancel';
        }
      } catch (err) {
        console.error(err);
        alert('An error occurred. Please try again.');
        btn.disabled = false;
        btn.innerText = 'Confirm Cancel';
      }
    });
  }
  let targetReturnId = null;

  function openReturnModal(orderId) {
    targetReturnId = orderId;
    document.getElementById('returnReasonInput').value = '';
    document.getElementById('returnEvidenceInput').value = '';
    document.querySelectorAll('.return-product-cb').forEach(cb => cb.checked = false);
    document.getElementById('returnModalOverlay').style.display = 'flex';
  }

  function closeReturnModal() {
    targetReturnId = null;
    document.getElementById('returnModalOverlay').style.display = 'none';
  }

  const confirmReturnBtn = document.getElementById('confirmReturnBtn');
  if (confirmReturnBtn) {
    confirmReturnBtn.addEventListener('click', async () => {
      if (!targetReturnId) return;

      const reason = document.getElementById('returnReasonInput').value.trim();
      if (!reason) {
        return alert("Please provide a reason for the return.");
      }

      const selectedCbs = document.querySelectorAll('.return-product-cb:checked');
      if (selectedCbs.length === 0) {
        return alert("Please select at least one product to return.");
      }

      const returnedProducts = Array.from(selectedCbs).map(cb => cb.value);
      const files = document.getElementById('returnEvidenceInput').files;

      if (files.length > 3) {
        return alert("You can only upload a maximum of 3 evidence images.");
      }

      const btn = document.getElementById('confirmReturnBtn');
      btn.disabled = true;
      btn.innerText = 'Submitting...';

      const formData = new FormData();
      formData.append('orderId', targetReturnId);
      formData.append('reason', reason);
      formData.append('returnedProducts', JSON.stringify(returnedProducts));
      
      for (let i = 0; i < files.length; i++) {
        formData.append('evidenceImages', files[i]);
      }

      try {
        const res = await fetch('/user/orders/return', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();

        if (data.success) {
          window.location.reload();
        } else {
          alert(data.message || 'Failed to submit return request.');
          btn.disabled = false;
          btn.innerText = 'Submit Request';
        }
      } catch (err) {
        console.error(err);
        alert('An error occurred. Please try again.');
        btn.disabled = false;
        btn.innerText = 'Submit Request';
      }
    });
  }
  let reviewProductId = null;
  let reviewOrderId = null;

  function openAddReviewModal(productId, orderId) {
    reviewProductId = productId;
    reviewOrderId = orderId;
    document.getElementById('reviewRatingInput').value = '';
    document.getElementById('reviewTextInput').value = '';
    document.getElementById('addReviewModalOverlay').style.display = 'flex';
  }

  function closeAddReviewModal() {
    reviewProductId = null;
    reviewOrderId = null;
    document.getElementById('addReviewModalOverlay').style.display = 'none';
  }

  const submitReviewBtn = document.getElementById('submitReviewBtn');
  if (submitReviewBtn) {
    submitReviewBtn.addEventListener('click', async () => {
      if (!reviewProductId || !reviewOrderId) return;

      const rating = document.getElementById('reviewRatingInput').value;
      const reviewText = document.getElementById('reviewTextInput').value.trim();

      if (!rating) return alert("Please select a rating.");
      if (reviewText.length < 5) return alert("Review must be at least 5 characters long.");

      submitReviewBtn.disabled = true;
      submitReviewBtn.innerText = 'Submitting...';

      try {
        const res = await fetch('/user/reviews/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productId: reviewProductId,
            orderId: reviewOrderId,
            rating,
            reviewText
          })
        });
        const data = await res.json();

        if (data.success) {
          alert("Review submitted successfully!");
          closeAddReviewModal();
          window.location.reload();
        } else {
          alert(data.message || 'Failed to submit review.');
          submitReviewBtn.disabled = false;
          submitReviewBtn.innerText = 'Submit Review';
        }
      } catch (err) {
        console.error(err);
        alert('An error occurred. Please try again.');
        submitReviewBtn.disabled = false;
        submitReviewBtn.innerText = 'Submit Review';
      }
    });
  }
</script>
