      </div>
    </div>
    <!-- Card 4 -->
    <div class="prod-card" data-id="fallback-4" data-variant-id="fallback-v4" data-avail="instock">
      <div class="prod-img-wrap">
        <span class="prod-badge badge-offer">5% OFF</span>
        <div class="card-wish" data-id="fallback-4" title="Add to Wishlist">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
        </div>
        <img src="https://images.unsplash.com/photo-1622434641406-a158123450f2?w=400&q=80" alt="Oceanic Deep" />
