<!-- GSAP LENIS INTERACTION SCRIPTS -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    'use strict';

    // 1. Lenis Smooth Scrolling Initializer
    let lenis;
    if (typeof Lenis !== 'undefined') {
      lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // smooth easeOutExpo
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1.0,
        infinite: false,
      });

      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // Bind GSAP ScrollTrigger to Lenis scroll
      if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
        lenis.on('scroll', ScrollTrigger.update);
      }
    }

    // 2. GSAP Scroll Trigger Animations
    if (typeof gsap !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);

      // Hero Fade & Slide In
      gsap.to('#heroContent', {
        opacity: 1,
        y: 0,
        duration: 1.4,
        ease: 'power4.out',
        delay: 0.2
      });

      gsap.to('#heroVisual', {
        opacity: 1,
        scale: 1,
        rotation: 0,
        duration: 1.6,
        ease: 'power4.out',
        delay: 0.3
      });

      // Categories Stagger In
      gsap.to('.coll-card', {
        scrollTrigger: {
          trigger: '#collections',
          start: 'top 80%',
        },
        opacity: 1,
        y: 0,
        duration: 1.0,
        stagger: 0.15,
        ease: 'power3.out'
      });

      // Featured Grid Reveal
      gsap.to('#featTitle', {
        scrollTrigger: {
          trigger: '#shop',
          start: 'top 85%',
        },
        opacity: 1,
        y: 0,
        duration: 1.0,
        ease: 'power3.out'
      });

      gsap.to('.products-grid-home', {
        scrollTrigger: {
          trigger: '.products-grid-home',
          start: 'top 85%',
        },
        opacity: 1,
        y: 0,
        duration: 1.2,
        ease: 'power3.out'
      });

      // Brand Story Split Words Animation
      const storyText = document.getElementById('storyText');
      if (storyText) {
        const text = storyText.textContent.trim();
        const words = text.split(/\s+/);
        storyText.innerHTML = words.map(word => {
          let cleanWord = word.replace(/[",.]/g, '');
          if (cleanWord.toLowerCase() === 'tymora' || cleanWord.toLowerCase() === 'precision' || cleanWord.toLowerCase() === 'luxury') {
            return `<span class="gold">${word}</span>`;
          }
          return `<span>${word}</span>`;
        }).join(' ');

        gsap.to('#storyText span', {
          scrollTrigger: {
            trigger: '#brandStory',
            start: 'top 75%',
            end: 'bottom 50%',
            scrub: true,
          },
          opacity: 1,
          color: '#ffffff',
          filter: 'blur(0px)',
          stagger: 0.05,
        });

        gsap.to('#storySignature', {
          scrollTrigger: {
            trigger: '#brandStory',
            start: 'top 55%',
          },
          opacity: 1,
          y: 0,
          duration: 1.0,
          ease: 'power3.out'
        });
      }

      // Split Showcase Parallax Fade
      document.querySelectorAll('.showcase-panel').forEach(panel => {
        const bg = panel.querySelector('.panel-bg');
        const content = panel.querySelector('.panel-content');

        gsap.to(bg, {
          scrollTrigger: {
            trigger: panel,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true
          },
          yPercent: 12,
          ease: 'none'
        });

        gsap.to(content, {
          scrollTrigger: {
            trigger: panel,
            start: 'top 75%',
          },
          opacity: 1,
          y: 0,
          duration: 1.2,
          ease: 'power3.out'
        });
      });
    }

    // 3. Apple-Style Mouse Interactive Parallax for Hero Watch Showcase
    const heroVisual = document.getElementById('heroVisual');
    const heroWatch = document.getElementById('heroWatch');
    if (heroVisual && heroWatch) {
      heroVisual.addEventListener('mousemove', (e) => {
        const rect = heroVisual.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;

        // Calculate rotation and offset
        const rotateX = (-y / rect.height) * 25; // max 25deg rotation
        const rotateY = (x / rect.width) * 25;
        const transX = (x / rect.width) * 20;   // max 20px translation
        const transY = (y / rect.height) * 20;

        gsap.to(heroWatch, {
          rotationX: rotateX,
          rotationY: rotateY,
          x: transX,
          y: transY,
          duration: 0.5,
          ease: 'power2.out'
        });
      });

      heroVisual.addEventListener('mouseleave', () => {
        gsap.to(heroWatch, {
          rotationX: 0,
          rotationY: 0,
          x: 0,
          y: 0,
          duration: 0.8,
          ease: 'power3.out'
        });
      });
    }

    // 4. COUNTDOWN TIMER
    let totalSeconds = 12 * 3600 + 48 * 60 + 14;
    function updateTimer() {
      if (totalSeconds <= 0) return;
      totalSeconds--;
      const h = Math.floor(totalSeconds / 3600);
      const m = Math.floor((totalSeconds % 3600) / 60);
      const s = totalSeconds % 60;

      const th = document.getElementById('th');
      const tm = document.getElementById('tm');
      const ts = document.getElementById('ts');

      if (th) th.textContent = String(h).padStart(2, '0');
      if (tm) tm.textContent = String(m).padStart(2, '0');
      if (ts) ts.textContent = String(s).padStart(2, '0');
    }
    setInterval(updateTimer, 1000);

    // 5. COPY COUPON CODES
    const copyBtn = document.getElementById('copyBtn');
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        navigator.clipboard.writeText('TYMORA10').then(() => {
          copyBtn.textContent = 'Copied!';
          copyBtn.style.background = '#c9a84c';
          copyBtn.style.color = '#000';
          setTimeout(() => {
            copyBtn.textContent = 'Copy Code';
            copyBtn.style.background = '';
            copyBtn.style.color = '';
          }, 2000);
        });
      });
    }
  });
</script>