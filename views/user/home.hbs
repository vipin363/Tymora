<link href="/userHome.css" rel="stylesheet">

<!-- DYNAMIC BACKDROP LIGHTS -->
<div class="luxury-spotlight"></div>
<div class="luxury-spotlight-blue"></div>

<!-- HERO SECTION -->
<section class="hero" id="home">
  <div class="hero-overlay-dark"></div>
  <div class="hero-container">

    <!-- LEFT PANEL: ELEVATED TYPOGRAPHY -->
    <div class="hero-content" id="heroContent">
      <div class="hero-eyebrow">HOROLOGY OF DISTINCTION</div>
      <h1 class="hero-title">
        TIME BEYOND
        <span>MEASURE</span>
      </h1>
      <p class="hero-sub">
        Curating the world's most exceptional mechanical masterworks. Uncompromising craftsmanship, refined for the
        modern connoisseur.
      </p>
      <div class="hero-btns">
        <button class="btn-primary" onclick="window.location.href='/user/shop'">
          <span>Explore Shop</span>
        </button>
        <button class="btn-outline" onclick="document.getElementById('deals').scrollIntoView({behavior: 'smooth'})">
          View Offers
        </button>
      </div>
    </div>

    <!-- RIGHT PANEL: DYNAMIC WATCH SHOWCASE -->
    <div class="hero-visual" id="heroVisual">
      <div class="visual-glow"></div>
      <div class="visual-rings"></div>
      <img class="visual-watch-img" id="heroWatch" src="/image/tymora_hero_watch.png"
        alt="Tymora Tourbillon Skeleton Watch">
    </div>

  </div>

  <!-- SCROLL DOWN INDICATOR -->
  <div class="scroll-indicator" onclick="document.getElementById('brandStrip').scrollIntoView({behavior: 'smooth'})">
    <span class="scroll-text">Scroll to Discover</span>
    <div class="scroll-mouse">
      <div class="scroll-wheel"></div>
    </div>
  </div>
</section>

<!-- BRAND MARQUEE STRIP -->
<div class="brand-strip" id="brandStrip">
  <div class="brand-track">
    <span class="brand-name">ROLEX</span>
    <div class="brand-divider"></div>
    <span class="brand-name">PATEK PHILIPPE</span>
    <div class="brand-divider"></div>
    <span class="brand-name">AUDEMARS PIGUET</span>
    <div class="brand-divider"></div>
    <span class="brand-name">TAG HEUER</span>
    <div class="brand-divider"></div>
    <span class="brand-name">OMEGA</span>
    <div class="brand-divider"></div>
    <span class="brand-name">VACHERON CONSTANTIN</span>
    <div class="brand-divider"></div>
    <span class="brand-name">BREGUET</span>
    <div class="brand-divider"></div>

    <!-- Duplicate for seamless scroll loop -->
    <span class="brand-name">ROLEX</span>
    <div class="brand-divider"></div>
    <span class="brand-name">PATEK PHILIPPE</span>
    <div class="brand-divider"></div>
    <span class="brand-name">AUDEMARS PIGUET</span>
    <div class="brand-divider"></div>
    <span class="brand-name">TAG HEUER</span>
    <div class="brand-divider"></div>
    <span class="brand-name">OMEGA</span>
    <div class="brand-divider"></div>
    <span class="brand-name">VACHERON CONSTANTIN</span>
    <div class="brand-divider"></div>
    <span class="brand-name">BREGUET</span>
    <div class="brand-divider"></div>
  </div>
</div>

<!-- COLLECTIONS SECTION -->
<section class="collections-section" id="collections">
  <div class="section-label">CURATED COLLECTIONS</div>
  <div class="collections-grid">
    {{#if categories.length}}
    {{#each categories}}
    <div class="coll-card" onclick="window.location.href='/user/shop?cat={{this.name}}'">
      {{#if this.image}}
      <img src="{{this.image}}" alt="{{this.name}}" loading="lazy" />
      {{else}}
      <img src="/image/WhatsApp Image 2026-05-11 at 10.56.46 AM.jpeg" alt="{{this.name}}" loading="lazy" />
      {{/if}}
      <div class="coll-overlay">
        <div class="coll-title">{{this.name}}</div>
        <div class="coll-explore">
          Explore Collection
          <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </div>
      </div>
    </div>
    {{/each}}
    {{else}}
    <p
      style="color:var(--text-muted); font-size:0.8rem; letter-spacing:0.15em; padding:40px 0; grid-column: 1 / -1; text-align: center;">
      No collections available yet.
    </p>
    {{/if}}
  </div>
</section>

<!-- FEATURED PRODUCTS SECTION -->
<section class="featured-section" id="shop">
  <div class="feat-header">
    <p>MASTERWORKS OF PRECISION</p>
    <h2 id="featTitle">Featured Timepieces</h2>
  </div>

  <div id="productsGrid" class="products-grid-home">
    {{#if products.length}}
    {{#each products}}
    <div class="prod-card" data-id="{{this.id}}" data-variant-id="{{this.variantId}}" data-avail="{{this.avail}}">
      <div class="prod-img-wrap">
        {{#if this.badgeLabel}}
        <span class="prod-badge badge-{{this.badge}}">{{this.badgeLabel}}</span>
        {{else if this.badge}}
        <span class="prod-badge badge-{{this.badge}}">{{this.badge}}</span>
        {{/if}}

        <div class="card-wish {{#if this.wished}}wished{{/if}}" data-id="{{this.id}}"
          title="{{#if this.wished}}Remove from Wishlist{{else}}Add to Wishlist{{/if}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
        </div>

        <img src="{{this.img}}" alt="{{this.name}}" loading="lazy" style="cursor:pointer"
          onclick="window.location.href='/user/product/{{this.id}}'">
        <div class="prod-img-overlay"></div>

        {{#ifEquals this.avail 'outofstock'}}
        <button class="quick-add disabled" disabled title="Out of Stock">Out of Stock</button>
        {{else}}
        {{#if this.inCart}}
        <button class="quick-add" style="background:transparent;color:var(--gold);border:1px solid var(--gold);"
          data-id="{{this.id}}" data-variant-id="{{this.variantId}}" data-in-cart="true">View in Cart</button>
        {{else}}
        <button class="quick-add" data-id="{{this.id}}" data-variant-id="{{this.variantId}}" data-in-cart="">+ Add to
          Bag</button>
        {{/if}}
        {{/ifEquals}}
      </div>

      <div class="prod-info">
        <div class="prod-atelier">{{this.brand}}</div>
        <div class="prod-rating">★ {{this.rating}} <span class="rating-count">({{this.reviews}})</span></div>
        <div class="prod-name">{{this.name}}</div>
        <div class="prod-price-wrap">
          <span class="prod-price">₹{{this.price}}</span>
          {{#if this.oldPrice}}
          <span class="prod-price-old">₹{{this.oldPrice}}</span>
          {{#if this.discountPct}}
          <span class="prod-discount-pill">{{this.discountPct}}% OFF</span>
          {{/if}}
          {{/if}}
        </div>
        <button class="prod-btn" onclick="window.location.href='/user/product/{{this.id}}'">View Details</button>
      </div>
    </div>
    {{/each}}
    {{else}}
    <!-- EXTREMELY PREMIUM RESILIENT FALLBACK CARDS -->
    <!-- Card 1 -->
    <div class="prod-card" data-id="fallback-1" data-variant-id="fallback-v1" data-avail="instock">
      <div class="prod-img-wrap">
        <span class="prod-badge badge-deal">SIGNATURE</span>
        <div class="card-wish" data-id="fallback-1" title="Add to Wishlist">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
        </div>
        <img src="https://images.unsplash.com/photo-1582552938357-32b906df40cb?w=400&q=80" alt="Elysian Gold" />
        <div class="prod-img-overlay"></div>
        <button class="quick-add" data-id="fallback-1" data-variant-id="fallback-v1">+ Add to Bag</button>
      </div>
      <div class="prod-info">
        <div class="prod-atelier">18K Rose Gold</div>
        <div class="prod-rating">★ 5.0 <span class="rating-count">(24)</span></div>
        <div class="prod-name">Elysian Gold</div>
        <div class="prod-price">₹8,12,000</div>
        <button class="prod-btn" onclick="window.location.href='/user/shop'">View Details</button>
      </div>
    </div>
    <!-- Card 2 -->
    <div class="prod-card" data-id="fallback-2" data-variant-id="fallback-v2" data-avail="instock">
      <div class="prod-img-wrap">
        <span class="prod-badge badge-new">NEW ARRIVAL</span>
        <div class="card-wish" data-id="fallback-2" title="Add to Wishlist">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
        </div>
        <img src="https://images.unsplash.com/photo-1523170335258-f5ed11844a49?w=400&q=80" alt="Horizon GMT" />
        <div class="prod-img-overlay"></div>
        <button class="quick-add" data-id="fallback-2" data-variant-id="fallback-v2">+ Add to Bag</button>
      </div>
      <div class="prod-info">
        <div class="prod-atelier">Tymora Atelier</div>
        <div class="prod-rating">★ 4.8 <span class="rating-count">(18)</span></div>
        <div class="prod-name">Horizon GMT</div>
        <div class="prod-price">₹3,85,000</div>
        <button class="prod-btn" onclick="window.location.href='/user/shop'">View Details</button>
      </div>
    </div>
    <!-- Card 3 -->
    <div class="prod-card" data-id="fallback-3" data-variant-id="fallback-v3" data-avail="instock">
      <div class="prod-img-wrap">
        <span class="prod-badge badge-limited">LIMITED</span>
        <div class="card-wish" data-id="fallback-3" title="Add to Wishlist">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
        </div>
        <img src="https://images.unsplash.com/photo-1585386959984-a4155224a1ad?w=400&q=80" alt="Vanguard Skeleton" />
        <div class="prod-img-overlay"></div>
        <button class="quick-add" data-id="fallback-3" data-variant-id="fallback-v3">+ Add to Bag</button>
