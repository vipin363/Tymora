        <button class="prod-btn" onclick="window.location.href='/user/shop'">View Details</button>
      </div>
    </div>
    {{/if}}
  </div>
</section>

<!-- BRAND STORY SECTION (CINEMATIC SCROLL REVEAL) -->
<section class="brand-story" id="brandStory">
  <div class="story-container">
    <div class="story-eyebrow">OUR HERITAGE</div>
    <p class="story-text" id="storyText">
      "For over a century, <span class="gold">Tymora</span> has engineered masterpieces of high horology. We believe a
      fine timepiece is not merely a tool of measurement, but a silent testament to character, an intricate dance of
      <span class="gold">mechanical precision</span> and eternal luxury."
    </p>
    <div class="story-signature" id="storySignature">
      Alistair Tymora
      <span>FOUNDER & MASTER WATCHMAKER</span>
    </div>
  </div>
</section>

<!-- SKELETON & WATERPROOF SHOWCASE -->
<section class="showcase-split">

  <!-- LEFT: WATERPROOF DURABILITY -->
  <div class="showcase-panel">
    <div class="panel-bg" style="background-image: url('/image/tymora_waterproof_watch.png');"></div>
    <div class="panel-overlay-grad"></div>
    <div class="panel-content">
      <span class="panel-tag">DURABILITY</span>
      <h3 class="panel-title">Engineering The Depths</h3>
      <p class="panel-desc">
        Crafted to withstand the harshest pressures. Our professional grade seals protect the delicate automatic
        movements up to 300 meters beneath the surface, fusing absolute structural integrity with timeless design.
      </p>
      <button class="btn-outline" onclick="window.location.href='/user/shop?avail=instock'">View Marine
        Chronographs</button>
    </div>
  </div>

  <div class="panel-divider"></div>

  <!-- RIGHT: MECHANICAL PRECISION -->
  <div class="showcase-panel">
    <div class="panel-bg" style="background-image: url('/image/tymora_mechanical_precision.png');"></div>
    <div class="panel-overlay-grad"></div>
    <div class="panel-content">
      <span class="panel-tag">HOROLOGY</span>
      <h3 class="panel-title">Sovereign Precision</h3>
      <p class="panel-desc">
        Behold the intricate symphony of synthetic rubies, balance wheels, and gears operating at 28,800 vibrations per
        hour. Exposed tourbillon details show the pure art form of mechanical movement.
      </p>
      <button class="btn-outline" onclick="window.location.href='/user/shop'">Discover Tourbillons</button>
    </div>
  </div>

</section>

<!-- PRIVÉ LOUNGE & DEALS SECTION -->
<section class="deals-section" id="deals">
  <div class="section-label">EXCLUSIVE OFFERS</div>
  <div class="deals-grid">

    <!-- Deal of Day -->
    <div class="deal-day">
      <div class="deal-day-label">Deal of the Day</div>
      <div class="deal-timer">
        <div class="timer-unit">
          <div class="timer-num" id="th">12</div>
          <div class="timer-lbl">HRS</div>
        </div>
        <div class="timer-sep">:</div>
        <div class="timer-unit">
          <div class="timer-num" id="tm">48</div>
          <div class="timer-lbl">MIN</div>
        </div>
        <div class="timer-sep">:</div>
        <div class="timer-unit">
          <div class="timer-num" id="ts">14</div>
          <div class="timer-lbl">SEC</div>
        </div>
      </div>
      <img class="deal-watch-img" src="https://images.unsplash.com/photo-1523170335258-f5ed11844a49?w=300&q=80"
        alt="Maestro GMT" />
      <div class="deal-watch-name">MAESTRO GMT CLASSIC</div>
      <div class="deal-watch-price">₹3,85,000</div>
      <button class="deal-shop-btn" onclick="window.location.href='/user/shop'">Shop Now</button>
    </div>

    <!-- Limited Time Offer -->
    <div class="deal-offer">
      <div class="deal-offer-tag">Limited Time Offer</div>
      <h3>Up to <span>40% OFF</span></h3>
      <p>on Selected Heritage & Sports Pieces</p>
      <button class="deal-offer-link" onclick="window.location.href='/user/shop'">Shop The Sale →</button>
    </div>

    <!-- Coupon -->
    <div class="deal-coupon">
      <span class="deal-coupon-tag">Today's Offer</span>
      <h3>Extra 10% Off</h3>
      <div class="coupon-box">
        <span class="coupon-code">TYMORA10</span>
      </div>
      <button class="coupon-copy" id="copyBtn">Copy Code</button>
      <button class="coupon-explore" onclick="window.location.href='/user/shop'">Explore Collections »</button>
    </div>

  </div>
</section>

