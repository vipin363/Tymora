<link href="/userAllProducts.css" rel="stylesheet">
<!-- HERO -->
<div class="shop-hero">
  <div>
    <h1 class="shop-title">Discover <em>Fine </em><br>Timepieces</h1>
    <p class="shop-subtitle">Curated collection — beauty in every shadow</p>
  </div>
  <div class="results-count">
    Showing <span id="countDisplay">{{totalProducts}}</span> of <span id="totalDisplay">{{totalProducts}}</span> products
  </div>
</div>

<div class="divider"></div>

<!-- CONTROLS BAR -->
<div class="controls-bar">
  <div class="search-wrap">
    <div class="search-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    </div>
    <input type="text" id="searchInput" placeholder="{{searchPlaceholder}}">
    <button class="clear-btn" id="clearBtn" title="Clear">✕</button>
    <button class="search-btn" id="searchBtn">Search</button>
  </div>

  <select class="sort-select" id="sortSelect">
    <option value="">Sort by</option>
    {{#each sortOptions}}
      <option value="{{this.value}}">{{this.label}}</option>
    {{/each}}
  </select>

  <button class="filter-toggle" id="filterToggle">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
    Filters
  </button>
</div>

<!-- FILTER PANEL -->
<div class="filter-panel" id="filterPanel">
  <div class="filter-grid">

    <div class="filter-group">
      <label>Category</label>
      <select id="catFilter">
        <option value="">All Categories</option>
        {{#each filterOptions.categories}}
          <option value="{{this.value}}">{{this.label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="filter-group">
      <label>Brand</label>
      <select id="brandFilter">
        <option value="">All Brands</option>
        {{#each filterOptions.brands}}
          <option value="{{this.value}}">{{this.label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="filter-group">
      <label>Price Range (₹)</label>
      <div class="price-range-wrap">
        <input type="number" id="priceMin" placeholder="Min">
        <span>–</span>
        <input type="number" id="priceMax" placeholder="Max">
      </div>
    </div>

    <div class="filter-group">
      <label>Style</label>
      <select id="styleFilter">
        <option value="">All Styles</option>
        {{#each filterOptions.styles}}
          <option value="{{this.value}}">{{this.label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="filter-group">
      <label>Availability</label>
      <select id="availFilter">
        <option value="">All</option>
        {{#each filterOptions.availability}}
          <option value="{{this.value}}">{{this.label}}</option>
        {{/each}}
      </select>
    </div>

  </div>
  <div class="filter-actions">
    <button class="btn-apply" id="btnApply">Apply Filters</button>
    <button class="btn-reset" id="btnReset">Reset All</button>
  </div>
</div>

<!-- ACTIVE FILTER TAGS -->
<div class="active-filters" id="activeTags"></div>

<!-- PRODUCTS SECTION -->
<div class="products-section">
  <div class="products-grid" id="productsGrid"></div>
  <div class="no-results" id="noResults">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    <p>No timepieces found</p>
    <small>Try adjusting your search or filters</small>
  </div>
</div>

<!-- PAGINATION -->
<div class="pagination-wrap" id="paginationWrap"></div>

<!-- FEATURED SECTION -->
<div class="featured-section">
  <div class="section-header">
    <h2 class="section-title">Featured<em>Picks</em></h2>
    <div class="section-line"></div>
  </div>
  <div class="featured-track-outer">
    <button class="carousel-arrow left" id="carouselPrev">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <div class="featured-track-wrap">
      <div class="featured-track" id="featuredTrack"></div>
    </div>
    <button class="carousel-arrow right" id="carouselNext">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>
  <div class="carousel-dots" id="carouselDots"></div>
</div>
<!-- SEED DATA injected for shop.js -->
<script>
  window.SHOP_DATA = {{{json shopData}}};
</script>
<script src="/js/shop.js"></script>