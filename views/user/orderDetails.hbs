<link href="/myOrders.css" rel="stylesheet">
<style>
.od-wrapper {
  max-width: 900px;
  margin: 40px auto;
  padding: 0 20px;
  color: var(--text-light);
}
.od-header {
  margin-bottom: 30px;
}
.od-title {
  font-size: 2rem;
  margin-bottom: 5px;
}
.od-title em {
  font-style: italic;
  color: var(--gold);
}
.od-summary-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
  margin-bottom: 30px;
}
.od-card {
  background: var(--bg-dark);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 20px;
}
.od-card h3 {
  color: var(--gold);
  margin-bottom: 15px;
  font-size: 1.1rem;
}
.od-info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
  font-size: 0.95rem;
}
.od-info-label {
  color: var(--text-muted);
}

</style>

<div class="od-wrapper">
  <div class="od-header">
    <h1 class="od-title">Order <em>Details</em></h1>
    <p style="color:var(--text-muted);">Order ID: #{{order.orderId}} &nbsp;|&nbsp; Placed on {{order.orderDateFormatted}}</p>
    <div class="heading-underline" style="margin-top:10px;"></div>
  </div>

  <div class="od-summary-cards">
    <div class="od-card">
      <h3>Shipping Address</h3>
      <div style="font-size:0.95rem; line-height:1.6;">
        <strong>{{order.shippingAddress.fullName}}</strong><br>
        {{order.shippingAddress.addressLine}}<br>
        {{order.shippingAddress.city}}, {{order.shippingAddress.state}} - {{order.shippingAddress.pincode}}<br>
        Phone: {{order.shippingAddress.phone}}
      </div>
    </div>
    
    <div class="od-card">
      <h3>Payment & Delivery</h3>
      <div class="od-info-row">
        <span class="od-info-label">Payment Method:</span>
        <span>{{order.paymentMethod}}</span>
      </div>
      <div class="od-info-row">
        <span class="od-info-label">Payment Status:</span>
        <span style="color:var(--gold);">{{order.paymentStatus}}</span>
      </div>
      <div class="od-info-row">
        <span class="od-info-label">Shipping Method:</span>
        <span>{{order.deliveryType}} Delivery</span>
      </div>
      <div class="od-info-row">
        <span class="od-info-label">Est. Delivery:</span>
        <span>{{order.estimatedDeliveryFormatted}}</span>
      </div>
    </div>
    
    <div class="od-card">
      <h3>Order Summary</h3>
      <div class="od-info-row">
        <span class="od-info-label">Selling Price:</span>
        <span>₹{{formatCurrency order.subtotalSalePrice}}</span>
      </div>
      {{#if order.offerDiscount}}
      <div class="od-info-row">
        <span class="od-info-label">
          Offer Applied{{#if order.offerName}} <span style="font-size:0.78rem; background:rgba(168,85,247,0.15); color:#a855f7; border:1px solid rgba(168,85,247,0.3); border-radius:4px; padding:1px 5px;">{{order.offerName}}</span>{{/if}}:
        </span>
        <span style="color:#10b981;">-₹{{formatCurrency order.offerDiscount}}</span>
      </div>
      {{/if}}
      {{#if order.couponDiscount}}
      <div class="od-info-row">
        <span class="od-info-label">
          Coupon Applied{{#if order.couponCode}} <span style="font-size:0.78rem; background:rgba(201,168,76,0.12); color:#c9a84c; border:1px solid rgba(201,168,76,0.3); border-radius:4px; padding:1px 5px;">{{order.couponCode}}</span>{{/if}}:
        </span>
        <span style="color:#10b981;">-₹{{formatCurrency order.couponDiscount}}</span>
      </div>
      {{/if}}
      <div class="od-info-row">
        <span class="od-info-label">Delivery Charge:</span>
        <span>₹{{formatCurrency order.deliveryCharge}}</span>
      </div>
      {{#if order.codCharge}}
      <div class="od-info-row">
        <span class="od-info-label">COD Charge:</span>
        <span>₹{{formatCurrency order.codCharge}}</span>
      </div>
      {{/if}}
      <div class="od-info-row">
        <span class="od-info-label">CGST (9%):</span>
        <span>₹{{formatCurrency order.cgst}}</span>
      </div>
      <div class="od-info-row">
        <span class="od-info-label">SGST (9%):</span>
        <span>₹{{formatCurrency order.sgst}}</span>
      </div>
      <div class="od-info-row" style="margin-top:10px; padding-top:10px; border-top:1px solid #333; font-weight:bold;">
        <span>Original Total:</span>
        <span style="color:var(--gold); font-size:1.1rem;">₹{{formatCurrency order.totalAmount}}</span>
      </div>
      {{#if (gt order.totalCancelledRefunds 0)}}
      <div class="od-info-row" style="color: #ef4444; margin-top:8px;">
        <span>{{#if order.isCOD}}Cancelled Product:{{else}}Cancelled Product Refund:{{/if}}</span>
        <span>-₹{{formatCurrency order.totalCancelledRefunds}}</span>
      </div>
      {{/if}}
      {{#if (gt order.totalReturnedRefunds 0)}}
      <div class="od-info-row" style="color: #ef4444; margin-top:8px;">
        <span>Returned Product Refund:</span>
        <span>-₹{{formatCurrency order.totalReturnedRefunds}}</span>
      </div>
      {{/if}}
      {{#if (lt order.finalAmountPaid order.totalAmount)}}
      <div class="od-info-row" style="margin-top:10px; padding-top:10px; border-top:1px dashed #444; font-weight:bold;">
        <span>{{#if order.isCOD}}Amount To Pay:{{else}}Final Amount Paid:{{/if}}</span>
        <span style="color:var(--gold); font-size:1.15rem;">₹{{formatCurrency order.finalAmountPaid}}</span>
      </div>
      {{/if}}
    </div>
  </div>


  <h2 style="font-size:1.5rem; margin-bottom:15px; color:var(--white);">Ordered Products</h2>
  
  <div class="mo-list">
    <div class="mo-card" style="padding:0;">
      <div class="mo-products">
        {{#each order.products}}
        <div class="mo-prod-row" style="flex-direction: column; align-items: stretch; gap: 10px; border-bottom: 1px solid #222; padding: 20px;">
          <div style="display: flex; gap: 15px; align-items: center;">
            {{#if this.productImage}}
            <img class="mo-prod-img" src="{{this.productImage}}" alt="{{this.productName}}">
            {{/if}}
            <div class="mo-prod-info" style="flex: 1;">
              <div class="mo-prod-name" style="font-size:1.1rem;">{{this.productName}}</div>
              <div class="mo-prod-meta">{{this.variantSpecs}} · Qty: {{this.quantity}}</div>
              <div class="mo-prod-meta" style="margin-top: 6px;">
                Status: <strong style="color:var(--gold); font-size:0.95rem;">{{this.orderStatus}}</strong>
              </div>

            </div>
            <div class="mo-prod-price-wrap" style="text-align:right;">
              <div class="mo-prod-price" style="font-size:1.2rem;">₹{{formatCurrency this.salePrice}}</div>
            </div>
          </div>



          <div class="mo-prod-actions" style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;">
            {{#if this.canTrack}}
            <a href="/user/track-order/{{../order.orderId}}/{{this._id}}" class="mo-btn" style="background:transparent; border:1px solid var(--gold); color:var(--gold); padding: 6px 20px; font-size: 0.9rem; text-decoration:none;">Track Order</a>
            {{/if}}
            {{#if this.isReturned}}
            <a href="/user/track-order/{{../order.orderId}}/{{this._id}}" class="mo-btn" style="background:transparent; border:1px solid var(--gold); color:var(--gold); padding: 6px 20px; font-size: 0.9rem; text-decoration:none;">View Tracking</a>
            {{/if}}
            {{#if this.canCancel}}
            <button class="mo-btn mo-btn-danger" style="padding: 6px 20px; font-size: 0.9rem;" onclick="openCancelModal('{{../order.orderId}}', '{{this._id}}')">Cancel Product</button>
            {{/if}}
            {{#if this.canReturn}}
            <button class="mo-btn" style="background:transparent; border:1px solid #fff; color:#fff; padding: 6px 20px; font-size: 0.9rem;" onclick="openReturnModal('{{../order.orderId}}', '{{this._id}}')">Return Product</button>
            {{/if}}
            {{#if this.showReview}}
            <button class="mo-btn" style="background:transparent; border:1px solid #3b82f6; color:#3b82f6; padding: 6px 20px; font-size: 0.9rem;" onclick="openReviewModal('{{../order.orderId}}', '{{this.productId}}')">Add Review</button>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>

  {{#if order.canDownloadInvoice}}
  <div style="margin-top: 30px; margin-bottom: 20px; text-align: center;">
    <a href="/user/orders/invoice/{{order.orderId}}" class="mo-btn" style="display:inline-block; padding: 12px 30px; font-size: 1.1rem; border:1px solid var(--gold); color:var(--gold); text-decoration:none;">Download Invoice</a>
  </div>
  {{/if}}
</div>

<!-- Cancel Product Modal -->
<div class="mo-modal-overlay" id="cancelModalOverlay">
  <div class="mo-modal">
    <h3>Cancel Product</h3>
    <p>Are you sure you want to cancel this product? This action cannot be undone.</p>
    <textarea id="cancelReasonInput" placeholder="Required: Please tell us why you are cancelling this product..."></textarea>
    <p id="cancelReasonError" style="color:#f87171; font-size:0.82rem; margin:4px 0 8px; display:none;"></p>
    <div class="mo-modal-actions">
      <button class="mo-btn" style="background:transparent; color:#fff; border:1px solid #fff;" onclick="closeCancelModal()">Keep Product</button>
      <button class="mo-btn mo-btn-danger" id="confirmCancelBtn">Confirm Cancel</button>
    </div>
  </div>
</div>

<!-- Return Product Modal -->
<div class="mo-modal-overlay" id="returnModalOverlay">
  <div class="mo-modal">
    <h3>Return Product</h3>
    <p>Please provide a reason for returning this product.</p>
    <textarea id="returnReasonInput" placeholder="Reason for return (e.g. Damaged item, Wrong size)..."></textarea>
    <p id="returnReasonError" style="color:#f87171; font-size:0.82rem; margin:4px 0 8px; display:none;"></p>
    <div class="mo-modal-actions">
      <button class="mo-btn" style="background:transparent; color:#fff; border:1px solid #fff;" onclick="closeReturnModal()">Cancel</button>
      <button class="mo-btn mo-btn-primary" id="confirmReturnBtn">Submit Return Request</button>
    </div>
  </div>
</div>

<!-- Review Product Modal -->
<div class="mo-modal-overlay" id="reviewModalOverlay">
  <div class="mo-modal">
    <h3>Add Review</h3>
    <p>Please rate and review this product.</p>
    
    <div style="margin: 15px 0; text-align: left;">
      <label style="display: block; margin-bottom: 5px;">Rating (1-5):</label>
      <select id="reviewRatingInput" style="width:100%; padding:8px; border-radius:4px; border:1px solid #333; background:#0f0f1e; color:#fff;">
        <option value="5">5 ★★★★★</option>
        <option value="4">4 ★★★★☆</option>
        <option value="3">3 ★★★☆☆</option>
        <option value="2">2 ★★☆☆☆</option>
        <option value="1">1 ★☆☆☆☆</option>
      </select>
    </div>
    
    <textarea id="reviewTextInput" placeholder="Write your honest review (e.g. Good watch, Bad quality)..."></textarea>
    <p id="reviewTextError" style="color:#f87171; font-size:0.82rem; margin:4px 0 8px; display:none;"></p>
    <div class="mo-modal-actions">
      <button class="mo-btn" style="background:transparent; color:#fff; border:1px solid #fff;" onclick="closeReviewModal()">Cancel</button>
      <button class="mo-btn mo-btn-primary" style="background:#3b82f6; color:#fff;" id="confirmReviewBtn">Submit Review</button>
    </div>
  </div>
</div>

<script>
  // ── Shared validation helpers ──────────────────────────────────
  function showToast(msg, type) {
    const wrap = document.createElement('div');
    const bg = type === 'success' ? '#16a34a' : type === 'info' ? '#2563eb' : '#dc2626';
    wrap.style.cssText = `position:fixed;top:20px;right:20px;z-index:99999;background:${bg};color:#fff;padding:12px 18px;border-radius:8px;font-size:13px;font-weight:600;box-shadow:0 4px 16px rgba(0,0,0,0.25);max-width:320px;word-break:break-word;opacity:0;transition:opacity .25s;`;
    wrap.textContent = msg;
    document.body.appendChild(wrap);
    requestAnimationFrame(() => { wrap.style.opacity = '1'; });
    setTimeout(() => { wrap.style.opacity = '0'; setTimeout(() => wrap.remove(), 300); }, 3500);
  }

  function validateReason(value, fieldLabel) {
    const v = (value || '').trim();
    if (!v) return `Please enter a ${fieldLabel}.`;
    if (v.length < 3) return `${fieldLabel.charAt(0).toUpperCase() + fieldLabel.slice(1)} must contain at least 3 characters.`;
    if (!/[A-Za-z]/.test(v)) return `${fieldLabel.charAt(0).toUpperCase() + fieldLabel.slice(1)} cannot contain only numbers or special characters.`;
    return null;
  }

  function showModalError(elId, msg) {
    const el = document.getElementById(elId);
    if (!el) return;
    el.textContent = msg || '';
    el.style.display = msg ? 'block' : 'none';
  }

  // ── State ─────────────────────────────────────────────────────
  let targetCancelOrderId = null;
  let targetCancelItemId = null;
  let targetReturnOrderId = null;
  let targetReturnItemId = null;
  let targetReviewOrderId = null;
  let targetReviewProductId = null;

  // ── Cancel Modal ──────────────────────────────────────────────
  function openCancelModal(orderId, itemId) {
    targetCancelOrderId = orderId;
    targetCancelItemId = itemId;
    document.getElementById('cancelReasonInput').value = '';
    showModalError('cancelReasonError', null);
    document.getElementById('cancelModalOverlay').classList.add('active');
  }

  function closeCancelModal() {
    targetCancelOrderId = null;
    targetCancelItemId = null;
    document.getElementById('cancelModalOverlay').classList.remove('active');
  }

  document.getElementById('confirmCancelBtn').addEventListener('click', async () => {
    if (!targetCancelOrderId || !targetCancelItemId) return;
    const reason = document.getElementById('cancelReasonInput').value;
    const err = validateReason(reason, 'cancellation reason');
    if (err) { showModalError('cancelReasonError', err); return; }
    showModalError('cancelReasonError', null);

    const btn = document.getElementById('confirmCancelBtn');
    btn.disabled = true; btn.innerText = 'Cancelling...';
    try {
      const res = await fetch('/user/orders/cancel', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderId: targetCancelOrderId, itemId: targetCancelItemId, reason: reason.trim() })
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        showToast(data.message || 'Failed to cancel product.', 'error');
        btn.disabled = false; btn.innerText = 'Confirm Cancel';
      }
    } catch (err) {
      console.error(err);
      showToast('An error occurred. Please try again.', 'error');
      btn.disabled = false; btn.innerText = 'Confirm Cancel';
    }
  });

  // ── Return Modal ──────────────────────────────────────────────
  function openReturnModal(orderId, itemId) {
    targetReturnOrderId = orderId;
    targetReturnItemId = itemId;
    document.getElementById('returnReasonInput').value = '';
    showModalError('returnReasonError', null);
    document.getElementById('returnModalOverlay').classList.add('active');
  }

  function closeReturnModal() {
    targetReturnOrderId = null;
    targetReturnItemId = null;
    document.getElementById('returnModalOverlay').classList.remove('active');
  }

  document.getElementById('confirmReturnBtn').addEventListener('click', async () => {
    if (!targetReturnOrderId || !targetReturnItemId) return;
    const reason = document.getElementById('returnReasonInput').value;
    const err = validateReason(reason, 'return reason');
    if (err) { showModalError('returnReasonError', err); return; }
    showModalError('returnReasonError', null);

    const btn = document.getElementById('confirmReturnBtn');
    btn.disabled = true; btn.innerText = 'Submitting...';
    try {
      const res = await fetch('/user/orders/return', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderId: targetReturnOrderId, itemId: targetReturnItemId, reason: reason.trim() })
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        showToast(data.message || 'Failed to submit return request.', 'error');
        btn.disabled = false; btn.innerText = 'Submit Return Request';
      }
    } catch (err) {
      console.error(err);
      showToast('An error occurred. Please try again.', 'error');
      btn.disabled = false; btn.innerText = 'Submit Return Request';
    }
  });

  // ── Review Modal ──────────────────────────────────────────────
  function openReviewModal(orderId, productId) {
    targetReviewOrderId = orderId;
    targetReviewProductId = productId;
    document.getElementById('reviewRatingInput').value = 5;
    document.getElementById('reviewTextInput').value = '';
    showModalError('reviewTextError', null);
    document.getElementById('reviewModalOverlay').classList.add('active');
  }

  function closeReviewModal() {
    targetReviewOrderId = null;
    targetReviewProductId = null;
    document.getElementById('reviewModalOverlay').classList.remove('active');
  }

  document.getElementById('confirmReviewBtn').addEventListener('click', async () => {
    if (!targetReviewOrderId || !targetReviewProductId) return;
    const rating = document.getElementById('reviewRatingInput').value;
    const reviewText = document.getElementById('reviewTextInput').value;
    const err = validateReason(reviewText, 'review');
    if (err) { showModalError('reviewTextError', err); return; }
    showModalError('reviewTextError', null);

    const btn = document.getElementById('confirmReviewBtn');
    btn.disabled = true; btn.innerText = 'Submitting...';
    try {
      const res = await fetch('/user/reviews/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderId: targetReviewOrderId, productId: targetReviewProductId, rating, reviewText: reviewText.trim() })
      });
      const data = await res.json();
      if (data.success) {
        showToast(data.message || 'Review submitted!', 'success');
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showToast(data.message || 'Failed to submit review.', 'error');
        btn.disabled = false; btn.innerText = 'Submit Review';
      }
    } catch (err) {
      showToast('Error submitting review.', 'error');
      btn.disabled = false; btn.innerText = 'Submit Review';
    }
  });
</script>
