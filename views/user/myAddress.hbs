<link rel="stylesheet" href="/myAddress.css">
<link href="/navBar.css" rel="stylesheet">
<link href="/footer.css" rel="stylesheet">
<link href="/userHome.css" rel="stylesheet">




<!-- BREADCRUMB -->
<div class="breadcrumb">
  <a href="/user/home">Home</a>
  &nbsp;›&nbsp;
  <a href="/user/profile">My Account</a>
  &nbsp;›&nbsp;
  <span class="current">My Addresses</span>
</div>

<!-- PAGE HEADER -->
<div class="page-header">
  <h1 class="page-title">My Addresses</h1>
  <p class="page-sub">
    Manage your delivery locations for secure shipping and seamless checkout.
  </p>
</div>

<!-- ADDRESS GRID -->
<div class="address-wrap">

  {{#each addresses}}
  <div class="address-card {{#if this.isDefault}}active{{/if}}">

    <div class="address-top">
      <div class="address-title">{{this.type}}</div>

      {{#if this.isDefault}}
      <span class="default-badge">DEFAULT</span>
      {{/if}}
    </div>

    <div class="address-body">
      <p>{{this.fullName}}</p>
      <p>{{this.street}}</p>
      <p>{{this.city}}, {{this.state}}</p>
      <p>{{this.pincode}}</p>
      <p>+91 {{this.phone}}</p>
    </div>

    <div class="address-actions">
      <a  onclick="openEditModal('{{this._id}}')">EDIT</a>
      {{#if this.isDefault}}
  <span class="default-btn">DEFAULT</span>
{{else}}
  <a href="/user/setDefault/{{this._id}}">SET DEFAULT</a>
{{/if}}
     <a href="#" onclick="openDeleteAddressModal('{{this._id}}')" class="danger">
  DELETE
</a>
    </div>

  </div>
  {{/each}}

  <!-- ADD NEW CARD -->
<div class="address-card add-new" onclick="showModal('add-address-modal')">    
    <div class="add-box">
      <span class="plus">+</span>
      <p>Add New Address</p>
    </div>
  </div>

</div>

{{!-- add address model --}}
<div class="modal-overlay" id="add-address-modal" style="display:none"
onclick="if(event.target===this)hideModal('add-address-modal')">

  <div class="modal-box">

    <h2 style="margin-bottom:15px;">Add New Address</h2>

    <div id="address-error" style="color:red;font-size:13px;margin-bottom:10px;"></div>

    <form id="addressForm">

      <input type="text" id="fullName" placeholder="Full Name">
      <input type="text" id="phone" placeholder="Phone Number">
      <input type="text" id="street" placeholder="Street Address">
      <input type="text" id="city" placeholder="City">
      <input type="text" id="state" placeholder="State">
      <input type="text" id="pincode" placeholder="pincode Code">

      <select id="type">
        <option value="Home">Home</option>
        <option value="Work">Work</option>
      </select>

      <div class="default-row">
  <input type="checkbox" id="isDefault">
  <label for="isDefault">Set as Default</label>
</div>

      <button type="submit" class="modal-btn-red">Save Address</button>

    </form>

    <button class="modal-btn-cancel" onclick="hideModal('add-address-modal')">
      Cancel
    </button>

  </div>
</div>
<div class="modal-overlay"
     id="delete-address-modal"
     style="display:none"
     onclick="if(event.target===this)hideModal('delete-address-modal')">

  <div class="modal-box">

    <div class="modal-icon-wrap red-bg">🗑</div>

    <div class="modal-title-text">
      Delete Address?
    </div>

    <p class="modal-desc-text">
      Are you sure you want to delete this address?
    </p>

    <button class="modal-btn-cancel"
      onclick="hideModal('delete-address-modal')">
      Cancel
    </button>

    <form id="deleteAddressForm" method="POST">
      <button type="submit" class="modal-btn-red">
        Delete
      </button>
    </form>

  </div>
</div>

<script>
let editAddressId = null;

 function openDeleteAddressModal(id){
  const form = document.getElementById("deleteAddressForm");

  form.action = `/user/deleteAddress/${id}`;

  showModal("delete-address-modal");
}

// ✅ SHOW MODAL
function showModal(id){
  const modal = document.getElementById(id);

  const form = modal.querySelector("form");
  if(form) form.reset();

  const errorBox = modal.querySelector("#address-error");
  if(errorBox) errorBox.innerText = "";

  editAddressId = null;
  document.querySelector(".modal-btn-red").innerText = "Save Address";

  modal.style.display = "flex";
}

// ✅ HIDE MODAL
function hideModal(id){
  const modal = document.getElementById(id);

  const form = modal.querySelector("form");
  if(form) form.reset();

  const errorBox = modal.querySelector("#address-error");
  if(errorBox) errorBox.innerText = "";

  editAddressId = null;
  document.querySelector(".modal-btn-red").innerText = "Save Address";

  modal.style.display = "none";
}

// ✅ EDIT ADDRESS OPEN
async function openEditModal(id){
  console.log("EDIT CLICKED", id); // debug

  const res = await fetch(`/user/getAddress/${id}`);
  const data = await res.json();

  if(!data.success){
    alert("Failed to load address");
    return;
  }

  const addr = data.address;

  document.getElementById("fullName").value = addr.fullName;
  document.getElementById("phone").value = addr.phone;
  document.getElementById("street").value = addr.street;
  document.getElementById("city").value = addr.city;
  document.getElementById("state").value = addr.state;
  document.getElementById("pincode").value = addr.pincode;
  document.getElementById("type").value = addr.type;
  document.getElementById("isDefault").checked = addr.isDefault;

  editAddressId = id;
  document.querySelector(".modal-btn-red").innerText = "Update Address";

  document.getElementById("add-address-modal").style.display = "flex";
}

// ✅ FORM SUBMIT
document.addEventListener("DOMContentLoaded", function(){

  const form = document.getElementById("addressForm");

  if(!form) return;

  form.addEventListener("submit", async function(e){
    e.preventDefault();

    const fullName = document.getElementById("fullName").value.trim();
    const phone = document.getElementById("phone").value.trim();
    const street = document.getElementById("street").value.trim();
    const city = document.getElementById("city").value.trim();
    const state = document.getElementById("state").value.trim();
    const pincode = document.getElementById("pincode").value.trim();
    const type = document.getElementById("type").value;
    const isDefault = document.getElementById("isDefault").checked;

    const errorBox = document.getElementById("address-error");
    errorBox.innerText = "";

    if(!fullName || !phone || !street || !city || !state || !pincode){
      errorBox.innerText = "All fields are required";
      return;
    }

    const nameRegex = /^[A-Za-z\s]+$/;

    if(!nameRegex.test(fullName)){
  errorBox.innerText = "Name must contain only letters";
  return;
}

    if(!/^[0-9]{10}$/.test(phone)){
      errorBox.innerText = "Phone must be 10 digits";
      return;
    }

    if(!/^[0-9]{6}$/.test(pincode)){
      errorBox.innerText = "Pincode must be 6 digits";
      return;
    }

    try{

      const url = editAddressId
        ? `/user/updateAddress/${editAddressId}`
        : `/user/addAddress`;

      const res = await fetch(url, {
        method:"POST",
        headers:{ "Content-Type":"application/json" },
        credentials:"include",
        body: JSON.stringify({
          fullName, phone, street, city, state, pincode, type, isDefault
        })
      });

      const data = await res.json();

      if(!data.success){
        errorBox.innerText = data.message;
        return;
      }

      location.reload();

    }catch(err){
      errorBox.innerText = "Something went wrong";
    }

  });
 
});


</script>
