<!-- LOGOUT MODAL -->
<div class="modal-overlay"
     id="logout-modal"
     style="display:none"
     onclick="if(event.target===this)hideModal('logout-modal')">

  <div class="modal-box">

    <div class="modal-icon-wrap gold-bg">→</div>

    <div class="modal-title-text">
      Logout from TYMORA?
    </div>

    <p class="modal-desc-text">
      Are you sure you want to logout?
    </p>

    <button class="modal-btn-cancel"
      style="margin-bottom:10px"
      onclick="hideModal('logout-modal')">
      Cancel
    </button>

    <form action="/user/logout" method="GET">
  <button type="submit" class="modal-btn-red">
    Logout
  </button>
</form>

  </div>

</div>

<!-- DELETE MODAL -->
<div class="modal-overlay"
     id="delete-modal"
     style="display:none">

  <div class="modal-box">

    <div class="modal-icon-wrap red-bg">🗑</div>

    <div class="modal-title-text">
      Delete Account?
    </div>

    <p class="modal-desc-text">
      This action cannot be undone.
    </p>

   

   <form action="/user/deleteAccount" method="POST" onsubmit="console.log('FORM SUBMITTED')">

   <input 
    class="modal-confirm-input"
    type="text"
    id="del-input"
    name="confirmText"  
    placeholder="DELETE">

      <button class="modal-btn-red"
        id="del-btn"
        type="submit"
        disabled>
        Delete Account
      </button>
    </form>
    <button class="modal-btn-cancel"
  onclick="hideModal('delete-modal')">
  Cancel
</button>

  </div>

</div>

<!-- CHANGE EMAIL MODAL -->
<div class="modal-overlay"
     id="change-email-modal"
     style="display:none"
     onclick="if(event.target===this)hideModal('change-email-modal')">

  <div class="modal-box">

    <div class="modal-title-text">
      Change Email
    </div>

    <p class="modal-desc-text">
      Enter your new email address
    </p>

    <!-- ERROR MESSAGE -->
    <div id="email-error" class="error-msg"></div>

    <form id="changeEmailForm">

      <input class="modal-confirm-input"
        type="email"
        id="email"
        name="email"
        placeholder="example@email.com">

      <button type="submit" class="modal-btn-red">
        Verify with Code
      </button>

    </form>

    <button class="modal-btn-cancel"
      onclick="hideModal('change-email-modal')">
      Cancel
    </button>

  </div>
</div>
<!-- OTP MODAL -->
<div class="modal-overlay"
     id="otp-modal"
     style="display:none"
     onclick="if(event.target===this)hideModal('otp-modal')">


  <div class="modal-box">

    <div class="modal-title-text">
      Verify OTP
    </div>
    <div id="otp-success" class="success-msg"></div>

    <p class="modal-desc-text">
      Enter the 6-digit code sent to your email
    </p>

    <!-- ERROR MESSAGE -->
    <div id="otp-error" class="error-msg"></div>

    <form id="otpForm">

      <input class="modal-confirm-input"
        type="text"
        id="otp"
        maxlength="6"
        placeholder="Enter OTP">

        <p id="otp-timer" style="margin-top:10px;color:#aaa;font-size:13px;"></p>

      <button type="submit" class="modal-btn-red">
        Verify OTP
      </button>

    </form>

    <!-- RESEND -->
    <button class="modal-btn-cancel" id="resendOtpBtn">
      Resend OTP
    </button>
    

    <button class="modal-btn-cancel"
      onclick="hideModal('otp-modal')">
      Cancel
    </button>

  </div>
</div>

<!-- CHANGE PASSWORD MODAL -->
<div class="modal-overlay"
     id="change-password-modal"
     style="display:none"
     onclick="if(event.target===this)hideModal('change-password-modal')">

  <div class="modal-box">

    <div class="modal-title-text">
      Change Password
    </div>

    <p class="modal-desc-text">
      Enter your current and new password
    </p>

    <!-- ERROR MESSAGE -->
    <div id="password-error" class="error-msg"></div>

    <!-- SUCCESS MESSAGE -->
    <div id="password-success" class="success-msg"></div>

    <form id="changePasswordForm">

      <!-- CURRENT PASSWORD -->
     <div class="password-wrap">
  <input type="password" id="currentPassword" placeholder="Current Password">
</div>

<div class="password-wrap">
  <input type="password" id="newPassword" placeholder="New Password">
  </div>

<div class="password-wrap">
  <input type="password" id="confirmPassword" placeholder="Confirm Password">
</div>

      <button type="submit" class="modal-btn-red">
        Update Password
      </button>

    </form>

    <button class="modal-btn-cancel"
      onclick="hideModal('change-password-modal')">
      Cancel
    </button>

  </div>
</div>

<script>
function showModal(id){
  document.getElementById(id).style.display = 'flex';
   const errorBox = document.getElementById("password-error");
  const successBox = document.getElementById("password-success");

  if(errorBox) errorBox.innerText = "";
  if(successBox) successBox.innerText = "";

  const form = document.getElementById("changePasswordForm");
  if(form) form.reset();
}

function hideModal(id){
  document.getElementById(id).style.display = 'none';
}

document.getElementById("changeEmailForm").addEventListener("submit", async function(e) {
  e.preventDefault();

  const email = document.getElementById("email").value.trim();
  const errorBox = document.getElementById("email-error");

  errorBox.innerText = "";

  //Required check
  if (!email) {
    errorBox.innerText = "Email is required";
    return;
  }

  //  Format check
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  if (!emailRegex.test(email)) {
    errorBox.innerText = "Enter a valid email address";
    return;
  }

  try {
    const res = await fetch("/user/changeEmail", {
  method: "POST",
  headers: {
    "Content-Type": "application/json"
  },
  credentials: "include",   
  body: JSON.stringify({ email })
});

    const data = await res.json();

    if (!data.success) {
      errorBox.innerText = data.message;
      return;
    }

    // SUCCESS → redirect to OTP page (or modal later)
    hideModal("change-email-modal");
    showModal("otp-modal");
    clearInterval(interval);
    timer = 60;
    startOtpTimer();
  } catch (err) {
    errorBox.innerText = "Something went wrong";
  }
});
  document.getElementById("otpForm").addEventListener("submit", async function(e){
  e.preventDefault();
  const otp = Number(document.getElementById("otp").value.trim());
  const errorBox = document.getElementById("otp-error");

  errorBox.innerText = "";

  if(!otp){
    errorBox.innerText = "OTP required";
    return;
  }

  try{

    const res = await fetch("/user/verifyEmailOtp", {
  method:"POST",
  headers:{
    "Content-Type":"application/json"
  },
  credentials:"include",  
  body: JSON.stringify({ otp })
});

    const data = await res.json();

    if(!data.success){
      errorBox.innerText = data.message;
      return;
    }

    // SUCCESS
    document.getElementById("otp-success").innerText = "Email updated successfully";

    setTimeout(()=>{
      window.location.reload();
    },1500);

  }catch(err){
    errorBox.innerText = "Something went wrong";
  }

});
document.getElementById("resendOtpBtn").addEventListener("click", async ()=>{
console.log("RESEND CLICKED");
  const successBox = document.getElementById("otp-success");
  const errorBox = document.getElementById("otp-error");

  successBox.innerText = "";
  errorBox.innerText = "";

  try{
    const res = await fetch("/user/resendEmailOtp", {
  method:"POST",
  credentials:"include"  
});
    const data = await res.json();

    if(data.success){
      successBox.innerText = "OTP sent successfully ";
      clearInterval(interval);   // stop old timer
      timer = 60;                // reset
      startOtpTimer();           // restart
    } else {
      errorBox.innerText = data.message || "Failed to resend OTP";
    }

  }catch(err){
    errorBox.innerText = "Something went wrong";
  }

});
let timer = 60;
let interval;

function startOtpTimer(){
  const timerBox = document.getElementById("otp-timer");
  const resendBtn = document.getElementById("resendOtpBtn");

  resendBtn.disabled = true;

  interval = setInterval(()=>{
    timer--;

    timerBox.innerText = `Resend available in ${timer}s`;

    if(timer <= 0){
      timerBox.innerText = "You can resend OTP now";
      resendBtn.disabled = false;
    }

  },1000);
}
const delInput = document.getElementById("del-input");
const delBtn = document.getElementById("del-btn");

if(delInput && delBtn){
  delInput.addEventListener("input", function(){
    if(this.value.trim() === "DELETE"){
      delBtn.disabled = false;
    } else {
      delBtn.disabled = true;
    }
  });
}
document.getElementById("changePasswordForm").addEventListener("submit", async function(e){
  e.preventDefault();

  const currentPassword = document.getElementById("currentPassword").value.trim();
  const newPassword = document.getElementById("newPassword").value.trim();
  const confirmPassword = document.getElementById("confirmPassword").value.trim();

  const errorBox = document.getElementById("password-error");
  const successBox = document.getElementById("password-success");

  errorBox.innerText = "";
  successBox.innerText = "";

  // 1. Required check
  if(!currentPassword || !newPassword || !confirmPassword){
    errorBox.innerText = "All fields are required";
    return;
  }

  // 2. Match check
  if(newPassword !== confirmPassword){
    errorBox.innerText = "Passwords do not match";
    return;
  }

 // 3. current password and new not match
  if(currentPassword === newPassword){
  errorBox.innerText = "New password must be different";
  return;
 }

  // 4. Strong password check
  const passwordPattern =
  /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&]).{8,}$/;

  if(!passwordPattern.test(newPassword)){
    errorBox.innerText = "Password must be strong";
    return;
  }

  try{

    const res = await fetch("/user/changePassword", {
      method:"POST",
      headers:{
        "Content-Type":"application/json"
      },
      credentials:"include",
      body: JSON.stringify({
        currentPassword,
        newPassword,
        confirmPassword
      })
    });

    const data = await res.json();

    if(data.success){

  successBox.innerText = "Password updated successfully ";

  document.getElementById("changePasswordForm").reset();

  setTimeout(()=>{
    hideModal("change-password-modal");
  },1500);
}

    successBox.innerText = "Password updated successfully ";

    setTimeout(()=>{
      hideModal("change-password-modal");
    },1500);

  }catch(err){
    errorBox.innerText = "Something went wrong";
  }

});

</script>

