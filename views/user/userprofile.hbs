<div class="breadcrumb">
  <a href="/user/home">Home</a> &nbsp;›&nbsp; <span>My Account</span>
</div>

<div class="account-wrap">

  <!-- LEFT COLUMN -->
  <div class="left-col">

    <div class="profile-card">
     <img class="profile-avatar"
      src="{{#if user.avatar}}{{user.avatar}}?v={{user._id}}{{else}}/image/useravathar.png{{/if}}"
      alt="Profile">

      <div class="profile-name">{{user.name}}</div>

      <a class="btn-edit-profile" href="/user/editProfile">
        Edit Profile
      </a>
    </div>

    <div class="info-card">

      <div class="info-item">
        <div class="info-label">Email Address</div>
        <div class="info-value">{{user.email}}</div>
      </div>

      <div class="info-item">
        <div class="info-label">Phone Number</div>
        <div class="info-value">
          {{#if user.phone}}
            {{user.phone}}
          {{else}}
            Not Added
          {{/if}}
        </div>
      </div>

      <div class="info-item">
        <div class="info-label">Date of Birth</div>
        <div class="info-value">
          {{#if user.dob}}
            {{user.dob}}
          {{else}}
            Not Added
          {{/if}}
        </div>
      </div>

    </div>

    <button class="btn-logout" onclick="showModal('logout-modal')" >
      Logout Account
    </button>

  </div>

  <!-- RIGHT COLUMN -->
  <div class="right-col">

    <!-- STATS -->
    <div class="stats-row">

      <div class="stat-card">
        <div class="stat-value">
          {{stats.watchesOwned}}
        </div>
        <div class="stat-label">Watches Owned</div>
      </div>

      <div class="stat-card">
        <div class="stat-value gold">
          {{stats.totalSpent}}
        </div>
        <div class="stat-label">Total Spent</div>
      </div>

      <div class="stat-card">
        <div class="stat-value">
          {{stats.activeReturns}}
        </div>
        <div class="stat-label">Active Returns</div>
      </div>

    </div>

    <!-- QUICK LINKS -->
    <div class="quick-links">

      <a class="quick-card" href="/user/orders">
        <span class="quick-icon">🛒</span>
        <span class="quick-label">My Orders</span>
      </a>

      <a class="quick-card" href="/user/address">
        <span class="quick-icon">📍</span>
        <span class="quick-label">My Addresses</span>
      </a>

      <a class="quick-card" href="/user/wishlist">
        <span class="quick-icon">♡</span>
        <span class="quick-label">My Wishlist</span>
      </a>

    </div>

    <div class="quick-links">

      <a class="quick-card" href="/user/wallet">
        <span class="quick-icon">💳</span>
        <span class="quick-label">My Wallet</span>
      </a>

      <a class="quick-card" href="/user/reviews">
        <span class="quick-icon">🖼</span>
        <span class="quick-label">My Reviews</span>
      </a>

      <a class="quick-card" href="/user/coupons">
        <span class="quick-icon">🏷</span>
        <span class="quick-label">My Coupons</span>
      </a>

    </div>

    <!-- BOTTOM -->
    <div class="bottom-row">

      <!-- SETTINGS -->
      <div class="panel">

        <div class="panel-title">Account Settings</div>

        <div class="setting-row">
          <a class="setting-link" onclick="showModal('change-password-modal')">
            Change Password <span>›</span>
          </a>
        </div>

        <div class="setting-row">
          <a class="setting-link"  onclick="showModal('change-email-modal')">
            Update Email Address <span>›</span>
          </a>
        </div>

        <div class="toggle-wrap">
          <span>Light Mode</span>
          <div class="toggle" id="theme-toggle"
            onclick="this.classList.toggle('on')">
          </div>
        </div>

        <button class="btn-delete-acct"
          onclick="showModal('delete-modal')">
          <span>🗑</span> Delete Account
        </button>

      </div>

      <!-- RECENT ACTIVITY -->
      <div class="panel">

        <div class="panel-title">Recent Activity</div>

        {{#if recentActivity.length}}

          {{#each recentActivity}}
            <div class="activity-item">

              <div class="act-dot"></div>

              <div>
                <div class="act-text">{{this.text}}</div>
                <div class="act-time">{{this.time}}</div>
              </div>

            </div>
          {{/each}}

        {{else}}

          <div class="activity-item">
            <div>
              <div class="act-text">No recent activity</div>
            </div>
          </div>

        {{/if}}

      </div>

    </div>

  </div>

</div>
