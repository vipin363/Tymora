<script>
document.getElementById('avatar-input').addEventListener('change', function () {
  const file = this.files[0];
  if (!file) return;

  const reader = new FileReader();

  reader.onload = function(e){
    document.getElementById('avatar-preview').src = e.target.result;
  }

  reader.readAsDataURL(file);
});

function confirmRemoveDp() {
  document.getElementById('removeDpModal').style.display = 'flex';
}

function closeRemoveDpModal() {
  document.getElementById('removeDpModal').style.display = 'none';
}

function removeDpConfirmed() {
  // preview change
  document.getElementById('avatar-preview').src = "/image/useravathar.png";

  // backend flag
  document.getElementById('removeAvatar').value = "true";

  // close modal
  closeRemoveDpModal();
}

const dropdownLi = document.querySelector('.nav-dropdown-li');
const toggle     = document.querySelector('.nav-dropdown-toggle');

// Toggle on click
toggle.addEventListener('click', (e) => {
  e.stopPropagation();
  dropdownLi.classList.toggle('open');
});

// Close when clicking anywhere outside
document.addEventListener('click', () => {
  dropdownLi.classList.remove('open');
});


</script>

