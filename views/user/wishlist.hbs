<link href="/userAllProducts.css" rel="stylesheet">
<link href="/userWishlist.css" rel="stylesheet">

<!-- BREADCRUMB -->
<div class="breadcrumb">
  <a href="/user/home">Home</a> &nbsp;›&nbsp; <span>WISHLIST</span>
</div>

<div class="wishlist-container">

  <!-- HEADER -->
  <div class="wishlist-header">
    <div>
      <h1 class="wishlist-title">My <em>Wishlist</em></h1>
      <p class="wishlist-subtitle">Your curated selection of exceptional timepieces</p>
    </div>
    <div class="wishlist-actions">
      <button class="btn-add-all" id="addAllToCart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        ADD TO CART ALL
      </button>


      <select class="sort-select" id="sortWishlist">
        <option value="newest">Sort by: Newest</option>
        <option value="price-asc">Price: Low to High</option>
        <option value="price-desc">Price: High to Low</option>
        <option value="rating">Top Rated</option>
      </select>
    </div>
  </div>

  <div class="divider"></div>

  <!-- PRODUCTS SECTION -->
  <div class="products-section">
    {{#if products.length}}
      <div class="products-grid" id="wishlistGrid">
        {{#each products}}
          <div class="prod-card"
               data-id="{{this.id}}"
               data-variant-id="{{this.variantId}}"
               data-avail="{{this.avail}}"
               data-in-cart="{{#if this.inCart}}true{{else}}false{{/if}}">
            <div class="prod-img-wrap">

              {{#if this.badgeLabel}}
                <span class="prod-badge badge-{{this.badge}}">{{this.badgeLabel}}</span>
              {{/if}}

              <div class="card-wish wished"
                   data-id="{{this.id}}"
                   data-variant-id="{{this.variantId}}"
                   title="Remove from Wishlist">
                <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.8">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06
                           a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78
                           1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              </div>

              <img src="{{this.img}}" alt="{{this.name}}" loading="lazy"
                   style="cursor:pointer"
                   onerror="this.src='/images/placeholder.jpg'"
                   onclick="window.location.href='/user/product/{{this.id}}'">
              <div class="prod-img-overlay"></div>

              {{#ifEquals this.avail 'outofstock'}}
                <button class="quick-add disabled" disabled>Out of Stock</button>
              {{else}}
                <button class="wl-cart-btn quick-add"
                        data-id="{{this.id}}"
                        data-variant-id="{{this.variantId}}"
                        data-in-cart="{{#if this.inCart}}true{{else}}{{/if}}"
                        {{#if this.inCart}}
                          style="background:transparent;color:var(--gold,#d4af37);border:1px solid var(--gold,#d4af37);"
                        {{/if}}>
                  {{#if this.inCart}}VIEW IN CART{{else}}ADD TO CART{{/if}}
                </button>
              {{/ifEquals}}

            </div>
            <div class="prod-info">
              <div class="prod-atelier">{{this.brand}}</div>
              <div class="prod-rating">★ {{this.rating}}
                {{#if this.reviews}}<span class="rating-count">({{this.reviews}})</span>{{/if}}
              </div>
              <div class="prod-name">{{this.name}}</div>
              <div class="prod-price-wrap">
                <span class="prod-price">₹{{formatCurrency this.price}}</span>
                {{#if this.oldPrice}}
                  <span class="prod-price-old">₹{{formatCurrency this.oldPrice}}</span>
                {{/if}}
                {{#if this.discountPct}}
                  <span class="prod-discount-pill">{{this.discountPct}}% OFF</span>
                {{/if}}
              </div>
              <button class="prod-btn"
                      onclick="window.location.href='/user/product/{{this.id}}'">
                View Details
              </button>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="empty-wishlist">
        <div class="empty-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </div>
        <h2>Your wishlist is empty</h2>
        <p>Explore our collections and find your next masterpiece.</p>
        <a href="/user/shop" class="btn-shop-now">Go to Shop</a>
      </div>
    {{/if}}
  </div>
</div>

<script src="/js/wishlist.js"></script>
