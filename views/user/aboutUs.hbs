<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  if (typeof gsap === 'undefined') return;
  gsap.registerPlugin(ScrollTrigger);

  // Hero parallax
  gsap.to('.about-hero-bg img', {
    scrollTrigger: { trigger: '.about-hero', start: 'top top', end: 'bottom top', scrub: true },
    yPercent: 20, ease: 'none'
  });

  // Reveal animations
  function animateReveal(selector, xFrom) {
    document.querySelectorAll(selector).forEach(el => {
      gsap.fromTo(el,
        { opacity: 0, x: xFrom, y: xFrom === 0 ? 40 : 0 },
        { scrollTrigger: { trigger: el, start: 'top 88%' }, opacity: 1, x: 0, y: 0, duration: 0.9, ease: 'power3.out' }
      );
    });
  }

  animateReveal('.reveal-up', 0);
  animateReveal('.reveal-left', -50);
  animateReveal('.reveal-right', 50);

  // Craft section parallax
  gsap.to('.craft-bg img', {
    scrollTrigger: { trigger: '.about-craft', start: 'top bottom', end: 'bottom top', scrub: true },
    yPercent: 15, ease: 'none'
  });
});
</script>
