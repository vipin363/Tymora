<!-- ═══════════════════════════════════════════════ -->
<!-- 8. TESTIMONIALS (dynamic from DB)                -->
<!-- ═══════════════════════════════════════════════ -->
{{#if hasReviews}}
<section class="about-testimonials">
  <div class="about-container">
    <div class="section-header text-center reveal-up">
      <div class="eyebrow">CLIENT VOICES</div>
      <h2>Words from the <span class="gold">Elite</span></h2>
    </div>
    <div class="testimonials-grid">
      {{#each reviews}}
      <div class="testimonial-card reveal-up">
        <div class="test-stars">{{this.stars}}</div>
        <p class="test-text">"{{this.reviewText}}"</p>
        <div class="test-footer">
          <div class="test-avatar">{{substr this.customerName 0 2}}</div>
          <div>
            <div class="test-name">{{this.customerName}}</div>
            {{#if this.productName}}<div class="test-product">{{this.productName}}</div>{{/if}}
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
{{/if}}

