<!-- ═══════════════════════════════════════════════ -->
<!-- 1. HERO                                          -->
<!-- ═══════════════════════════════════════════════ -->
<section class="about-hero">
  <div class="about-hero-bg">
    <img src="https://images.unsplash.com/photo-1547996160-81dfa63595aa?w=1920&q=80" alt="Luxury Timepiece" loading="lazy">
    <div class="about-hero-overlay"></div>
  </div>
  <div class="about-hero-content">
    <div class="eyebrow reveal-up">ESTABLISHED IN EXCELLENCE</div>
    <h1 class="reveal-up">Timeless Craftsmanship.<br><span class="gold">Modern Elegance.</span></h1>
    <p class="reveal-up">At TYMORA, we curate premium timepieces that combine precision, luxury, and enduring style — for those who command the room.</p>
    <div class="hero-btns reveal-up">
      <button onclick="location.href='/user/shop'" class="btn-gold">Explore Collection</button>
