<link href="/adminUserManagement.css" rel="stylesheet">
<div class="shell">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="brand">
        <div class="logo-icon">T</div>
        <div class="logo-text">
          <div class="name">Tymora</div>
          <div class="tagline">Tym of Refined Aesthetics</div>
        </div>
      </div>
    </div>
    <div class="nav-section">
      <div class="nav-label">Main</div>
     <a class="nav-item {{#ifEquals activePage 'dashboard'}}active{{/ifEquals}}" href="/admin/dashboard">Dashboard</a>
      <a class="nav-item {{#ifEquals activePage 'categoryManagement'}}active{{/ifEquals}}" href="/admin/categoryManagement">Category management</a>
      <a class="nav-item {{#ifEquals activePage 'products'}}active{{/ifEquals}}" href="/admin/products">Products</a>
     <a class="nav-item {{#ifEquals activePage 'users'}}active{{/ifEquals}}" href="/admin/users">Users</a>
      <a class="nav-item {{#ifEquals activePage 'orders'}}active{{/ifEquals}}" href="/admin/orders">Orders</a>
      <div class="nav-label" style="margin-top:12px">Store</div>
      <a class="nav-item" href="#"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>Returns</a>
      <a class="nav-item" href="#"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>Reviews</a>
      <a class="nav-item" href="#"><svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 000-7.78z"/></svg>Offers</a>
      <a class="nav-item" href="#"><svg viewBox="0 0 24 24"><path d="M9 14l6-6M9.5 8.5a.5.5 0 110-1 .5.5 0 010 1zM14.5 13.5a.5.5 0 110-1 .5.5 0 010 1z"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg>Coupons</a>
      <a class="nav-item" href="#"><svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>Reports</a>
      <a class="nav-item {{#ifEquals activePage 'settings'}}active{{/ifEquals}}" href="/admin/settings"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"/></svg>Settings</a>
    </div>
    <div class="nav-footer">
      <a class="nav-item logout" href="#" onclick="openLogoutModal()"><svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>Logout</a>
    </div>
  </aside>
  <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>
  <div class="main">
    <header class="topbar">
      <button class="hamburger" onclick="toggleSidebar()" aria-label="Menu"><svg viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg></button>
      <span class="topbar-title">Global Settings</span>
      <div class="admin-info">
        <div class="admin-avatar">A</div>
        <div class="admin-meta">
          <div class="admin-name">Admin</div>
        </div>
      </div>
    </header>
    <main class="content">
      <div style="padding: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
          <div>
            <h1 style="font-size: 1.5rem; font-weight: 600; color: #fff; margin-bottom: 0.5rem;">Logistics & Return Rules</h1>
            <p style="color: #9ca3af; font-size: 0.875rem; margin: 0;">Manage global shipping fees and return periods.</p>
          </div>
        </div>

        <div class="details-card" style="max-width: 600px;">
          
          <div style="margin-bottom: 1.5rem;">
            <label style="display: block; margin-bottom: 0.5rem; color: #d1d5db; font-size: 0.875rem;">Standard Shipping Fee (₹)</label>
            <input type="number" id="standardShippingFee" value="{{settings.standardShippingFee}}" style="width: 100%; padding: 0.75rem; background: #111; border: 1px solid #333; border-radius: 4px; color: #fff; font-size: 1rem; outline: none;" min="0">
          </div>

          <div style="margin-bottom: 1.5rem;">
            <label style="display: block; margin-bottom: 0.5rem; color: #d1d5db; font-size: 0.875rem;">Fast Shipping Fee (₹)</label>
            <input type="number" id="fastShippingFee" value="{{settings.fastShippingFee}}" style="width: 100%; padding: 0.75rem; background: #111; border: 1px solid #333; border-radius: 4px; color: #fff; font-size: 1rem; outline: none;" min="0">
          </div>

          <div style="margin-bottom: 2rem;">
            <label style="display: block; margin-bottom: 0.5rem; color: #d1d5db; font-size: 0.875rem;">Return Window (Days)</label>
            <input type="number" id="returnPeriodDays" value="{{settings.returnPeriodDays}}" style="width: 100%; padding: 0.75rem; background: #111; border: 1px solid #333; border-radius: 4px; color: #fff; font-size: 1rem; outline: none;" min="1" max="90">
            <p style="font-size: 12px; color: #9ca3af; margin-top: 5px;">Number of days a user has to initiate a return after the order is marked Delivered.</p>
          </div>

          <button id="saveSettingsBtn" class="act-btn" style="padding: 10px 24px; font-size: 1rem; background: #c9a84c; color: #000; border: none;">Save Settings</button>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- Logout Modal -->
<div class="modal-overlay" id="logoutModalOverlay">
  <div class="modal">
    <h3>Confirm Logout</h3>
    <p>Are you sure you want to end your session?</p>
    <div class="modal-actions">
      <button class="btn btn-secondary" onclick="closeLogoutModal()">Cancel</button>
      <button class="btn btn-danger" onclick="window.location.href='/admin/logout'">Logout</button>
    </div>
  </div>
</div>

<script>
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
    document.getElementById('overlay').classList.toggle('show');
  }
  function openLogoutModal() { document.getElementById('logoutModalOverlay').classList.add('active'); }
  function closeLogoutModal() { document.getElementById('logoutModalOverlay').classList.remove('active'); }

  document.getElementById('saveSettingsBtn').addEventListener('click', async () => {
    const btn = document.getElementById('saveSettingsBtn');
    const standardShippingFee = document.getElementById('standardShippingFee').value;
    const fastShippingFee = document.getElementById('fastShippingFee').value;
    const returnPeriodDays = document.getElementById('returnPeriodDays').value;

    btn.innerText = 'Saving...';
    btn.disabled = true;

    try {
      const res = await fetch('/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ standardShippingFee, fastShippingFee, returnPeriodDays })
      });
      const data = await res.json();
      if (data.success) {
        alert(data.message);
      } else {
        alert(data.message || 'Failed to update settings');
      }
    } catch (err) {
      console.error(err);
      alert('An error occurred');
    }
    btn.innerText = 'Save Settings';
    btn.disabled = false;
  });
</script>
