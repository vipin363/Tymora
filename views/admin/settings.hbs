<link href="/adminUserManagement.css" rel="stylesheet">
<div class="shell">
  {{> admin/sidebar}}
  <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>
  <div class="main">
    <header class="topbar">
      <button class="hamburger" onclick="toggleSidebar()" aria-label="Menu"><svg viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg></button>
      <span class="topbar-title">Global Settings</span>
      <div class="admin-info">
        <div class="admin-avatar">A</div>
        <div class="admin-meta">
          <div class="admin-name">Admin</div>
        </div>
      </div>
    </header>
    <main class="content">
      <div class="page-header" style="margin-bottom: 24px;">
          <h1 style="font-size: 20px; font-weight: 700; color: var(--navy);">Global Settings</h1>
          <p style="color: var(--muted); font-size: 13px; margin-top: 4px;">Manage store logistics, referral rules, and general configurations.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 24px; align-items: start;">
        
        <!-- Logistics Card -->
        <div class="details-card">
          <div class="section-title"><i class="fas fa-truck" style="margin-right:6px;"></i> Logistics & Return Rules</div>
          
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12.5px; font-weight: 600; color: var(--navy); margin-bottom: 6px;">Standard Shipping Fee (₹)</label>
            <input type="number" id="standardShippingFee" value="{{settings.standardShippingFee}}" style="width: 100%; height: 42px; border: 1.5px solid var(--border); border-radius: 8px; padding: 0 14px; font-size: 14px; background: var(--bg); color: var(--text); outline: none; transition: border-color 0.2s;" min="0">
          </div>

          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12.5px; font-weight: 600; color: var(--navy); margin-bottom: 6px;">Fast Shipping Fee (₹)</label>
            <input type="number" id="fastShippingFee" value="{{settings.fastShippingFee}}" style="width: 100%; height: 42px; border: 1.5px solid var(--border); border-radius: 8px; padding: 0 14px; font-size: 14px; background: var(--bg); color: var(--text); outline: none; transition: border-color 0.2s;" min="0">
          </div>

          <div style="margin-bottom: 24px;">
            <label style="display: block; font-size: 12.5px; font-weight: 600; color: var(--navy); margin-bottom: 6px;">Return Window (Days)</label>
            <input type="number" id="returnPeriodDays" value="{{settings.returnPeriodDays}}" style="width: 100%; height: 42px; border: 1.5px solid var(--border); border-radius: 8px; padding: 0 14px; font-size: 14px; background: var(--bg); color: var(--text); outline: none; transition: border-color 0.2s;" min="1" max="90">
            <p style="font-size: 11px; color: var(--muted); margin-top: 6px; line-height: 1.4;">Number of days a user has to initiate a return after the order is marked Delivered.</p>
          </div>

          <button id="saveSettingsBtn" class="btn-primary" style="width: 100%; justify-content: center; font-size: 13.5px;">Save Logistics Settings</button>
        </div>
        
        <!-- Referral Program Card -->
        <div class="details-card">
          <div class="section-title"><i class="fas fa-gift" style="margin-right:6px;"></i> Referral Program Rules</div>

          <div style="margin-bottom: 20px; display: flex; align-items: center; gap: 10px; background: var(--bg); padding: 12px 14px; border-radius: 8px; border: 1.5px solid var(--border);">
            <div class="toggle-switch" style="position: relative; display: inline-block; width: 44px; height: 24px;">
              <input type="checkbox" id="referralProgramEnabled" {{#if settings.referralProgramEnabled}}checked{{/if}} style="opacity: 0; width: 0; height: 0;">
              <span class="toggle-track" style="position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--border); transition: .4s; border-radius: 24px;" onclick="document.getElementById('referralProgramEnabled').click(); this.style.backgroundColor = document.getElementById('referralProgramEnabled').checked ? 'var(--blue-mid)' : 'var(--border)'; this.querySelector('.toggle-thumb').style.transform = document.getElementById('referralProgramEnabled').checked ? 'translateX(20px)' : 'translateX(0)';">
                <span class="toggle-thumb" style="position: absolute; width: 18px; height: 18px; background: #fff; border-radius: 50%; top: 3px; left: 3px; transition: transform .25s; box-shadow: 0 1px 4px rgba(0,0,0,.18); transform: {{#if settings.referralProgramEnabled}}translateX(20px){{else}}translateX(0){{/if}};"></span>
              </span>
            </div>
            <label style="font-size: 13px; font-weight: 600; color: var(--navy); cursor: pointer;" onclick="document.getElementById('referralProgramEnabled').click();">Enable Referral Program</label>
          </div>

          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12.5px; font-weight: 600; color: var(--navy); margin-bottom: 6px;">Referrer Reward Amount (₹)</label>
            <input type="number" id="referrerReward" value="{{settings.referrerReward}}" style="width: 100%; height: 42px; border: 1.5px solid var(--border); border-radius: 8px; padding: 0 14px; font-size: 14px; background: var(--bg); color: var(--text); outline: none; transition: border-color 0.2s;" min="0">
            <p style="font-size: 11px; color: var(--muted); margin-top: 6px; line-height: 1.4;">Wallet credit given to the existing user whose referral code was used.</p>
          </div>

          <div style="margin-bottom: 24px;">
            <label style="display: block; font-size: 12.5px; font-weight: 600; color: var(--navy); margin-bottom: 6px;">New User Reward Amount (₹)</label>
            <input type="number" id="referredReward" value="{{settings.referredReward}}" style="width: 100%; height: 42px; border: 1.5px solid var(--border); border-radius: 8px; padding: 0 14px; font-size: 14px; background: var(--bg); color: var(--text); outline: none; transition: border-color 0.2s;" min="0">
            <p style="font-size: 11px; color: var(--muted); margin-top: 6px; line-height: 1.4;">Wallet credit given to the new user who signs up with a referral code.</p>
          </div>

          <button id="saveReferralSettingsBtn" class="btn-primary" style="width: 100%; justify-content: center; font-size: 13.5px;">Save Referral Settings</button>
        </div>
      </div>
    </main>
  </div>
</div>


</div>

<script>
  
  
  

  document.getElementById('saveSettingsBtn').addEventListener('click', async () => {
    const btn = document.getElementById('saveSettingsBtn');
    const standardShippingFee = document.getElementById('standardShippingFee').value;
    const fastShippingFee = document.getElementById('fastShippingFee').value;
    const returnPeriodDays = document.getElementById('returnPeriodDays').value;

    btn.innerText = 'Saving...';
    btn.disabled = true;

    try {
      const res = await fetch('/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'logistics', standardShippingFee, fastShippingFee, returnPeriodDays })
      });
      const data = await res.json();
      if (data.success) {
        alert(data.message);
      } else {
        alert(data.message || 'Failed to update settings');
      }
    } catch (err) {
      console.error(err);
      alert('An error occurred');
    }
    btn.innerText = 'Save Settings';
    btn.disabled = false;
  });

  document.getElementById('saveReferralSettingsBtn').addEventListener('click', async () => {
    const btn = document.getElementById('saveReferralSettingsBtn');
    const referralProgramEnabled = document.getElementById('referralProgramEnabled').checked;
    const referrerReward = document.getElementById('referrerReward').value;
    const referredReward = document.getElementById('referredReward').value;

    btn.innerText = 'Saving...';
    btn.disabled = true;

    try {
      const res = await fetch('/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'referral', referralProgramEnabled, referrerReward, referredReward })
      });
      const data = await res.json();
      if (data.success) {
        alert(data.message);
      } else {
        alert(data.message || 'Failed to update settings');
      }
    } catch (err) {
      console.error(err);
      alert('An error occurred');
    }
    btn.innerText = 'Save Settings';
    btn.disabled = false;
  });
</script>
