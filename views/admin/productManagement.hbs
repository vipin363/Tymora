// ── AUTO SKU / NAME ───────────────────────────────────
let skuDebounceTimer = null;

async function autoGenerateVariantSku(force = false) {
  clearTimeout(skuDebounceTimer);
  skuDebounceTimer = setTimeout(async () => {
    const variantOpen = isVariantDrawerOpen();
    const prefix = variantOpen ? 'vd-' : '';
    const skuField = document.getElementById(`${prefix}vSku`);

    if (!skuField) return;
    if (!force && skuField.value.trim() && variantDrawerMode === 'edit') return;

    const onDetailPage = !!document.getElementById('page-detail');
    let productName, brandName, categoryName;

    if (onDetailPage) {
      productName  = document.querySelector('.pd-title')?.textContent?.trim() || '';
      brandName    = document.querySelectorAll('.pd-info-value')[1]?.textContent?.trim() || '';
      categoryName = document.querySelectorAll('.pd-info-value')[0]?.textContent?.trim() || '';
    } else {
      productName  = document.getElementById('fName')?.value?.trim() || '';
      const brandSel = document.getElementById('fBrand');
      brandName    = brandSel?.options[brandSel.selectedIndex]?.text || '';
      const catSel   = document.getElementById('fCategory');
      categoryName = catSel?.options[catSel.selectedIndex]?.text || '';
    }

    const getVal = id => document.getElementById(`${prefix}${id}`)?.value || '';

    const params = new URLSearchParams({
      brand:         brandName,
      productName,
      category:      categoryName,
      strapMaterial: getVal('vStrapMaterial'),
      strapColor:    getVal('vStrapColor'),
      caseColor:     getVal('vCaseColor'),
      dialColor:     getVal('vDialColor'),
      size:          getVal('vSize'),
    });

    try {
      const r    = await fetch(`/admin/sku/variant?${params}`);
      const data = await r.json();
      if (data.success && skuField) skuField.value = data.sku;
    } catch(e) {}
  }, 400);
}

function autoGenerateVariantName() {
  const variantOpen = isVariantDrawerOpen();
  const prefix = variantOpen ? 'vd-' : '';

  const strapColor = document.getElementById(`${prefix}vStrapColor`)?.value?.trim();
  const size       = document.getElementById(`${prefix}vSize`)?.value?.trim();
  const mat        = document.getElementById(`${prefix}vStrapMaterial`)?.value?.trim();
  const nameField  = document.getElementById(`${prefix}vName`);

  if (!nameField) return;
  if (nameField.value.trim()) return;
  const parts = [strapColor, mat, size].filter(Boolean);
  if (parts.length) nameField.value = parts.join(' ');
}

// ── VARIANT IMAGE + CROPPER ───────────────────────────
function clearVariantImagePreviews() {
  vCroppedBlobs = []; vExistingImageUrls = []; vRawFilesQueue = [];
  const grid = document.getElementById('vd-vImagePreviewGrid');
  if (grid) grid.innerHTML = '';
  updateVImageCount();
}

function handleVariantRawImages(event) {
  vRawFilesQueue = Array.from(event.target.files);
  event.target.value = '';
  processNextVInQueue();
}

function processNextVInQueue() {
  if (!vRawFilesQueue.length) return;
  const file = vRawFilesQueue.shift();
  const reader = new FileReader();
  reader.onload = e => openVCropperModal(e.target.result);
  reader.readAsDataURL(file);
}

function openVCropperModal(src) {
  if (cropperInstance) { try { cropperInstance.destroy(); } catch(e){} cropperInstance = null; }
  const modal = document.getElementById('cropperModal');
  const wrap  = document.querySelector('.crop-img-wrap');
  wrap.innerHTML = '<img id="cropperImg" alt="crop">';
  const img = document.getElementById('cropperImg');
  modal.classList.add('open');
  img.onload = () => {
    try {
      cropperInstance = new Cropper(img, {
        aspectRatio:1, viewMode:1, autoCropArea:0.9,
        dragMode:'move', movable:true, zoomable:true,
        scalable:false, rotatable:false,
        cropBoxMovable:false, cropBoxResizable:false,
        guides:true, center:true, highlight:true, background:false
      });
    } catch(e) { console.error(e); }
  };
  img.src = src;
  document.querySelector('#cropperModal .btn-confirm.green').onclick = applyVCrop;
  document.querySelector('#cropperModal .btn-cancel').onclick        = skipVCrop;
}

function applyVCrop() {
  if (!cropperInstance) return;
  cropperInstance.getCroppedCanvas({ width:800, height:800 }).toBlob(blob => {
    vCroppedBlobs.push(blob);
    addVCroppedPreview(blob, vCroppedBlobs.length - 1);
    document.getElementById('cropperModal').classList.remove('open');
    if (cropperInstance) { cropperInstance.destroy(); cropperInstance = null; }
    processNextVInQueue();
    updateVImageCount();
  }, 'image/jpeg', 0.9);
}

function skipVCrop() {
  const img = document.getElementById('cropperImg');
  fetch(img.src).then(r => r.blob()).then(blob => {
    vCroppedBlobs.push(blob);
    addVCroppedPreview(blob, vCroppedBlobs.length - 1);
    document.getElementById('cropperModal').classList.remove('open');
    if (cropperInstance) { cropperInstance.destroy(); cropperInstance = null; }
    processNextVInQueue();
    updateVImageCount();
  });
}

function addVCroppedPreview(blob, index) {
  const url  = URL.createObjectURL(blob);
  const grid = document.getElementById('vd-vImagePreviewGrid');
  if (!grid) return;
  const div = document.createElement('div');
  div.style.cssText = 'position:relative;border-radius:8px;overflow:hidden;aspect-ratio:1;';
  div.innerHTML = `<img src="${url}" style="width:100%;height:100%;object-fit:cover;">
    <button type="button" onclick="removeVCroppedImage(${index},this.parentElement)" style="position:absolute;top:4px;right:4px;width:20px;height:20px;background:rgba(220,38,38,.9);color:#fff;border:none;border-radius:50%;cursor:pointer;font-size:11px;">✕</button>
    <span style="position:absolute;bottom:4px;left:4px;background:rgba(0,0,0,.6);color:#fff;font-size:9px;padding:1px 5px;border-radius:3px;">New</span>`;
  grid.appendChild(div);
}

function addVExistingImagePreview(url) {
  vExistingImageUrls.push(url);
  const grid = document.getElementById('vd-vImagePreviewGrid');
  if (!grid) return;
  const div = document.createElement('div');
  div.style.cssText = 'position:relative;border-radius:8px;overflow:hidden;aspect-ratio:1;';
  div.innerHTML = `<img src="${url}" style="width:100%;height:100%;object-fit:cover;">
    <button type="button" onclick="removeVExistingImage('${url}',this.parentElement)" style="position:absolute;top:4px;right:4px;width:20px;height:20px;background:rgba(220,38,38,.9);color:#fff;border:none;border-radius:50%;cursor:pointer;font-size:11px;">✕</button>
    <span style="position:absolute;bottom:4px;left:4px;background:rgba(0,128,0,.7);color:#fff;font-size:9px;padding:1px 5px;border-radius:3px;">Saved</span>`;
  grid.appendChild(div);
  updateVImageCount();
}

function removeVCroppedImage(index, el) { vCroppedBlobs.splice(index, 1); el.remove(); updateVImageCount(); }
function removeVExistingImage(url, el)  { vExistingImageUrls = vExistingImageUrls.filter(u => u !== url); el.remove(); updateVImageCount(); }

function updateVImageCount() {
  const total = vCroppedBlobs.length + vExistingImageUrls.length;
  const msg   = `${total} image${total !== 1 ? 's' : ''} selected${total < 3 ? ' — at least 3 required' : ' ✓'}`;
  const color = total < 3 ? '#dc2626' : '#16a34a';
  const el = document.getElementById('vd-vImageCountNote');
  if (el) { el.textContent = msg; el.style.color = color; }
}

// ── SOFT DELETE / TRASH / RESTORE ─────────────────────
let variantToDelete = null;
function openVariantSoftDeleteModal(id)  { variantToDelete = id; document.getElementById('variantSoftDeleteModal').style.display = 'flex'; }
function closeVariantSoftDeleteModal()   { document.getElementById('variantSoftDeleteModal').style.display = 'none'; variantToDelete = null; }
async function confirmVariantSoftDelete() {
  if (!variantToDelete) return;
  if (allVariants.length <= 1) {
    showToast('Cannot delete the last variant. Delete the product instead.', 'blue');
    closeVariantSoftDeleteModal();
    return;
  }
  try {
    const r    = await fetch(`/admin/products/variants/${variantToDelete}/delete`, { method:'POST', headers:{'X-Requested-With':'XMLHttpRequest'} });
    const data = await r.json();
    if (!data.success) { showToast('Failed to delete','red'); return; }
    closeVariantSoftDeleteModal();
    showToast('Variant moved to trash','red');
    await loadVariants(currentProductId, variantCurrentPage);
    if (allVariants.length === 1) {
      await setAsDefault(allVariants[0]._id);
    }
  } catch(e) { showToast('Network error','red'); }
}

async function openVariantTrashModal() {
  document.getElementById('variantTrashModal').style.display = 'flex';
  await refreshVariantTrash();
}
function closeVariantTrashModal() { document.getElementById('variantTrashModal').style.display = 'none'; }

async function refreshVariantTrash() {
  const list = document.getElementById('variantTrashList');
  list.innerHTML = '<div style="text-align:center;color:#aaa;padding:30px;">Loading...</div>';
  try {
    const r    = await fetch(`/admin/products/${currentProductId}/variants/trash`);
    const data = await r.json();
    if (!data.success || !data.variants.length) {
      list.innerHTML = '<div style="text-align:center;color:#aaa;padding:30px;">Variant trash is empty.</div>'; return;
    }
    list.innerHTML = data.variants.map(v => `
      <div id="vtrash-${v._id}" style="display:flex;align-items:center;gap:14px;padding:12px;border:1px solid #f0f0f0;border-radius:10px;margin-bottom:10px;">
        <div class="product-thumb">${v.images?.[0]?`<img src="${v.images[0]}" alt="">`:`<span>${(v.name||'V').charAt(0).toUpperCase()}</span>`}</div>
        <div style="flex:1;"><div class="pname">${v.name}</div><div class="psku">${v.sku||''}</div><div style="font-size:11px;color:#aaa;margin-top:2px;">Deleted: ${v.deleted_at?new Date(v.deleted_at).toDateString():'-'}</div></div>
        <button class="act-btn" onclick="restoreVariant('${v._id}')">↩ Restore</button>
        <button class="act-btn danger" onclick="openVariantPermDeleteModal('${v._id}')">🗑 Delete</button>
      </div>`).join('');
  } catch(e) { list.innerHTML = '<div style="text-align:center;color:#e53;padding:30px;">Failed to load trash.</div>'; }
}

async function restoreVariant(variantId) {
  try {
    const r    = await fetch(`/admin/products/variants/${variantId}/restore`, { method:'POST', headers:{'X-Requested-With':'XMLHttpRequest'} });
    const data = await r.json();
    if (!data.success) { showToast('Failed to restore','red'); return; }
    document.getElementById(`vtrash-${variantId}`)?.remove();
    showToast('Variant restored!','green');
    await loadVariants(currentProductId, variantCurrentPage);
    const remaining = document.querySelectorAll('#variantTrashList [id^="vtrash-"]');
    if (!remaining.length) {
      document.getElementById('variantTrashList').innerHTML =
        '<div style="text-align:center;color:#aaa;padding:30px;">Variant trash is empty.</div>';
    }
  } catch(e) { showToast('Network error','red'); }
}

let variantPermDeleteId = null;
function openVariantPermDeleteModal(id)  { variantPermDeleteId = id; document.getElementById('variantPermDeleteModal').style.display = 'flex'; }
function closeVariantPermDeleteModal()   { document.getElementById('variantPermDeleteModal').style.display = 'none'; variantPermDeleteId = null; }
async function confirmVariantPermDelete() {
  if (!variantPermDeleteId) return;
  try {
    const r    = await fetch(`/admin/products/variants/${variantPermDeleteId}/permanent-delete`, { method:'POST', headers:{'X-Requested-With':'XMLHttpRequest'} });
    const data = await r.json();
    if (!data.success) { showToast('Failed','red'); return; }
    document.getElementById(`vtrash-${variantPermDeleteId}`)?.remove();
    closeVariantPermDeleteModal();
    showToast('Permanently deleted','red');
  } catch(e) { showToast('Network error','red'); }
}

