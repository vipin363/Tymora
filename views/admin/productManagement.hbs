    document.getElementById('vd-vName').value           = v.name||'';
    document.getElementById('vd-vSku').value            = v.sku||'';
    document.getElementById('vd-vSize').value           = v.size||'';
    document.getElementById('vd-vOriginalPrice').value  = v.originalPrice || v.price || '';
    document.getElementById('vd-vSalePrice').value      = v.salePrice     || v.price || '';
    calcVdDiscount();
    document.getElementById('vd-vStock').value          = v.stock||'';
    document.getElementById('vd-vStrapColor').value     = v.strapColor||'';
    document.getElementById('vd-vDialColor').value      = v.dialColor||'';
    document.getElementById('vd-vCaseColor').value      = v.caseColor||'';
    document.getElementById('vd-vStatus').value         = v.status||'active';
