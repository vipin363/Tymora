  <script>
(function populateDefaultVariant() {
  const sp = {
    sku:         '{{selectedProduct.sku}}',
    stock:       '{{selectedProduct.stock}}',
    price:       '{{selectedProduct.price}}',
    size:        '{{selectedProduct.size}}',
    strapColor:  '{{selectedProduct.strapColor}}',
    dialColor:   '{{selectedProduct.dialColor}}',
    caseColor:   '{{selectedProduct.caseColor}}',
    strapMat:    '{{selectedProduct.strapMaterial}}',
    caseMat:     '{{selectedProduct.caseMaterial}}',
    offerProduct: {{#if selectedProduct.offerProduct}}true{{else}}false{{/if}},
    variantStatus: '{{selectedProduct.variantStatus}}',
  };

  function run() {
    const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
    set('detailSku',   sp.sku   || '—');
    set('detailStock', sp.stock ? sp.stock + ' units' : '—');
    set('detailPrice', sp.price ? '₹' + sp.price : '—');
    set('detailSize',  sp.size  || '—');

    const colorsEl = document.getElementById('detailColors');
    if (colorsEl) {
      const dots = [
        sp.strapColor ? `<span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:${sp.strapColor};border:1px solid #ddd;margin-right:3px;"></span>${sp.strapColor}` : '',
        sp.dialColor  ? `<span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:${sp.dialColor};border:1px solid #ddd;margin-right:3px;"></span>${sp.dialColor}` : '',
        sp.caseColor  ? `<span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:${sp.caseColor};border:1px solid #ddd;margin-right:3px;"></span>${sp.caseColor}` : '',
      ].filter(Boolean).join(' / ');
      colorsEl.innerHTML = dots || '—';
    }

    const matEl = document.getElementById('detailMaterials');
    if (matEl) matEl.textContent = (sp.strapMat && sp.caseMat) ? `${sp.strapMat} / ${sp.caseMat}` : '—';

    const offerRow   = document.getElementById('detailOfferProductRow');
    const offerBadge = document.getElementById('detailOfferProduct');
    if (offerRow && offerBadge) {
      offerRow.style.display = 'flex';
      offerBadge.className   = `badge ${sp.offerProduct ? 's-active' : 's-inactive'}`;
      offerBadge.textContent = sp.offerProduct ? 'Yes' : 'No';
    }

    const varStatusRow   = document.getElementById('detailVariantStatusRow');
    const varStatusBadge = document.getElementById('detailVariantStatus');
    if (varStatusRow && varStatusBadge) {
      varStatusRow.style.display = 'flex';
      varStatusBadge.className   = `badge ${sp.variantStatus === 'active' ? 's-active' : 's-inactive'}`;
      varStatusBadge.textContent = sp.variantStatus === 'active' ? 'Active' : 'Inactive';
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }
})();
</script>

  <!-- VARIANT MANAGEMENT SECTION -->
<div class="pd-variant-section">
