<div class="drawer-overlay" id="productDrawer">
  <div class="drawer" style="width:700px;max-width:100vw;">
    <div class="drawer-header">
      <h3 id="drawerTitle">Add Product</h3>
      <button class="drawer-close" onclick="closeDrawer()">✕</button>
    </div>
    <div class="drawer-body">
      <form id="productForm">
        <input type="hidden" id="productId">

        <!-- ── PRODUCT INFO ── -->
        <div class="drawer-section-label">Basic Information</div>
        <div class="form-group">
          <label>Product Name *</label>
          <input type="text" id="fName" placeholder="e.g. Heritage Automatic 42mm" required>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Category *</label>
            <select id="fCategory" required>
              <option value="">Select category</option>
              {{#each categories}}
              <option value="{{this._id}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group">
            <label>Gender</label>
            <select id="fGender">
              <option value="unisex">Unisex</option>
              <option value="men">Men</option>
              <option value="women">Women</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>Brand *</label>
          <select id="fBrand" required onchange="handleBrandChange(this.value)">
            <option value="">Select brand</option>
            {{#each brands}}
            <option value="{{this._id}}">{{this.name}}</option>
            {{/each}}
            <option value="other">+ Other Brand</option>
          </select>
        </div>
        <div class="form-group" id="newBrandWrap" style="display:none">
          <label>New Brand Name *</label>
          <input type="text" id="fNewBrand" placeholder="Enter new brand name">
        </div>
        <div class="form-group">
          <label>Description</label>
          <textarea id="fDesc" rows="3" placeholder="Product description..."></textarea>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Status</label>
            <select id="fStatus">
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
          </div>
        </div>
        <div class="drawer-section-label">Visibility</div>
        <div class="toggle-row">
          <div class="toggle-item">
            <div>
              <div class="toggle-label">Featured Product</div>
              <div class="toggle-sub">Show in featured section</div>
            </div>
            <label class="toggle-switch"><input type="checkbox" id="fFeatured"><span class="slider"></span></label>
          </div>
          <div class="toggle-item">
            <div>
              <div class="toggle-label">Deal of the Day</div>
              <div class="toggle-sub">Highlight as daily deal</div>
            </div>
            <label class="toggle-switch"><input type="checkbox" id="fDealOfDay"><span class="slider"></span></label>
          </div>
        </div>

        <!-- ── DEFAULT VARIANT SECTION (add mode only) ── -->
        <div id="defaultVariantSection">
          <div class="drawer-section-label" style="margin-top:24px;background:#fef3c7;color:#92400e;padding:8px 12px;border-radius:6px;border-left:3px solid #f59e0b;">
             Default Variant <small style="font-weight:400;color:#b45309;">(required — product cannot be created without this)</small>
          </div>

          <!-- Colors -->
          <div class="drawer-section-label" style="margin-top:16px;">Colors</div>
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:16px;">
            <!-- Strap Color -->
            <div class="form-group">
              <label>Strap Color *</label>
              <div style="position:relative;">
                <div style="display:flex;gap:8px;align-items:center;">
                  <div id="strapColorSwatch" onclick="openPdColorPanel('strap')" style="width:38px;height:38px;border-radius:8px;border:2px solid #e5e7eb;cursor:pointer;background:#e5e7eb;flex-shrink:0;"></div>
                  <input type="text" id="vStrapColor" placeholder="#000000 or Black" style="flex:1;padding:9px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;outline:none;" oninput="syncPdSwatchFromInput('strap')">
                </div>
                <div id="strapColorPanel" class="color-panel-popup" style="display:none;position:absolute;top:calc(100% + 6px);left:0;z-index:400;background:#1e1e1e;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,.3);padding:14px;width:280px;">
                  <div style="position:relative;margin-bottom:10px;"><canvas id="strapCpCanvas" width="252" height="150" style="width:100%;height:150px;border-radius:8px;cursor:crosshair;display:block;"></canvas><div id="strapCpCursor" style="position:absolute;width:14px;height:14px;border:2.5px solid #fff;border-radius:50%;box-shadow:0 0 0 1.5px rgba(0,0,0,.5);transform:translate(-50%,-50%);pointer-events:none;top:50%;left:50%;"></div></div>
                  <div id="strapHueTrack" style="height:14px;border-radius:7px;margin-bottom:8px;background:linear-gradient(to right,#f00,#ff0,#0f0,#0ff,#00f,#f0f,#f00);position:relative;cursor:pointer;"><div id="strapHueThumb" style="position:absolute;top:50%;transform:translate(-50%,-50%);width:18px;height:18px;border-radius:50%;border:2.5px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4);background:#f00;cursor:grab;left:0;"></div></div>
                  <div style="display:flex;gap:6px;margin-bottom:8px;"><input type="text" id="strapHexInput" style="flex:1;background:#2a2a2a;border:1px solid #3a3a3a;color:#fff;border-radius:6px;padding:6px 8px;font-size:12px;font-family:monospace;outline:none;text-transform:uppercase;" placeholder="#FF0000" oninput="onPdHexInput('strap')"><button type="button" onclick="startPdEyedropper('strap')" style="width:32px;height:32px;background:#2a2a2a;border:1px solid #3a3a3a;border-radius:6px;cursor:pointer;color:#aaa;display:flex;align-items:center;justify-content:center;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 22l8-8"/><path d="M17.5 2.5a2.83 2.83 0 014 4L8 20l-5 1 1-5z"/></svg></button><button type="button" onclick="savePdCurrentColor('strap')" style="width:32px;height:32px;background:#2a2a2a;border:1px solid #3a3a3a;border-radius:6px;cursor:pointer;color:#aaa;display:flex;align-items:center;justify-content:center;">💾</button></div>
                  <div style="font-size:10px;color:#888;margin-bottom:6px;text-transform:uppercase;letter-spacing:.06em;">Saved Colors</div>
                  <div id="strapSavedSwatches" style="display:flex;flex-wrap:wrap;gap:5px;min-height:20px;margin-bottom:6px;"></div>
                  <button type="button" onclick="applyPdColorPanel('strap')" style="width:100%;padding:8px;background:#2563eb;color:#fff;border:none;border-radius:7px;cursor:pointer;font-size:13px;font-weight:600;margin-top:6px;">Apply</button>
                </div>
              </div>
            </div>
            <!-- Dial Color -->
            <div class="form-group">
              <label>Dial Color *</label>
              <div style="position:relative;">
                <div style="display:flex;gap:8px;align-items:center;">
                  <div id="dialColorSwatch" onclick="openPdColorPanel('dial')" style="width:38px;height:38px;border-radius:8px;border:2px solid #e5e7eb;cursor:pointer;background:#e5e7eb;flex-shrink:0;"></div>
                  <input type="text" id="vDialColor" placeholder="#000000 or Black" style="flex:1;padding:9px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;outline:none;" oninput="syncPdSwatchFromInput('dial')">
                </div>
                <div id="dialColorPanel" class="color-panel-popup" style="display:none;position:absolute;top:calc(100% + 6px);left:0;z-index:400;background:#1e1e1e;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,.3);padding:14px;width:280px;">
                  <div style="position:relative;margin-bottom:10px;"><canvas id="dialCpCanvas" width="252" height="150" style="width:100%;height:150px;border-radius:8px;cursor:crosshair;display:block;"></canvas><div id="dialCpCursor" style="position:absolute;width:14px;height:14px;border:2.5px solid #fff;border-radius:50%;box-shadow:0 0 0 1.5px rgba(0,0,0,.5);transform:translate(-50%,-50%);pointer-events:none;top:50%;left:50%;"></div></div>
                  <div id="dialHueTrack" style="height:14px;border-radius:7px;margin-bottom:8px;background:linear-gradient(to right,#f00,#ff0,#0f0,#0ff,#00f,#f0f,#f00);position:relative;cursor:pointer;"><div id="dialHueThumb" style="position:absolute;top:50%;transform:translate(-50%,-50%);width:18px;height:18px;border-radius:50%;border:2.5px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4);background:#f00;cursor:grab;left:0;"></div></div>
                  <div style="display:flex;gap:6px;margin-bottom:8px;"><input type="text" id="dialHexInput" style="flex:1;background:#2a2a2a;border:1px solid #3a3a3a;color:#fff;border-radius:6px;padding:6px 8px;font-size:12px;font-family:monospace;outline:none;text-transform:uppercase;" placeholder="#FF0000" oninput="onPdHexInput('dial')"><button type="button" onclick="startPdEyedropper('dial')" style="width:32px;height:32px;background:#2a2a2a;border:1px solid #3a3a3a;border-radius:6px;cursor:pointer;color:#aaa;display:flex;align-items:center;justify-content:center;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 22l8-8"/><path d="M17.5 2.5a2.83 2.83 0 014 4L8 20l-5 1 1-5z"/></svg></button><button type="button" onclick="savePdCurrentColor('dial')" style="width:32px;height:32px;background:#2a2a2a;border:1px solid #3a3a3a;border-radius:6px;cursor:pointer;color:#aaa;display:flex;align-items:center;justify-content:center;">💾</button></div>
                  <div style="font-size:10px;color:#888;margin-bottom:6px;text-transform:uppercase;letter-spacing:.06em;">Saved Colors</div>
                  <div id="dialSavedSwatches" style="display:flex;flex-wrap:wrap;gap:5px;min-height:20px;margin-bottom:6px;"></div>
                  <button type="button" onclick="applyPdColorPanel('dial')" style="width:100%;padding:8px;background:#2563eb;color:#fff;border:none;border-radius:7px;cursor:pointer;font-size:13px;font-weight:600;margin-top:6px;">Apply</button>
                </div>
              </div>
            </div>
            <!-- Case Color -->
            <div class="form-group">
              <label>Case Color *</label>
              <div style="position:relative;">
                <div style="display:flex;gap:8px;align-items:center;">
<div id="caseColorSwatch" onclick="openPdColorPanel('case')" style="width:38px;height:38px;border-radius:8px;border:2px solid #e5e7eb;cursor:pointer;background:#e5e7eb;flex-shrink:0;"></div>
                  <input type="text" id="vCaseColor" placeholder="#000000 or Gold" style="flex:1;padding:9px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;outline:none;" oninput="syncPdSwatchFromInput('case')">
                </div>
                <div id="caseColorPanel" class="color-panel-popup" style="display:none;position:absolute;top:calc(100% + 6px);left:0;z-index:400;background:#1e1e1e;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,.3);padding:14px;width:280px;">
                  <div style="position:relative;margin-bottom:10px;"><canvas id="caseCpCanvas" width="252" height="150" style="width:100%;height:150px;border-radius:8px;cursor:crosshair;display:block;"></canvas><div id="caseCpCursor" style="position:absolute;width:14px;height:14px;border:2.5px solid #fff;border-radius:50%;box-shadow:0 0 0 1.5px rgba(0,0,0,.5);transform:translate(-50%,-50%);pointer-events:none;top:50%;left:50%;"></div></div>
                  <div id="caseHueTrack" style="height:14px;border-radius:7px;margin-bottom:8px;background:linear-gradient(to right,#f00,#ff0,#0f0,#0ff,#00f,#f0f,#f00);position:relative;cursor:pointer;"><div id="caseHueThumb" style="position:absolute;top:50%;transform:translate(-50%,-50%);width:18px;height:18px;border-radius:50%;border:2.5px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4);background:#f00;cursor:grab;left:0;"></div></div>
                  <div style="display:flex;gap:6px;margin-bottom:8px;"><input type="text" id="caseHexInput" style="flex:1;background:#2a2a2a;border:1px solid #3a3a3a;color:#fff;border-radius:6px;padding:6px 8px;font-size:12px;font-family:monospace;outline:none;text-transform:uppercase;" placeholder="#FF0000" oninput="onPdHexInput('case')"><button type="button" onclick="startPdEyedropper('case')" style="width:32px;height:32px;background:#2a2a2a;border:1px solid #3a3a3a;border-radius:6px;cursor:pointer;color:#aaa;display:flex;align-items:center;justify-content:center;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 22l8-8"/><path d="M17.5 2.5a2.83 2.83 0 014 4L8 20l-5 1 1-5z"/></svg></button><button type="button" onclick="savePdCurrentColor('case')" style="width:32px;height:32px;background:#2a2a2a;border:1px solid #3a3a3a;border-radius:6px;cursor:pointer;color:#aaa;display:flex;align-items:center;justify-content:center;">💾</button></div>
                  <div style="font-size:10px;color:#888;margin-bottom:6px;text-transform:uppercase;letter-spacing:.06em;">Saved Colors</div>
                  <div id="caseSavedSwatches" style="display:flex;flex-wrap:wrap;gap:5px;min-height:20px;margin-bottom:6px;"></div>
                  <button type="button" onclick="applyPdColorPanel('case')" style="width:100%;padding:8px;background:#2563eb;color:#fff;border:none;border-radius:7px;cursor:pointer;font-size:13px;font-weight:600;margin-top:6px;">Apply</button>
                </div>
              </div>
            </div>
          </div>

          <!-- Materials -->
          <div class="drawer-section-label">Materials</div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:16px;">
            <div class="form-group">
              <label>Strap Material *</label>
              <div style="display:flex;gap:8px;">
                <select id="vStrapMaterial" style="flex:1;padding:9px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;outline:none;"><option value="">Select...</option></select>
                <button type="button" onclick="showAddMaterial('strap')" style="padding:9px 12px;background:#f0f7ff;border:1.5px solid #bfdbfe;border-radius:8px;cursor:pointer;color:#2563eb;font-size:13px;font-weight:600;">+ New</button>
              </div>
              <div id="strapMaterialNewRow" style="display:none;margin-top:8px;">
                <div style="display:flex;gap:8px;align-items:center;">
                  <input type="text" id="strapMaterialInput" placeholder="e.g. Silicone" style="flex:1;padding:9px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;outline:none;">
                  <button type="button" onclick="saveMaterial('strap')" style="padding:9px 14px;background:#16a34a;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:13px;font-weight:600;">Save</button>
                  <button type="button" onclick="hideAddMaterial('strap')" style="padding:9px 14px;background:#f3f4f6;color:#555;border:none;border-radius:8px;cursor:pointer;font-size:13px;">✕</button>
                </div>
              </div>
            </div>
            <div class="form-group">
              <label>Case Material *</label>
              <div style="display:flex;gap:8px;">
                <select id="vCaseMaterial" style="flex:1;padding:9px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;outline:none;"><option value="">Select...</option></select>
                <button type="button" onclick="showAddMaterial('case')" style="padding:9px 12px;background:#f0f7ff;border:1.5px solid #bfdbfe;border-radius:8px;cursor:pointer;color:#2563eb;font-size:13px;font-weight:600;">+ New</button>
              </div>
              <div id="caseMaterialNewRow" style="display:none;margin-top:8px;">
                <div style="display:flex;gap:8px;align-items:center;">
                  <input type="text" id="caseMaterialInput" placeholder="e.g. Stainless Steel" style="flex:1;padding:9px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;outline:none;">
                  <button type="button" onclick="saveMaterial('case')" style="padding:9px 14px;background:#16a34a;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:13px;font-weight:600;">Save</button>
                  <button type="button" onclick="hideAddMaterial('case')" style="padding:9px 14px;background:#f3f4f6;color:#555;border:none;border-radius:8px;cursor:pointer;font-size:13px;">✕</button>
                </div>
              </div>
            </div>
          </div>

          <!-- Specs -->
          <div class="drawer-section-label">Specifications</div>
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:14px;margin-bottom:16px;">
            <div class="form-group">
              <label>Size *</label>
              <input type="text" id="vSize" placeholder="e.g. 42mm" style="width:100%;padding:9px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;outline:none;box-sizing:border-box;">
            </div>
            <div class="form-group">
              <label>MRP / Original Price (₹) *</label>
              <input type="number" id="vOriginalPrice" placeholder="0" min="0"
                style="width:100%;padding:9px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;outline:none;box-sizing:border-box;"
                oninput="calcPdDiscount()">
            </div>
            <div class="form-group">
              <label>Sale Price (₹) *</label>
              <input type="number" id="vSalePrice" placeholder="0" min="0"
                style="width:100%;padding:9px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;outline:none;box-sizing:border-box;"
                oninput="calcPdDiscount()">
            </div>
            <div class="form-group">
              <label>Stock *</label>
              <input type="number" id="vStock" placeholder="0" min="0" style="width:100%;padding:9px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;outline:none;box-sizing:border-box;">
            </div>
            <div class="form-group">
              <label>Status</label>
              <select id="vStatus" style="width:100%;padding:9px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;outline:none;box-sizing:border-box;">
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
              </select>
            </div>
          </div>
<!-- Discount Preview -->
          <div id="pdDiscountPreview" style="display:none;margin-bottom:16px;padding:10px 14px;background:linear-gradient(135deg,#fef3c7,#fde68a);border:1px solid #f59e0b;border-radius:8px;display:flex;align-items:center;gap:10px;">
            <span style="font-size:18px;">🏷️</span>
            <span style="font-size:13px;color:#92400e;font-weight:600;">Discount: <span id="pdDiscountBadge" style="font-size:15px;color:#b45309;font-weight:800;">0% OFF</span></span>
            <span style="font-size:12px;color:#a16207;margin-left:auto;">You save ₹<span id="pdDiscountSaving">0</span></span>
          </div>
          <!-- SKU -->
          <div class="form-group" style="margin-bottom:16px;">
            <label>SKU <small style="color:#888;font-weight:400;">(auto-generated, editable)</small></label>
            <div style="display:flex;gap:8px;">
              <input type="text" id="vSku" placeholder="Auto-generated..." style="flex:1;padding:9px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;outline:none;font-family:monospace;">
              <button type="button" onclick="autoGenerateVariantSku(true)" style="padding:9px 14px;background:#f0f7ff;border:1.5px solid #bfdbfe;border-radius:8px;cursor:pointer;color:#2563eb;font-size:13px;font-weight:600;">↻ Regen</button>
            </div>
          </div>

          <!-- Variant Name -->
          <div class="form-group" style="margin-bottom:16px;">
            <label>Variant Name * <small style="color:#888;font-weight:400;">(auto-suggested)</small></label>
            <input type="text" id="vName" placeholder="e.g. Black Leather 42mm" style="width:100%;padding:9px 12px;border:1.5px solid #e5e7eb;border-radius:8px;font-size:13px;outline:none;box-sizing:border-box;">
          </div>

          <!-- Offer Product toggle -->
          <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid #f0f0f0;margin-bottom:16px;">
            <div>
              <div style="font-size:13px;font-weight:600;color:#333;">Offer Product</div>
              <div style="font-size:12px;color:#888;">Mark this variant as special offer</div>
            </div>
            <label class="toggle-switch"><input type="checkbox" id="vOfferProduct"><span class="slider"></span></label>
          </div>

          <!-- Images -->
          <div class="drawer-section-label">Variant Images <span style="color:#888;font-size:11px;font-weight:400;">(min 3 required)</span></div>
          <div class="form-group">
            <div onclick="document.getElementById('vRawImageInput').click()" style="border:2px dashed #e5e7eb;border-radius:10px;padding:28px;text-align:center;cursor:pointer;background:#fafafa;">
              <div style="font-size:28px;margin-bottom:6px;">📁</div>
              <p style="margin:0;color:#555;font-size:13.5px;">Click to select images</p>
              <small style="color:#aaa;">JPG, PNG, WEBP — select multiple (min 3)</small>
            </div>
<input type="file" id="vRawImageInput" accept="image/*" multiple style="display:none" onchange="handleProductRawImages(event)">
            <div id="vImagePreviewGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));gap:10px;margin-top:12px;"></div>
            <div id="vImageCountNote" style="font-size:12px;margin-top:6px;color:#dc2626;">0 images — at least 3 required</div>
          </div>
        </div>
        <!-- end defaultVariantSection -->

      </form>
    </div>
    <div class="drawer-footer">
      <button class="btn-cancel-outline" onclick="closeDrawer()">Cancel</button>
      <button class="btn-primary" id="drawerSubmitBtn" onclick="submitProductForm()">Save Product</button>
    </div>
  </div>
</div>

<!-- ══ VARIANT ADD/EDIT DRAWER ══ -->
<div class="drawer-overlay" id="variantDrawer" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:1100;align-items:flex-start;justify-content:flex-end;">
  <div style="width:640px;max-width:100vw;height:100vh;background:#fff;display:flex;flex-direction:column;box-shadow:-8px 0 40px rgba(0,0,0,.18);transform:translateX(100%);transition:transform .3s cubic-bezier(.4,0,.2,1);" id="variantDrawerBox">
    <div style="padding:20px 24px;border-bottom:1px solid #f0f0f0;display:flex;align-items:center;justify-content:space-between;background:#fafafa;flex-shrink:0;">
      <h3 id="vd-variantDrawerTitle" style="margin:0;font-size:17px;font-weight:700;">Add Variant</h3>
      <button onclick="closeVariantDrawer()" style="width:32px;height:32px;border:none;background:#f0f0f0;border-radius:50%;cursor:pointer;font-size:16px;">✕</button>
    </div>
    <div style="flex:1;overflow-y:auto;padding:24px;" id="variantDrawerBody">
      <form id="variantForm">
  <input type="hidden" id="vd-vProductId">
  <input type="hidden" id="vd-vVariantId">

  <!-- Colors -->
