    await loadMaterials();
    document.getElementById('vd-vStrapMaterial').value = v.strapMaterial||'';
    document.getElementById('vd-vCaseMaterial').value  = v.caseMaterial||'';
    ['strap','dial','case'].forEach(f => {
      const colorMap  = { strap: 'vd-vStrapColor', dial: 'vd-vDialColor', case: 'vd-vCaseColor' };
      const swatchMap = { strap: 'vd-strapColorSwatch', dial: 'vd-dialColorSwatch', case: 'vd-caseColorSwatch' };
      const val = document.getElementById(colorMap[f])?.value;
      const sw  = document.getElementById(swatchMap[f]);
      if (sw && val) sw.style.background = val;
    });
    if (v.images?.length) v.images.forEach(url => addVExistingImagePreview(url));
  } catch(e) { showToast('Failed to load variant','red'); return; }
  const overlay = document.getElementById('variantDrawer');
  overlay.style.display = 'flex';
  setTimeout(() => document.getElementById('variantDrawerBox').style.transform = 'translateX(0)', 10);
  ['strap','dial','case'].forEach(f => { initColorCanvas(f); loadSavedColorSwatches(f); });
}

function closeVariantDrawer() {
  document.getElementById('variantDrawerBox').style.transform = 'translateX(100%)';
  setTimeout(() => { document.getElementById('variantDrawer').style.display = 'none'; }, 300);
}

function resetVColorPanels() {
  ['strap','dial','case'].forEach(f => {
    const panel = document.getElementById(`vd-${f}ColorPanel`);
    if (panel) panel.style.display = 'none';
    const inp   = document.getElementById(`vd-v${f.charAt(0).toUpperCase()+f.slice(1)}Color`);
    if (inp) inp.value = '';
    const sw    = document.getElementById(`vd-${f}ColorSwatch`);
    if (sw) sw.style.background = '#e5e7eb';
  });
}

// ── VARIANT SUBMIT ────────────────────────────────────
async function submitVariantForm() {
  const productId     = document.getElementById('vd-vProductId').value;
  const variantId     = document.getElementById('vd-vVariantId').value;
  const name          = document.getElementById('vd-vName').value.trim();
  const sku           = document.getElementById('vd-vSku').value.trim();
  const size          = document.getElementById('vd-vSize').value.trim();
  const originalPrice = document.getElementById('vd-vOriginalPrice').value;
  const salePrice     = document.getElementById('vd-vSalePrice').value;
  const stock         = document.getElementById('vd-vStock').value;
  const strapColor    = document.getElementById('vd-vStrapColor').value.trim();
  const dialColor     = document.getElementById('vd-vDialColor').value.trim();
  const caseColor     = document.getElementById('vd-vCaseColor').value.trim();
  const strapMaterial = document.getElementById('vd-vStrapMaterial').value;
  const caseMaterial  = document.getElementById('vd-vCaseMaterial').value;

  if (!name)          { showToast('Variant name is required','blue'); return; }
  if (!strapColor)    { showToast('Strap color is required','blue');  return; }
  if (!dialColor)     { showToast('Dial color is required','blue');   return; }
  if (!caseColor)     { showToast('Case color is required','blue');   return; }
  if (!size)          { showToast('Size is required','blue');         return; }
  if (!strapMaterial) { showToast('Strap material is required','blue'); return; }
  if (!caseMaterial)  { showToast('Case material is required','blue');  return; }
  if (!originalPrice) { showToast('Original price is required','blue'); return; }
  if (!salePrice)     { showToast('Sale price is required','blue');     return; }
  if (parseFloat(salePrice) > parseFloat(originalPrice)) {
    showToast('Sale price cannot exceed original price','blue'); return;
  }
  if (vCroppedBlobs.length + vExistingImageUrls.length < 3) { showToast('At least 3 images required','blue'); return; }

  const fd = new FormData();
  fd.append('name',name); fd.append('sku',sku); fd.append('size',size);
  fd.append('originalPrice', originalPrice);
    fd.append('salePrice',     salePrice); fd.append('stock',stock||'0');
  fd.append('strapColor',strapColor); fd.append('dialColor',dialColor); fd.append('caseColor',caseColor);
  fd.append('strapMaterial',strapMaterial); fd.append('caseMaterial',caseMaterial);
  fd.append('status', document.getElementById('vd-vStatus').value);
  fd.append('offerProduct', document.getElementById('vd-vOfferProduct').checked);
  vExistingImageUrls.forEach(url => fd.append('existingImages', url));
  vCroppedBlobs.forEach((blob,i) => fd.append('images', blob, `vimg_${i}.jpg`));

  const url = variantDrawerMode === 'add'
    ? `/admin/products/${productId}/variants/add`
    : `/admin/products/variants/${variantId}/edit`;
  const btn = document.getElementById('vd-variantSubmitBtn');
  btn.disabled = true; btn.textContent = 'Saving...';
  try {
    const r    = await fetch(url, { method:'POST', headers:{'X-Requested-With':'XMLHttpRequest'}, body:fd });
    const data = await r.json();
    if (!data.success) { showToast(data.message||'Error','red'); return; }
    closeVariantDrawer();
    showToast(variantDrawerMode==='add'?'Variant added!':'Variant updated!','green');
    await loadVariants(productId, variantCurrentPage);
  } catch(e) { showToast('Network error','red'); }
  finally { btn.disabled=false; btn.textContent=variantDrawerMode==='add'?'Add Variant':'Save Changes'; }
}

// ═══════════════════════════════════════════════════════════════
//  COLOR PANEL — UNIFIED (handles both product drawer and variant drawer)
// ═══════════════════════════════════════════════════════════════

const _cpListenersAttached = {};

function isVariantDrawerOpen() {
  return document.getElementById('variantDrawer')?.style.display === 'flex';
}

// Called by both drawers' color swatches (onclick="openPdColorPanel('strap')" etc.)
function openPdColorPanel(field) {
  const variantOpen = isVariantDrawerOpen();
  const prefix = variantOpen ? 'vd-' : '';

  ['strap','dial','case'].forEach(f => {
    if (f !== field) {
      const p = document.getElementById(`${prefix}${f}ColorPanel`);
      if (p) p.style.display = 'none';
    }
  });

  const panel = document.getElementById(`${prefix}${field}ColorPanel`);
  if (!panel) return;
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
  if (panel.style.display === 'block') {
    if (variantOpen) {
      initColorCanvas(field);
      loadSavedColorSwatches(field);
    } else {
      initPdColorCanvas(field);
      loadPdSavedColorSwatches(field);
    }
  }
}

// Also keep openColorPanel as alias (used nowhere in HTML but kept for safety)
function openColorPanel(field) {
  openPdColorPanel(field);
}

function drawColorCanvas(canvas, hue) {
  const ctx=canvas.getContext('2d'), w=canvas.width, h=canvas.height;
  ctx.fillStyle=`hsl(${hue},100%,50%)`; ctx.fillRect(0,0,w,h);
  const wg=ctx.createLinearGradient(0,0,w,0); wg.addColorStop(0,'rgba(255,255,255,1)'); wg.addColorStop(1,'rgba(255,255,255,0)');
  ctx.fillStyle=wg; ctx.fillRect(0,0,w,h);
  const bg=ctx.createLinearGradient(0,0,0,h); bg.addColorStop(0,'rgba(0,0,0,0)'); bg.addColorStop(1,'rgba(0,0,0,1)');
  ctx.fillStyle=bg; ctx.fillRect(0,0,w,h);
}

function sampleCanvasColor(canvas, x, y) {
  const ctx=canvas.getContext('2d');
  const d=ctx.getImageData(Math.round(x*(canvas.width-1)),Math.round(y*(canvas.height-1)),1,1).data;
  return '#'+[d[0],d[1],d[2]].map(v=>v.toString(16).padStart(2,'0')).join('').toUpperCase();
}

// ── VARIANT DRAWER canvas init (vd- prefix) ───────────
function initColorCanvas(field) {
  const canvas = document.getElementById(`vd-${field}CpCanvas`);
  if (!canvas) return;
  const key = canvas.id;
  drawColorCanvas(canvas, cpState[field].hue || 0);
  if (_cpListenersAttached[key]) return;
  _cpListenersAttached[key] = true;

  canvas.addEventListener('mousedown', e => {
    const onMove = ev => {
      const rect = canvas.getBoundingClientRect();
      const x = Math.max(0, Math.min(1, (ev.clientX - rect.left) / rect.width));
      const y = Math.max(0, Math.min(1, (ev.clientY - rect.top)  / rect.height));
      const hex = sampleCanvasColor(canvas, x, y);
      const hexInp = document.getElementById(`vd-${field}HexInput`);
      if (hexInp) hexInp.value = hex;
      const cursor = document.getElementById(`vd-${field}CpCursor`);
      if (cursor) { cursor.style.left = (x*100)+'%'; cursor.style.top = (y*100)+'%'; }
      cpState[field].hex = hex;
    };
    onMove(e);
    const up = () => { document.removeEventListener('mousemove', onMove); document.removeEventListener('mouseup', up); };
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', up);
  });

  const hueTrack = document.getElementById(`vd-${field}HueTrack`);
  if (hueTrack) {
    hueTrack.addEventListener('mousedown', e => {
      const onMove = ev => {
        const rect = hueTrack.getBoundingClientRect();
        const pct  = Math.max(0, Math.min(1, (ev.clientX - rect.left) / rect.width));
        const hue  = Math.round(pct * 360);
        cpState[field].hue = hue;
        const thumb = document.getElementById(`vd-${field}HueThumb`);
        if (thumb) { thumb.style.left = (pct*100)+'%'; thumb.style.background = `hsl(${hue},100%,50%)`; }
        drawColorCanvas(canvas, hue);
      };
      onMove(e);
      const up = () => { document.removeEventListener('mousemove', onMove); document.removeEventListener('mouseup', up); };
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', up);
    });
  }
}

// ── PRODUCT DRAWER canvas init (plain prefix) ─────────
const pdCpState = {};
['strap','dial','case'].forEach(f => { pdCpState[f] = { hue: 0, hex: '' }; });
const pdCpListenersAttached = {};

function pdGet(id) { return document.getElementById(id); }

function initPdColorCanvas(field) {
  const canvas = pdGet(`${field}CpCanvas`);
  if (!canvas) return;
  drawColorCanvas(canvas, pdCpState[field].hue || 0);
  if (pdCpListenersAttached[field]) return;
  pdCpListenersAttached[field] = true;

  canvas.addEventListener('mousedown', e => {
    const onMove = ev => {
      const rect = canvas.getBoundingClientRect();
      const x   = Math.max(0, Math.min(1, (ev.clientX - rect.left) / rect.width));
      const y   = Math.max(0, Math.min(1, (ev.clientY - rect.top)  / rect.height));
      const hex = sampleCanvasColor(canvas, x, y);
      const hexInp = pdGet(`${field}HexInput`);
      if (hexInp) hexInp.value = hex;
      const cursor = pdGet(`${field}CpCursor`);
      if (cursor) { cursor.style.left = (x*100)+'%'; cursor.style.top = (y*100)+'%'; }
      pdCpState[field].hex = hex;
    };
    onMove(e);
    const up = () => { document.removeEventListener('mousemove', onMove); document.removeEventListener('mouseup', up); };
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', up);
  });

  const hueTrack = pdGet(`${field}HueTrack`);
  if (hueTrack) {
    hueTrack.addEventListener('mousedown', e => {
      const onMove = ev => {
        const rect = hueTrack.getBoundingClientRect();
        const pct  = Math.max(0, Math.min(1, (ev.clientX - rect.left) / rect.width));
        const hue  = Math.round(pct * 360);
        pdCpState[field].hue = hue;
        const thumb = pdGet(`${field}HueThumb`);
        if (thumb) { thumb.style.left = (pct*100)+'%'; thumb.style.background = `hsl(${hue},100%,50%)`; }
        drawColorCanvas(canvas, hue);
      };
      onMove(e);
      const up = () => { document.removeEventListener('mousemove', onMove); document.removeEventListener('mouseup', up); };
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', up);
    });
  }
}

