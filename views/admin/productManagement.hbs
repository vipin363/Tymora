document.addEventListener('DOMContentLoaded', () => {
  const detailPage = document.getElementById('page-detail');
  if (detailPage) {
    // Read product id from the edit button's onclick or embed it as data attribute
    // Simplest: add data-product-id to page-detail div and read it here
    const pid = detailPage.dataset.productId;
    if (pid) loadVariants(pid);
  }
});
