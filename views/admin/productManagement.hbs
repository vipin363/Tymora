async function restoreVariant(variantId) {
  try {
    const r=await fetch(`/admin/products/variants/${variantId}/restore`,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'}});
    const data=await r.json();
    if (!data.success) { showToast('Failed to restore','red'); return; }
    document.getElementById(`vtrash-${variantId}`)?.remove();
    showToast('Variant restored!','green');
    await loadVariants(currentProductId, variantCurrentPage);
  } catch(e) { showToast('Network error','red'); }
}
let variantPermDeleteId=null;
function openVariantPermDeleteModal(id)  { variantPermDeleteId=id; document.getElementById('variantPermDeleteModal').style.display='flex'; }
function closeVariantPermDeleteModal()   { document.getElementById('variantPermDeleteModal').style.display='none'; variantPermDeleteId=null; }
async function confirmVariantPermDelete() {
  if (!variantPermDeleteId) return;
  try {
    const r=await fetch(`/admin/products/variants/${variantPermDeleteId}/permanent-delete`,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'}});
