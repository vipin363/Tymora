function showToast(msg, type = 'green') {
  const icons = {
    green: '<polyline points="20 6 9 17 4 12"/>',
    red:   '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>',
    blue:  '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>'
  };
  const wrap = document.getElementById('toastWrap');
  const t    = document.createElement('div');
  t.className = 'toast';
  t.innerHTML = `<div class="toast-icon ${type}"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">${icons[type]||icons.green}</svg></div><span>${msg}</span>`;
  wrap.appendChild(t);
  requestAnimationFrame(() => requestAnimationFrame(() => t.classList.add('show')));
  setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 400); }, 3000);
}

// ── DISCOUNT CALCULATORS ──────────────────────────────
function calcPdDiscount() {
  const op = parseFloat(document.getElementById('vOriginalPrice')?.value) || 0;
  const sp = parseFloat(document.getElementById('vSalePrice')?.value)     || 0;
  const preview = document.getElementById('pdDiscountPreview');
  const badge   = document.getElementById('pdDiscountBadge');
  const saving  = document.getElementById('pdDiscountSaving');
  if (!preview) return;
  if (op > 0 && sp >= 0 && sp <= op) {
    const pct = Math.max(0, Math.round(((op - sp) / op) * 100));
    preview.style.display = 'flex';
    badge.textContent  = pct + '% OFF';
    saving.textContent = (op - sp).toLocaleString('en-IN');
  } else {
    preview.style.display = 'none';
  }
}

function calcVdDiscount() {
  const op = parseFloat(document.getElementById('vd-vOriginalPrice')?.value) || 0;
  const sp = parseFloat(document.getElementById('vd-vSalePrice')?.value)     || 0;
  const preview = document.getElementById('vdDiscountPreview');
  const badge   = document.getElementById('vdDiscountBadge');
  const saving  = document.getElementById('vdDiscountSaving');
  if (!preview) return;
  if (op > 0 && sp >= 0 && sp <= op) {
    const pct = Math.max(0, Math.round(((op - sp) / op) * 100));
    preview.style.display = 'flex';
    badge.textContent  = pct + '% OFF';
    saving.textContent = (op - sp).toLocaleString('en-IN');
  } else {
    preview.style.display = 'none';
  }
}

