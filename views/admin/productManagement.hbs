async function selectVariant(variantId) {
  try {
    const r    = await fetch(`/admin/products/variants/${variantId}/json`);
    const data = await r.json();
    if (!data.success) { showToast('Failed to load variant','red'); return; }
    const v = data.variant;

    document.querySelectorAll('#variantTableBody tr').forEach(r => r.style.background = '');
    const row = document.getElementById(`variant-row-${variantId}`);
    if (row) row.style.background = '#f0f7ff';

    if (v.images?.length) {
      const mainImg = document.getElementById('galleryMain');
      if (mainImg) mainImg.src = v.images[0];
      const thumbsEl = document.querySelector('.pd-gallery-thumbs');
      if (thumbsEl) {
        thumbsEl.innerHTML = v.images.map((src, i) =>
          `<div class="pd-thumb${i===0?' active':''}" onclick="switchImage('${src}',this)"><img src="${src}" alt="thumb ${i}"></div>`
        ).join('');
      }
    }

    const priceTag = document.querySelector('.pd-price-tag');
    if (priceTag) priceTag.textContent = `PRICE ₹${v.price}`;

    const stockVal = document.querySelector('.pd-stat-value');
    if (stockVal) stockVal.innerHTML = `${v.stock} <span class="pd-stat-unit">units</span>`;

    const sku   = document.getElementById('detailSku');    if (sku)   sku.textContent   = v.sku   || '-';
    const stock = document.getElementById('detailStock');  if (stock) stock.textContent = `${v.stock} units`;
    const price = document.getElementById('detailPrice');  if (price) price.textContent = `₹${v.price}`;
    const size  = document.getElementById('detailSize');   if (size)  size.textContent  = v.size  || '-';

    const colorsEl = document.getElementById('detailColors');
    if (colorsEl) {
      const dots = [
        v.strapColor ? `<span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:${v.strapColor};border:1px solid #ddd;margin-right:3px;"></span>${v.strapColor}` : '',
        v.dialColor  ? `<span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:${v.dialColor};border:1px solid #ddd;margin-right:3px;"></span>${v.dialColor}`  : '',
        v.caseColor  ? `<span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:${v.caseColor};border:1px solid #ddd;margin-right:3px;"></span>${v.caseColor}`  : '',
      ].filter(Boolean).join(' / ');
      colorsEl.innerHTML = dots || '-';
    }

    const matEl = document.getElementById('detailMaterials');
    if (matEl) matEl.textContent = `${v.strapMaterial||'-'} / ${v.caseMaterial||'-'}`;

    const offerRow   = document.getElementById('detailOfferProductRow');
    const offerBadge = document.getElementById('detailOfferProduct');
    if (offerRow && offerBadge) {
      offerRow.style.display = 'flex';
      offerBadge.className   = `badge ${v.offerProduct ? 's-active' : 's-inactive'}`;
      offerBadge.textContent = v.offerProduct ? 'Yes' : 'No';
    }

    const varStatusRow   = document.getElementById('detailVariantStatusRow');
    const varStatusBadge = document.getElementById('detailVariantStatus');
    if (varStatusRow && varStatusBadge) {
      varStatusRow.style.display = 'flex';
      varStatusBadge.className   = `badge ${v.status==='active' ? 's-active' : 's-inactive'}`;
      varStatusBadge.textContent = v.status==='active' ? 'Active' : 'Inactive';
    }
  } catch(e) { showToast('Failed to load variant details','red'); }
}

// ── MATERIALS ─────────────────────────────────────────
function showAddMaterial(type) {
  const variantOpen = isVariantDrawerOpen();
  if (variantOpen) {
    const el = document.getElementById(`vd-${type}MaterialNewRow`);
    if (el) el.style.display = 'block';
  } else {
    const el = document.getElementById(`${type}MaterialNewRow`);
    if (el) el.style.display = 'block';
  }
}

function hideAddMaterial(type) {
  const variantOpen = isVariantDrawerOpen();
  if (variantOpen) {
    const el  = document.getElementById(`vd-${type}MaterialNewRow`);
    const inp = document.getElementById(`vd-${type}MaterialInput`);
    if (el)  el.style.display = 'none';
    if (inp) inp.value = '';
  } else {
    const el  = document.getElementById(`${type}MaterialNewRow`);
    const inp = document.getElementById(`${type}MaterialInput`);
    if (el)  el.style.display = 'none';
    if (inp) inp.value = '';
  }
}

async function saveMaterial(type) {
  const variantOpen = isVariantDrawerOpen();
  const inp = variantOpen
    ? document.getElementById(`vd-${type}MaterialInput`)
    : document.getElementById(`${type}MaterialInput`);
  const name = inp?.value?.trim();
  if (!name) { showToast('Enter material name','blue'); return; }
  try {
    const r = await fetch('/admin/materials/add', {
      method:'POST',
      headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
      body: JSON.stringify({ name, type: type === 'strap' ? 'strap' : 'case' })
    });
    const data = await r.json();
    if (!data.success) { showToast(data.message||'Error','red'); return; }
    hideAddMaterial(type);
    showToast(`Material "${name}" saved!`,'green');
    await loadMaterials();
    const selId = variantOpen
      ? `vd-v${type==='strap'?'Strap':'Case'}Material`
      : `v${type==='strap'?'Strap':'Case'}Material`;
    const sel = document.getElementById(selId);
    if (sel) sel.value = name;
  } catch(e) { showToast('Network error','red'); }
}

async function loadMaterials() {
  try {
    const r    = await fetch('/admin/materials');
    const data = await r.json();
    if (!data.success) return;
    ['vd-vStrapMaterial','vd-vCaseMaterial','vStrapMaterial','vCaseMaterial'].forEach(id => {
      const sel = document.getElementById(id);
      if (!sel) return;
      const cur = sel.value;
      sel.innerHTML = '<option value="">Select...</option>';
      data.materials.forEach(m => {
        const o = document.createElement('option');
        o.value = m.name; o.textContent = m.name;
        sel.appendChild(o);
      });
      if (cur) sel.value = cur;
    });
  } catch(e) { console.error(e); }
}
</script>