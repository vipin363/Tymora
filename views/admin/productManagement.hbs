// ── VARIANT IMAGE + CROPPER ───────────────────────────
function clearVariantImagePreviews() {
  vCroppedBlobs=[]; vExistingImageUrls=[]; vRawFilesQueue=[];
  const grid=document.getElementById('vImagePreviewGrid');
  if (grid) grid.innerHTML='';
  updateVImageCount();
}
function handleVariantRawImages(event) {
  vRawFilesQueue=Array.from(event.target.files);
  event.target.value='';
  processNextVInQueue();
}
function processNextVInQueue() {
  if (!vRawFilesQueue.length) return;
  const file=vRawFilesQueue.shift();
  const reader=new FileReader();
  reader.onload=e=>openVCropperModal(e.target.result);
  reader.readAsDataURL(file);
}
function openVCropperModal(src) {
  if (cropperInstance) { try{cropperInstance.destroy();}catch(e){} cropperInstance=null; }
  const modal=document.getElementById('cropperModal');
  const wrap=document.querySelector('.crop-img-wrap');
  wrap.innerHTML='<img id="cropperImg" alt="crop">';
  const img=document.getElementById('cropperImg');
  modal.classList.add('open');
  img.onload=()=>{ try{ cropperInstance=new Cropper(img,{aspectRatio:1,viewMode:1,autoCropArea:0.9,dragMode:'move',movable:true,zoomable:true,scalable:false,rotatable:false,cropBoxMovable:false,cropBoxResizable:false,guides:true,center:true,highlight:true,background:false}); }catch(e){console.error(e);} };
  img.src=src;
  document.querySelector('#cropperModal .btn-confirm.green').onclick=applyVCrop;
  document.querySelector('#cropperModal .btn-cancel').onclick=skipVCrop;
}
function applyVCrop() {
  if (!cropperInstance) return;
  cropperInstance.getCroppedCanvas({width:800,height:800}).toBlob(blob=>{
    vCroppedBlobs.push(blob);
    addVCroppedPreview(blob,vCroppedBlobs.length-1);
    document.getElementById('cropperModal').classList.remove('open');
    if (cropperInstance){cropperInstance.destroy();cropperInstance=null;}
    processNextVInQueue(); updateVImageCount();
  },'image/jpeg',0.9);
}
function skipVCrop() {
  const img=document.getElementById('cropperImg');
  fetch(img.src).then(r=>r.blob()).then(blob=>{
    vCroppedBlobs.push(blob);
    addVCroppedPreview(blob,vCroppedBlobs.length-1);
    document.getElementById('cropperModal').classList.remove('open');
    if (cropperInstance){cropperInstance.destroy();cropperInstance=null;}
    processNextVInQueue(); updateVImageCount();
  });
}
function addVCroppedPreview(blob,index) {
  const url=URL.createObjectURL(blob);
  const grid=document.getElementById('vImagePreviewGrid');
  const div=document.createElement('div');
  div.style.cssText='position:relative;border-radius:8px;overflow:hidden;aspect-ratio:1;';
  div.innerHTML=`<img src="${url}" style="width:100%;height:100%;object-fit:cover;"><button type="button" onclick="removeVCroppedImage(${index},this.parentElement)" style="position:absolute;top:4px;right:4px;width:20px;height:20px;background:rgba(220,38,38,.9);color:#fff;border:none;border-radius:50%;cursor:pointer;font-size:11px;">✕</button><span style="position:absolute;bottom:4px;left:4px;background:rgba(0,0,0,.6);color:#fff;font-size:9px;padding:1px 5px;border-radius:3px;">New</span>`;
  grid.appendChild(div);
}
function addVExistingImagePreview(url) {
  vExistingImageUrls.push(url);
  const grid=document.getElementById('vImagePreviewGrid');
  const div=document.createElement('div');
  div.style.cssText='position:relative;border-radius:8px;overflow:hidden;aspect-ratio:1;';
  div.innerHTML=`<img src="${url}" style="width:100%;height:100%;object-fit:cover;"><button type="button" onclick="removeVExistingImage('${url}',this.parentElement)" style="position:absolute;top:4px;right:4px;width:20px;height:20px;background:rgba(220,38,38,.9);color:#fff;border:none;border-radius:50%;cursor:pointer;font-size:11px;">✕</button><span style="position:absolute;bottom:4px;left:4px;background:rgba(0,128,0,.7);color:#fff;font-size:9px;padding:1px 5px;border-radius:3px;">Saved</span>`;
  grid.appendChild(div);
  updateVImageCount();
}
function removeVCroppedImage(index,el) { vCroppedBlobs.splice(index,1); el.remove(); updateVImageCount(); }
function removeVExistingImage(url,el)  { vExistingImageUrls=vExistingImageUrls.filter(u=>u!==url); el.remove(); updateVImageCount(); }
function updateVImageCount() {
  const total=vCroppedBlobs.length+vExistingImageUrls.length;
  const note=document.getElementById('vImageCountNote');
  if (!note) return;
  note.textContent=`${total} image${total!==1?'s':''} selected${total<3?' — at least 3 required':' ✓'}`;
  note.style.color=total<3?'#dc2626':'#16a34a';
}

// ── MATERIALS ─────────────────────────────────────────
async function loadMaterials() {
  try {
    const r=await fetch('/admin/materials');
    const data=await r.json();
    if (!data.success) return;
    populateMaterialSelect('vStrapMaterial',data.materials);
    populateMaterialSelect('vCaseMaterial',data.materials);
  } catch(e) { console.error(e); }
}
function populateMaterialSelect(selectId,materials) {
  const sel=document.getElementById(selectId);
  if (!sel) return;
  const cur=sel.value;
  sel.innerHTML='<option value="">Select...</option>';
  materials.forEach(m=>{ const o=document.createElement('option'); o.value=m.name; o.textContent=m.name; sel.appendChild(o); });
  if (cur) sel.value=cur;
}
function showAddMaterial(type) { document.getElementById(`${type}MaterialNewRow`).style.display='block'; }
function hideAddMaterial(type) { document.getElementById(`${type}MaterialNewRow`).style.display='none'; document.getElementById(`${type}MaterialInput`).value=''; }
async function saveMaterial(type) {
  const name=document.getElementById(`${type}MaterialInput`).value.trim();
  if (!name) { showToast('Enter material name','blue'); return; }
  try {
    const r=await fetch('/admin/materials/add',{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify({name,type:type==='strap'?'strap':'case'})});
    const data=await r.json();
    if (!data.success) { showToast(data.message||'Error','red'); return; }
    hideAddMaterial(type);
    showToast(`Material "${name}" saved!`,'green');
    await loadMaterials();
    document.getElementById(type==='strap'?'vStrapMaterial':'vCaseMaterial').value=name;
  } catch(e) { showToast('Network error','red'); }
}

// ── COLOR PANEL ───────────────────────────────────────
function initColorCanvas(field) {
  const canvas=document.getElementById(`${field}CpCanvas`);
  if (!canvas) return;
  drawColorCanvas(canvas,cpState[field].hue||0);
  canvas.addEventListener('mousedown',e=>{
    const onMove=ev=>{
      const rect=canvas.getBoundingClientRect();
      const x=Math.max(0,Math.min(1,(ev.clientX-rect.left)/rect.width));
      const y=Math.max(0,Math.min(1,(ev.clientY-rect.top)/rect.height));
      const hex=sampleCanvasColor(canvas,x,y);
      document.getElementById(`${field}HexInput`).value=hex;
      document.getElementById(`${field}CpCursor`).style.left=(x*100)+'%';
      document.getElementById(`${field}CpCursor`).style.top=(y*100)+'%';
      cpState[field].hex=hex;
    };
    onMove(e);
    const up=()=>{document.removeEventListener('mousemove',onMove);document.removeEventListener('mouseup',up);};
    document.addEventListener('mousemove',onMove);
    document.addEventListener('mouseup',up);
  });
  const hueTrack=document.getElementById(`${field}HueTrack`);
  if (hueTrack) {
    hueTrack.addEventListener('mousedown',e=>{
      const onMove=ev=>{
        const rect=hueTrack.getBoundingClientRect();
        const pct=Math.max(0,Math.min(1,(ev.clientX-rect.left)/rect.width));
        const hue=Math.round(pct*360);
        cpState[field].hue=hue;
        document.getElementById(`${field}HueThumb`).style.left=(pct*100)+'%';
        document.getElementById(`${field}HueThumb`).style.background=`hsl(${hue},100%,50%)`;
        drawColorCanvas(canvas,hue);
      };
      onMove(e);
      const up=()=>{document.removeEventListener('mousemove',onMove);document.removeEventListener('mouseup',up);};
      document.addEventListener('mousemove',onMove);
      document.addEventListener('mouseup',up);
    });
  }
}
function drawColorCanvas(canvas,hue) {
  const ctx=canvas.getContext('2d'),w=canvas.width,h=canvas.height;
  ctx.fillStyle=`hsl(${hue},100%,50%)`; ctx.fillRect(0,0,w,h);
  const wg=ctx.createLinearGradient(0,0,w,0); wg.addColorStop(0,'rgba(255,255,255,1)'); wg.addColorStop(1,'rgba(255,255,255,0)');
  ctx.fillStyle=wg; ctx.fillRect(0,0,w,h);
  const bg=ctx.createLinearGradient(0,0,0,h); bg.addColorStop(0,'rgba(0,0,0,0)'); bg.addColorStop(1,'rgba(0,0,0,1)');
  ctx.fillStyle=bg; ctx.fillRect(0,0,w,h);
}
function sampleCanvasColor(canvas,x,y) {
  const ctx=canvas.getContext('2d');
  const d=ctx.getImageData(Math.round(x*(canvas.width-1)),Math.round(y*(canvas.height-1)),1,1).data;
  return '#'+[d[0],d[1],d[2]].map(v=>v.toString(16).padStart(2,'0')).join('').toUpperCase();
}
function openColorPanel(field) {
  ['strap','dial','case'].forEach(f=>{if(f!==field)document.getElementById(`${f}ColorPanel`).style.display='none';});
  const panel=document.getElementById(`${field}ColorPanel`);
  panel.style.display=panel.style.display==='block'?'none':'block';
  if (panel.style.display==='block') { initColorCanvas(field); loadSavedColorSwatches(field); }
}
function onHexInput(field) {
  const hex=document.getElementById(`${field}HexInput`).value;
  if (/^#[0-9A-Fa-f]{6}$/.test(hex)) cpState[field].hex=hex.toUpperCase();
}
function applyColorPanel(field) {
  const hex=document.getElementById(`${field}HexInput`).value.trim().toUpperCase();
  const inputMap={strap:'vStrapColor',dial:'vDialColor',case:'vCaseColor'};
  if (hex) { document.getElementById(inputMap[field]).value=hex; syncSwatchFromInput(field); }
  document.getElementById(`${field}ColorPanel`).style.display='none';
  autoGenerateVariantName(); autoGenerateVariantSku();
}
function syncSwatchFromInput(field) {
  const inputMap ={strap:'vStrapColor',dial:'vDialColor',case:'vCaseColor'};
  const swatchMap={strap:'strapColorSwatch',dial:'dialColorSwatch',case:'caseColorSwatch'};
  const val=document.getElementById(inputMap[field]).value.trim();
  const sw=document.getElementById(swatchMap[field]);
  if (sw&&val) sw.style.background=val;
  autoGenerateVariantName();
}
function saveCurrentColor(field) {
  const hex=document.getElementById(`${field}HexInput`).value.trim();
  if (!hex) { showToast('Pick a color first','blue'); return; }
  fetch('/admin/saved-colors',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({hex})})
    .then(r=>r.json()).then(data=>{ if(data.success){showToast('Color saved!','green');loadSavedColorSwatches(field);} });
}
async function loadSavedColors() {
  try {
    const r=await fetch('/admin/saved-colors');
    const data=await r.json();
    if (data.success) ['strap','dial','case'].forEach(f=>loadSavedColorSwatches(f,data.colors));
  } catch(e) {}
}
async function loadSavedColorSwatches(field,colors) {
  const container=document.getElementById(`${field}SavedSwatches`);
  if (!container) return;
  if (!colors) {
    try { const r=await fetch('/admin/saved-colors'); const data=await r.json(); colors=data.colors||[]; } catch(e){return;}
  }
  if (!colors.length) { container.innerHTML='<span style="color:#555;font-size:11px;">No saved colors yet</span>'; return; }
  container.innerHTML=colors.map(c=>`<div onclick="selectSavedColor('${field}','${c.hex}')" title="${c.name||c.hex}" style="width:22px;height:22px;border-radius:5px;background:${c.hex};border:1.5px solid rgba(255,255,255,.2);cursor:pointer;flex-shrink:0;" onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'"></div>`).join('');
}
function selectSavedColor(field,hex) {
  document.getElementById(`${field}HexInput`).value=hex;
  const inputMap ={strap:'vStrapColor',dial:'vDialColor',case:'vCaseColor'};
  const swatchMap={strap:'strapColorSwatch',dial:'dialColorSwatch',case:'caseColorSwatch'};
  document.getElementById(inputMap[field]).value=hex;
  document.getElementById(swatchMap[field]).style.background=hex;
  cpState[field].hex=hex;
}
async function startEyedropper(field) {
  if (!window.EyeDropper) { showToast('Eyedropper not supported (use Chrome)','blue'); return; }
  try {
    const result=await new EyeDropper().open();
    const hex=result.sRGBHex.toUpperCase();
    document.getElementById(`${field}HexInput`).value=hex;
    selectSavedColor(field,hex);
    showToast(`Color picked: ${hex}`,'green');
  } catch(e) {}
}
function resetColorPanels() {
  ['strap','dial','case'].forEach(f=>{
    const panel=document.getElementById(`${f}ColorPanel`);
    if (panel) panel.style.display='none';
    const inputMap ={strap:'vStrapColor',dial:'vDialColor',case:'vCaseColor'};
    const swatchMap={strap:'strapColorSwatch',dial:'dialColorSwatch',case:'caseColorSwatch'};
    document.getElementById(inputMap[f]).value='';
    document.getElementById(swatchMap[f]).style.background='#e5e7eb';
  });
}

// ── AUTO SKU ──────────────────────────────────────────
let skuDebounceTimer=null;
async function autoGenerateVariantSku(force=false) {
  clearTimeout(skuDebounceTimer);
  skuDebounceTimer=setTimeout(async()=>{
    const skuField=document.getElementById('vSku');
    if (!force&&skuField.value.trim()) return;
    const productName=document.querySelector('.pd-title')?.textContent?.trim()||'';
    const brandName  =document.querySelector('.pd-info-value')?.textContent?.trim()||'';
    const categoryEl =document.querySelectorAll('.pd-info-value')[0]?.textContent?.trim()||'';
    const params=new URLSearchParams({brand:brandName,productName,category:categoryEl,strapMaterial:document.getElementById('vStrapMaterial').value||'',strapColor:document.getElementById('vStrapColor').value||'',caseColor:document.getElementById('vCaseColor').value||'',dialColor:document.getElementById('vDialColor').value||'',size:document.getElementById('vSize').value||''});
    try { const r=await fetch(`/admin/sku/variant?${params}`); const data=await r.json(); if(data.success)skuField.value=data.sku; } catch(e){}
  },600);
}
document.getElementById('fBrand')?.addEventListener('change',autoGenerateProductSku);
document.getElementById('fName')?.addEventListener('input',autoGenerateProductSku);
let productSkuDebounce=null;
async function autoGenerateProductSku() {
  clearTimeout(productSkuDebounce);
  productSkuDebounce=setTimeout(async()=>{
    const skuField=document.getElementById('fSku');
    if (skuField.value.trim()) return;
    const brandSel=document.getElementById('fBrand');
    const brandText=(brandSel.options[brandSel.selectedIndex]?.text||'').replace('Select brand','').replace('+ Other Brand','').trim();
    const model=document.getElementById('fName').value.trim();
    if (!model) return;
    try { const r=await fetch(`/admin/sku/product?${new URLSearchParams({brand:brandText||'GEN',model})}`); const data=await r.json(); if(data.success)skuField.value=data.sku; } catch(e){}
  },700);
}
function autoGenerateVariantName() {
  const strapColor=document.getElementById('vStrapColor').value.trim();
  const size      =document.getElementById('vSize').value.trim();
  const mat       =document.getElementById('vStrapMaterial').value;
  const parts     =[strapColor,mat,size].filter(Boolean);
  if (parts.length&&!document.getElementById('vName').value) document.getElementById('vName').value=parts.join(' ');
}
['vStrapMaterial','vCaseMaterial'].forEach(id=>{document.getElementById(id)?.addEventListener('change',()=>autoGenerateVariantSku());});
document.getElementById('vSize')?.addEventListener('input',()=>autoGenerateVariantSku());
</script>