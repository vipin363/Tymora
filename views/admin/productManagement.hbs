let allVariants        = [];
let variantDrawerMode  = 'add';
let vRawFilesQueue     = [];
let vCroppedBlobs      = [];
let vExistingImageUrls = [];
let variantCurrentPage = 1;
let variantTotalPages  = 1;
let currentProductId   = null;

const cpState = {};
['strap','dial','case'].forEach(f => { cpState[f] = { hue: 0, hex: '' }; });

document.addEventListener('DOMContentLoaded', () => {
  const detailPage = document.getElementById('page-detail');
  if (detailPage) {
    currentProductId = detailPage.dataset.productId;
    if (currentProductId) { loadVariants(currentProductId, 1); loadMaterials(); loadSavedColors(); }
  }
  document.addEventListener('click', e => {
    if (!e.target.closest('.color-panel-popup') && !e.target.closest('[onclick*="openColorPanel"]')) {
      document.querySelectorAll('.color-panel-popup').forEach(p => p.style.display = 'none');
    }
  });
  ['strap','dial','case'].forEach(f => initColorCanvas(f));
});

async function loadVariants(productId, page = 1) {
  variantCurrentPage = page;
  try {
    const r    = await fetch(`/admin/products/${productId}/variants?page=${page}`);
    const data = await r.json();
    allVariants       = data.variants || [];
    variantTotalPages = data.totalPages || 1;
    updateVariantCount(data.total || allVariants.length);
    renderVariantTable(allVariants);
    renderVariantPagination(data.currentPage, data.totalPages, productId);
  } catch (e) {
    document.getElementById('variantTableBody').innerHTML =
      '<tr><td colspan="8" style="text-align:center;padding:30px;color:#aaa">Failed to load variants.</td></tr>';
  }
}

function renderVariantTable(variants) {
  const tbody = document.getElementById('variantTableBody');
  if (!tbody) return;
  if (!variants.length) {
    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:40px;color:#aaa">No variants found. Click "Add Variant" to create one.</td></tr>';
    return;
  }
  tbody.innerHTML = variants.map(v => {
    const stockBadge = v.stock === 0
      ? `<span class="stock-badge out-stock">Out of Stock</span>`
      : v.stock <= 10
        ? `<span class="stock-badge low-stock">${v.stock} Low</span>`
        : `<span class="stock-badge in-stock">${v.stock} In Stock</span>`;
    const colorDots = [
      v.strapColor ? `<span title="Strap:${v.strapColor}" style="display:inline-block;width:14px;height:14px;border-radius:50%;background:${v.strapColor};border:1.5px solid #ddd;vertical-align:middle;"></span>` : '',
      v.dialColor  ? `<span title="Dial:${v.dialColor}"   style="display:inline-block;width:14px;height:14px;border-radius:50%;background:${v.dialColor};border:1.5px solid #ddd;vertical-align:middle;"></span>` : '',
      v.caseColor  ? `<span title="Case:${v.caseColor}"   style="display:inline-block;width:14px;height:14px;border-radius:50%;background:${v.caseColor};border:1.5px solid #ddd;vertical-align:middle;"></span>` : '',
    ].filter(Boolean).join(' ');
    return `<tr id="variant-row-${v._id}">
      <td><div class="product-thumb">${v.images?.[0]?`<img src="${v.images[0]}" alt="">`:`<span>${(v.name||'V').charAt(0).toUpperCase()}</span>`}</div></td>
      <td><div class="pname">${v.name||'-'}</div><div class="psku">${v.sku||''}</div></td>
      <td>${colorDots||'-'}<br><small style="color:#888;font-size:11px;">${[v.strapColor,v.dialColor,v.caseColor].filter(Boolean).join(' / ')||''}</small></td>
      <td>${v.size||'-'}</td>
      <td><small>${v.strapMaterial||''} / ${v.caseMaterial||''}</small></td>
      <td>₹${v.price||'-'}</td>
      <td>${stockBadge}</td>
      <td>
        <button class="act-btn" onclick="openEditVariantModal('${v._id}')">✏️</button>
        <button class="act-btn danger" onclick="openVariantSoftDeleteModal('${v._id}','${(v.name||'').replace(/'/g,"\\'")}')">🗑</button>
      </td></tr>`;
  }).join('');
}

function renderVariantPagination(current, total, productId) {
  const pg = document.getElementById('variantPagination');
  if (!pg || total <= 1) { if (pg) pg.innerHTML = ''; return; }
  pg.innerHTML = `
    ${current > 1 ? `<a href="#" onclick="loadVariants('${productId}',${current-1});return false;">Prev</a>` : ''}
    <span>Page ${current} of ${total}</span>
    ${current < total ? `<a href="#" onclick="loadVariants('${productId}',${current+1});return false;">Next</a>` : ''}`;
}
function updateVariantCount(count) {
  const b = document.getElementById('variantCountBadge');
  if (b) b.textContent = `${count} Variant${count!==1?'s':''}`;
}
function filterVariants(search) {
  const s = search.toLowerCase();
  const f = allVariants.filter(v =>
    (v.name||'').toLowerCase().includes(s)||(v.sku||'').toLowerCase().includes(s)||
    (v.strapColor||'').toLowerCase().includes(s)||(v.dialColor||'').toLowerCase().includes(s));
  renderVariantTable(f); updateVariantCount(f.length);
}
function sortVariants(val) {
  let f = [...allVariants];
  if (val==='in_stock')  f=f.filter(v=>v.stock>10);
  if (val==='low_stock') f=f.filter(v=>v.stock>0&&v.stock<=10);
  if (val==='out_stock') f=f.filter(v=>v.stock===0);
  renderVariantTable(f); updateVariantCount(f.length);
}

function openAddVariantModal(productId) {
  variantDrawerMode = 'add';
  currentProductId  = productId;
  document.getElementById('variantDrawerTitle').textContent = 'Add Variant';
  document.getElementById('variantSubmitBtn').textContent   = 'Add Variant';
  document.getElementById('variantForm').reset();
  document.getElementById('vVariantId').value  = '';
  document.getElementById('vProductId').value  = productId;
  clearVariantImagePreviews();
  resetColorPanels();
  const overlay = document.getElementById('variantDrawer');
  overlay.style.display = 'flex';
  setTimeout(()=>document.getElementById('variantDrawerBox').style.transform='translateX(0)',10);
  ['strap','dial','case'].forEach(f=>{initColorCanvas(f);loadSavedColorSwatches(f);});
}
async function openEditVariantModal(variantId) {
  variantDrawerMode = 'edit';
  document.getElementById('variantDrawerTitle').textContent = 'Edit Variant';
  document.getElementById('variantSubmitBtn').textContent   = 'Save Changes';
  document.getElementById('vVariantId').value = variantId;
  clearVariantImagePreviews();
  resetColorPanels();
  try {
    const r    = await fetch(`/admin/products/variants/${variantId}/json`);
    const data = await r.json();
    if (!data.success) { showToast('Failed to load variant','red'); return; }
    const v = data.variant;
    document.getElementById('vProductId').value      = v.product;
    document.getElementById('vName').value           = v.name||'';
    document.getElementById('vSku').value            = v.sku||'';
    document.getElementById('vSize').value           = v.size||'';
    document.getElementById('vPrice').value          = v.price||'';
    document.getElementById('vStock').value          = v.stock||'';
    document.getElementById('vStrapColor').value     = v.strapColor||'';
    document.getElementById('vDialColor').value      = v.dialColor||'';
    document.getElementById('vCaseColor').value      = v.caseColor||'';
    document.getElementById('vStrapMaterial').value  = v.strapMaterial||'';
    document.getElementById('vCaseMaterial').value   = v.caseMaterial||'';
    ['strap','dial','case'].forEach(f=>syncSwatchFromInput(f));
    if (v.images?.length) v.images.forEach(url=>addVExistingImagePreview(url));
  } catch(e) { showToast('Failed to load variant','red'); return; }
  const overlay = document.getElementById('variantDrawer');
  overlay.style.display = 'flex';
  setTimeout(()=>document.getElementById('variantDrawerBox').style.transform='translateX(0)',10);
  ['strap','dial','case'].forEach(f=>{initColorCanvas(f);loadSavedColorSwatches(f);});
}
function closeVariantDrawer() {
  document.getElementById('variantDrawerBox').style.transform='translateX(100%)';
  setTimeout(()=>{document.getElementById('variantDrawer').style.display='none';},300);
}

async function submitVariantForm() {
  const productId     = document.getElementById('vProductId').value;
  const variantId     = document.getElementById('vVariantId').value;
  const name          = document.getElementById('vName').value.trim();
  const sku           = document.getElementById('vSku').value.trim();
  const size          = document.getElementById('vSize').value.trim();
  const price         = document.getElementById('vPrice').value;
  const stock         = document.getElementById('vStock').value;
  const strapColor    = document.getElementById('vStrapColor').value.trim();
  const dialColor     = document.getElementById('vDialColor').value.trim();
  const caseColor     = document.getElementById('vCaseColor').value.trim();
  const strapMaterial = document.getElementById('vStrapMaterial').value;
  const caseMaterial  = document.getElementById('vCaseMaterial').value;

  if (!name)          { showToast('Variant name is required','blue'); return; }
  if (!strapColor)    { showToast('Strap color is required','blue');  return; }
  if (!dialColor)     { showToast('Dial color is required','blue');   return; }
  if (!caseColor)     { showToast('Case color is required','blue');   return; }
  if (!size)          { showToast('Size is required','blue');         return; }
  if (!strapMaterial) { showToast('Strap material is required','blue'); return; }
  if (!caseMaterial)  { showToast('Case material is required','blue');  return; }
  if (!price)         { showToast('Price is required','blue');        return; }
  if (vCroppedBlobs.length + vExistingImageUrls.length < 3) { showToast('At least 3 images required','blue'); return; }

  const fd = new FormData();
  fd.append('name',name); fd.append('sku',sku); fd.append('size',size);
  fd.append('price',price); fd.append('stock',stock||'0');
  fd.append('strapColor',strapColor); fd.append('dialColor',dialColor); fd.append('caseColor',caseColor);
  fd.append('strapMaterial',strapMaterial); fd.append('caseMaterial',caseMaterial);
  vExistingImageUrls.forEach(url=>fd.append('existingImages',url));
  vCroppedBlobs.forEach((blob,i)=>fd.append('images',blob,`vimg_${i}.jpg`));

  const url = variantDrawerMode==='add'
    ? `/admin/products/${productId}/variants/add`
    : `/admin/products/variants/${variantId}/edit`;
  const btn = document.getElementById('variantSubmitBtn');
  btn.disabled=true; btn.textContent='Saving...';
  try {
    const r    = await fetch(url,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'},body:fd});
    const data = await r.json();
    if (!data.success) { showToast(data.message||'Error','red'); return; }
    closeVariantDrawer();
    showToast(variantDrawerMode==='add'?'Variant added!':'Variant updated!','green');
    await loadVariants(productId, variantCurrentPage);
  } catch(e) { showToast('Network error','red'); }
  finally { btn.disabled=false; btn.textContent=variantDrawerMode==='add'?'Add Variant':'Save Changes'; }
}

