    list.innerHTML=data.variants.map(v=>`
      <div id="vtrash-${v._id}" style="display:flex;align-items:center;gap:14px;padding:12px;border:1px solid #f0f0f0;border-radius:10px;margin-bottom:10px;">
        <div class="product-thumb">${v.images?.[0]?`<img src="${v.images[0]}" alt="">`:`<span>${(v.name||'V').charAt(0).toUpperCase()}</span>`}</div>
        <div style="flex:1;"><div class="pname">${v.name}</div><div class="psku">${v.sku||''}</div><div style="font-size:11px;color:#aaa;margin-top:2px;">Deleted: ${v.deleted_at?new Date(v.deleted_at).toDateString():'-'}</div></div>
