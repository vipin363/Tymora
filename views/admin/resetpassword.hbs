{{!-- resetpassword --}}
  <link rel="stylesheet" href="/adminResetPassword.css">


<div class="split">

  <!-- LEFT -->
  <section class="left">
    <div class="logo-row">
      <div class="logo-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
        </svg>
      </div>
      <div class="logo-text">
        <div class="brand">Tymora Admin</div>
        <div class="suite">Enterprise Security Suite</div>
      </div>
    </div>

    <div class="hero">
      <div class="hero-eyebrow">Identity Protection</div>
      <h1>Secure Access &amp;<br><span>Resilience</span></h1>
      <p>Protecting your digital assets with advanced architectural minimalism and high-performance encryption.</p>
    </div>

    <div class="feature-cards">
      <div class="fcard">
        <div class="fcard-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <h3>Advanced Security</h3>
        <p>Multi-layer encryption with automated threat detection and mitigation.</p>
      </div>
      <div class="fcard">
        <div class="fcard-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
          </svg>
        </div>
        <h3>Real-time Control</h3>
        <p>Instantly manage permissions and monitor system integrity across nodes.</p>
      </div>
    </div>
  </section>

  <!-- RIGHT -->
  <section class="right">
    <div class="card">

      <div class="card-badge">
        <div class="card-badge-dot">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <span>Secure Reset</span>
      </div>

      <form class="form-content" action="/admin/resetPassword" method="POST">
        <h2>Reset Password</h2>
        <p class="card-sub">Enter your new credentials to secure your account.</p>
{{#if error}}
  <p class="error-msg show" style="color:red; margin-bottom:15px;">{{error}}</p>
{{/if}}
        <div class="field">
          <label for="newPass">New Password</label>
          <div class="input-wrap">
            <input type="password" id="newPass" name="newPassword" placeholder="Enter new password" autocomplete="new-password"/>
            <button class="eye-btn" type="button" onclick="toggleEye('newPass', this)" aria-label="Toggle password">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="field">
          <label for="confirmPass">Confirm Password</label>
          <div class="input-wrap">
            <input type="password" id="confirmPass" name="confirmPassword" placeholder="Re-enter your password" autocomplete="new-password"/>
            <button class="eye-btn" type="button" onclick="toggleEye('confirmPass', this)" aria-label="Toggle password">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
        </div>

       
        <button class="btn-primary" type="submit" >Update Password</button>

        <a href="admin/login" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
          </svg>
          Back to Login
        </a>
      </form>

      <div class="success-state" id="successState">
        <div class="success-circle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <h3>Password Updated!</h3>
        <p>Your account credentials have been secured successfully. You may now log in.</p>
        <a href="#" class="btn-primary" style="display:block;text-align:center;text-decoration:none;padding:14px;border-radius:12px;">Return to Login</a>
      </div>

    </div>
  </section>

</div>

<script>
  function toggleEye(id, btn) {
    const inp = document.getElementById(id);
    const isHidden = inp.type === 'password';
    inp.type = isHidden ? 'text' : 'password';
    btn.innerHTML = isHidden
      ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
           <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
           <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
           <line x1="1" y1="1" x2="23" y2="23"/>
         </svg>`
      : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
           <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
         </svg>`;
  }

  const rules = [
    { id: 'rule-len',     test: v => v.length >= 8 },
    { id: 'rule-num',     test: v => /\d/.test(v) },
    { id: 'rule-upper',   test: v => /[A-Z]/.test(v) },
    { id: 'rule-special', test: v => /[^A-Za-z0-9]/.test(v) },
  ];

  function updateRules(val, touched) {
    let score = 0;
    rules.forEach(r => {
      const el = document.getElementById(r.id);
      const ok = r.test(val);
      if (ok) { score++; el.classList.add('valid'); el.classList.remove('invalid'); }
      else if (touched && val.length > 0) { el.classList.add('invalid'); el.classList.remove('valid'); }
      else { el.classList.remove('valid', 'invalid'); }
    });
    return score;
  }

  function updateStrength(score) {
    const labels = ['', 'weak', 'fair', 'strong', 'strong'];
    ['seg1','seg2','seg3','seg4'].forEach((s, i) => {
      const el = document.getElementById(s);
      el.className = 'strength-seg';
      if (i < score) el.classList.add(labels[score]);
    });
  }

  const newPass = document.getElementById('newPass');
  const confirmPass = document.getElementById('confirmPass');

  newPass.addEventListener('input', () => {
    const score = updateRules(newPass.value, true);
    updateStrength(score);
    validateConfirm();
  });

  confirmPass.addEventListener('input', validateConfirm);

  function validateConfirm() {
    const v = confirmPass.value;
    if (!v) { confirmPass.className = ''; return; }
    if (v === newPass.value) {
      confirmPass.classList.add('success'); confirmPass.classList.remove('error');
    } else {
      confirmPass.classList.add('error'); confirmPass.classList.remove('success');
    }
  }


</script>
