        </div>

        <!-- KPI Summary Cards -->
        <div class="stats-grid">
          <div class="stat-card highlight">
            <div class="icon-wrap">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div class="slabel">Net Revenue</div>
            <div class="svalue" id="kpiNetRev">₹0</div>
          </div>
          <div class="stat-card green">
            <div class="icon-wrap">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </div>
            <div class="slabel">Gross Sales</div>
            <div class="svalue" id="kpiGross">₹0</div>
          </div>
          <div class="stat-card purple">
            <div class="icon-wrap">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            </div>
            <div class="slabel">Order Items Sold</div>
            <div class="svalue" id="kpiOrders">0</div>
          </div>
          <div class="stat-card orange">
            <div class="icon-wrap">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            </div>
            <div class="slabel">Total Discounts</div>
            <div class="svalue" id="kpiDisc">₹0</div>
          </div>
          <div class="stat-card red">
