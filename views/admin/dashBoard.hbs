    </header>

    <main class="content">
      <div class="page active">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; margin-bottom: 24px;">
            <div>
                <h2>Dashboard Analytics</h2>
                <p style="color:#64748b; font-size:0.9rem;">Track your business performance in real-time.</p>
            </div>
            
            <div class="filter-form">
                <div class="filter-group">
                    <label>Timeline:</label>
                    <select id="dateFilter" class="filter-select" onchange="toggleCustomDate()">
                        <option value="yearly">This Year</option>
                        <option value="monthly" selected>This Month</option>
