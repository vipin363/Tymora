<!-- Logout Modal -->
<div class="mo-overlay" id="logoutModal" style="display:none;">
  <div class="lo-box" style="background:#fff; border-radius:16px; width:380px; padding:28px; box-shadow:0 16px 40px rgba(0,0,0,.12); margin: 100px auto;">
    <h3 style="color:#0f172a; font-size:1rem; font-weight:700; margin-bottom:8px;">Confirm Logout</h3>
    <p style="color:#64748b; font-size:0.84rem; margin-bottom:22px;">Are you sure you want to log out of the admin panel?</p>
    <div style="display:flex; justify-content:flex-end; gap:12px;">
      <button onclick="closeLogoutModal()" style="padding:9px 20px; border-radius:8px; border:1px solid #d1d5db; background:transparent; cursor:pointer;">Cancel</button>
      <button onclick="window.location.href='/admin/logout'" style="padding:9px 20px; border-radius:8px; border:none; background:#ef4444; color:#fff; cursor:pointer; font-weight:700;">Logout</button>
    </div>
  </div>
</div>

<script>
    function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('open');
        document.getElementById('overlay').classList.toggle('open');
    }
    function openLogoutModal() { document.getElementById('logoutModal').style.display = 'block'; }
    function closeLogoutModal() { document.getElementById('logoutModal').style.display = 'none'; }
    
    function toggleCustomDate() {
        const val = document.getElementById('dateFilter').value;
        const customDiv = document.getElementById('customDateRange');
        if (val === 'custom') {
            customDiv.classList.add('active');
        } else {
            customDiv.classList.remove('active');
        }
    }

    const formatCurr = (val) => Number(val).toLocaleString('en-IN', { maximumFractionDigits: 2 });

    let trendChartInstance = null;
    let statusChartInstance = null;

    async function fetchDashboardData() {
        const loader = document.getElementById('pageLoader');
        loader.style.display = 'flex';

        const filter = document.getElementById('dateFilter').value;
        let url = `/admin/dashboard/data?dateFilter=${filter}`;

        if (filter === 'custom') {
            const start = document.getElementById('startDate').value;
            const end = document.getElementById('endDate').value;
            if (!start || !end) {
                alert("Select both start and end dates");
                loader.style.display = 'none';
                return;
            }
            url += `&startDate=${start}&endDate=${end}`;
        }

        try {
            const res = await fetch(url);
            const json = await res.json();
            
            if (json.success) {
                updateDashboard(json.data);
            }
        } catch (error) {
            console.error("Failed to fetch dashboard data:", error);
        } finally {
            loader.style.display = 'none';
        }
    }

    function updateDashboard(data) {
        // Update KPIs
        document.getElementById('kpiNetRev').innerText = `₹${formatCurr(data.metrics.netRevenue)}`;
        document.getElementById('kpiGross').innerText = `₹${formatCurr(data.metrics.grossSales)}`;
        document.getElementById('kpiOrders').innerText = data.metrics.totalOrders; // Actually Total Items
        document.getElementById('kpiDisc').innerText = `₹${formatCurr(data.metrics.totalDiscounts)}`;
        document.getElementById('kpiRefunds').innerText = `₹${formatCurr(data.metrics.refunds)}`;
        document.getElementById('kpiDelivered').innerText = data.metrics.deliveredCount;

        // Render Charts
        renderCharts(data);

        // Render Tables
        renderTable('topProductsBody', data.topProducts, p => `
            <tr>
                <td><strong>${p.productName.substring(0,25)}${p.productName.length>25?'...':''}</strong></td>
                <td>${p.quantitySold}</td>
                <td>₹${formatCurr(p.revenue)}</td>
            </tr>
        `);

        renderTable('topCategoriesBody', data.topCategories, c => `
            <tr>
                <td><strong>${c.categoryName}</strong></td>
                <td>${c.quantitySold}</td>
                <td>₹${formatCurr(c.revenue)}</td>
            </tr>
        `);

        renderTable('topBrandsBody', data.topBrands, b => `
            <tr>
                <td><strong>${b.brandName}</strong></td>
                <td>${b.quantitySold}</td>
                <td>₹${formatCurr(b.revenue)}</td>
            </tr>
        `);
    }

    function renderTable(id, dataArr, rowFn) {
        const tbody = document.getElementById(id);
        if (!dataArr || dataArr.length === 0) {
            tbody.innerHTML = `<tr><td colspan="3" style="text-align:center; padding: 20px; color:#888;">No data available</td></tr>`;
            return;
        }
        tbody.innerHTML = dataArr.map(rowFn).join('');
    }

    function renderCharts(data) {
        const rawChartData = data.chartData;
        const metrics = data.metrics;

        // 1. Trend Chart (Line for Revenue, Bar for Orders)
        const trendCtx = document.getElementById('trendChart').getContext('2d');
        const labels = rawChartData.trend.map(d => d._id);
        const revData = rawChartData.trend.map(d => d.revenue);
        const ordersData = rawChartData.trend.map(d => d.orders);

        if (trendChartInstance) trendChartInstance.destroy();

        trendChartInstance = new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        type: 'line',
                        label: 'Net Revenue (₹)',
                        data: revData,
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59,130,246,0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.3,
                        yAxisID: 'y'
                    },
                    {
                        type: 'bar',
                        label: 'Items Sold',
                        data: ordersData,
                        backgroundColor: '#dbeafe',
                        borderRadius: 4,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { position: 'top' } },
                scales: {
                    x: { grid: { display: false } },
                    y: { type: 'linear', display: true, position: 'left', grid: { color: '#f1f5f9' }, title: { display: true, text: 'Revenue' } },
                    y1: { type: 'linear', display: true, position: 'right', grid: { drawOnChartArea: false }, title: { display: true, text: 'Items Sold' } }
                }
            }
        });

        // 2. Status Chart (Pie)
        const statusCtx = document.getElementById('statusChart').getContext('2d');
        const statusLabels = ['Delivered', 'Cancelled', 'Returned'];
        const statusData = [metrics.deliveredCount, metrics.cancelledCount, metrics.returnedCount];
        
        if (statusChartInstance) statusChartInstance.destroy();

        statusChartInstance = new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusData,
                    backgroundColor: ['#22c55e', '#ef4444', '#f59e0b'],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } },
                cutout: '65%'
            }
        });
    }

    // Initial Load
    document.addEventListener("DOMContentLoaded", () => {
        fetchDashboardData();
    });
</script>
