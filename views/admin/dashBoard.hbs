</div>

<script>




    function toggleCustomDate() {
        const val = document.getElementById('dateFilter').value;
        const customDiv = document.getElementById('customDateRange');
        if (val === 'custom') {
            customDiv.classList.add('active');
        } else {
            customDiv.classList.remove('active');
        }
    }

    const formatCurr = (val) => Number(val).toLocaleString('en-IN', { maximumFractionDigits: 2 });

    let trendChartInstance = null;
    let statusChartInstance = null;

    async function fetchDashboardData() {
        const loader = document.getElementById('pageLoader');
        loader.style.display = 'flex';

        const filter = document.getElementById('dateFilter').value;
        let url = `/admin/dashboard/data?dateFilter=${filter}`;

        if (filter === 'custom') {
            const start = document.getElementById('startDate').value;
            const end = document.getElementById('endDate').value;
            if (!start || !end) {
                alert("Select both start and end dates");
                loader.style.display = 'none';
                return;
            }
            url += `&startDate=${start}&endDate=${end}`;
        }

        try {
            const res = await fetch(url);
            const json = await res.json();

            if (json.success) {
                updateDashboard(json.data);
            }
        } catch (error) {
            console.error("Failed to fetch dashboard data:", error);
        } finally {
            loader.style.display = 'none';
        }
    }

    function updateDashboard(data) {
        // Update Hero
        document.getElementById('heroTotalRevenue').innerText = `₹${formatCurr(data.metrics.totalRevenue)}`;
        document.getElementById('heroTotalOrders').innerText = data.metrics.ordersTodayCount;

        // Update KPIs
        document.getElementById('kpiTotalProducts').innerText = data.metrics.totalProducts;
        document.getElementById('kpiGross').innerText = data.metrics.netOrders;
        document.getElementById('kpiOrders').innerText = data.metrics.returnedCount;
        document.getElementById('kpiDisc').innerText = data.metrics.userCount;

        // Render Charts
        renderCharts(data);

        // Render Tables
        renderTable('topProductsBody', data.topProducts, p => `
            <tr>
                <td><strong class="truncate-text" title="${p.productName}">${p.productName}</strong></td>
                <td>${p.quantitySold}</td>
                <td>₹${formatCurr(p.revenue)}</td>
            </tr>
        `);

        renderTable('topCategoriesBody', data.topCategories, c => `
            <tr>
                <td><strong>${c.categoryName}</strong></td>
                <td>${c.quantitySold}</td>
                <td>₹${formatCurr(c.revenue)}</td>
            </tr>
        `);

        renderTable('topBrandsBody', data.topBrands, b => `
            <tr>
                <td><strong>${b.brandName}</strong></td>
                <td>${b.quantitySold}</td>
                <td>₹${formatCurr(b.revenue)}</td>
            </tr>
        `);

        // Render Recent Transactions
        const recentTbody = document.getElementById('recentTransactionsBody');
        if (!data.recentTransactions || data.recentTransactions.length === 0) {
            recentTbody.innerHTML = `<tr><td colspan="7"><div class="empty-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg><h3>No Transactions Found</h3><p>Try adjusting your date range.</p></div></td></tr>`;
        } else {
            recentTbody.innerHTML = data.recentTransactions.map((t, idx) => {
                const dateStr = moment(t.date).format('YYYY-MM-DD HH:mm');
                const amtColor = t.type === 'Credit' ? '#166534' : '#991b1b';
                const sign = t.type === 'Credit' ? '+' : '-';
                return `
                <tr>
                    <td style="color:#94a3b8; font-size:0.8rem;">${idx + 1}</td>
                    <td style="white-space:nowrap;">${dateStr}</td>
                    <td><a href="/admin/orders/${t.orderId}" style="color:#3b82f6; text-decoration:none; font-weight:600;">${t.orderId}</a></td>
                    <td>${t.customer}</td>
                    <td style="max-width:220px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${t.description}">${t.description}</td>
                    <td><span class="type-badge ${t.type.toLowerCase()}">${t.type}</span></td>
                    <td style="text-align:right; font-weight:600; color:${amtColor};">${sign}₹${formatCurr(t.amount)}</td>
                </tr>
                `;
            }).join('');
        }
    }

    function renderTable(id, dataArr, rowFn) {
        const tbody = document.getElementById(id);
        if (!dataArr || dataArr.length === 0) {
            tbody.innerHTML = `<tr><td colspan="3" style="text-align:center; padding: 20px; color:#888;">No data available</td></tr>`;
            return;
        }
        tbody.innerHTML = dataArr.map(rowFn).join('');
    }

    function renderCharts(data) {
        const rawChartData = data.chartData;
        const metrics = data.metrics;

        // 1. Trend Chart (Bar for Revenue)
        const trendCtx = document.getElementById('trendChart').getContext('2d');
        const labels = rawChartData.trend.map(d => d._id);
        const revData = rawChartData.trend.map(d => d.revenue);

        if (trendChartInstance) trendChartInstance.destroy();

        trendChartInstance = new Chart(trendCtx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Revenue (₹)',
                        data: revData,
                        backgroundColor: '#3b82f6',
                        borderRadius: 4,
                        maxBarThickness: 40
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { display: false }, tooltip: { enabled: true } },
                scales: {
                    x: { grid: { display: false } },
                    y: { type: 'linear', display: true, position: 'left', grid: { color: '#f1f5f9' }, title: { display: true, text: 'Revenue (₹)' } }
                }
            }
        });

        // 2. Status Chart (Pie)
        const statusCtx = document.getElementById('statusChart').getContext('2d');
        const statusLabels = ['Delivered', 'Cancelled', 'Returned'];
        const statusData = [metrics.deliveredCount, metrics.cancelledCount, metrics.returnedCount];

        if (statusChartInstance) statusChartInstance.destroy();

        statusChartInstance = new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusData,
                    backgroundColor: ['#22c55e', '#ef4444', '#f59e0b'],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } },
                cutout: '65%'
            }
        });
    }

    // Initial Load
    document.addEventListener("DOMContentLoaded", () => {
        fetchDashboardData();
    });
</script>