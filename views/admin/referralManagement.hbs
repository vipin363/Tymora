<link href="/adminUserManagement.css" rel="stylesheet">
<style>
.ref-stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:16px; margin-bottom:28px; }
.ref-stat  { background:var(--card-bg,#1a1a2e); border:1px solid var(--border,#2a2a3e); border-radius:12px; padding:18px 20px; }
.ref-stat .slabel { font-size:10px; letter-spacing:2px; color:var(--muted,#888); text-transform:uppercase; margin-bottom:6px; }
.ref-stat .svalue { font-size:24px; font-weight:700; color:#c9a84c; }

.ref-card { background:var(--card-bg,#1a1a2e); border:1px solid var(--border,#2a2a3e); border-radius:14px; padding:24px; margin-bottom:18px; transition:border-color .2s; }
.ref-card:hover { border-color:#c9a84c55; }
.rc-top { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; flex-wrap:wrap; }
.rc-user { font-size:13px; font-weight:700; color:#c9a84c; letter-spacing:1px; }
.rc-email { font-size:11px; color:var(--muted,#888); margin-top:2px; }
.rc-date { font-size:11px; color:var(--muted,#888); text-align:right; }

.rc-pills { display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
.pill { font-size:10px; font-weight:700; letter-spacing:1.2px; padding:4px 10px; border-radius:20px; border:1px solid; }
.pill-pending  { background:rgba(245,158,11,.12); color:#f59e0b; border-color:rgba(245,158,11,.3); }
.pill-completed { background:rgba(34,197,94,.12); color:#22c55e; border-color:rgba(34,197,94,.3); }
.pill-source   { background:rgba(59,130,246,.12); color:#3b82f6; border-color:rgba(59,130,246,.3); }

.modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.75); z-index:9000; align-items:center; justify-content:center; }
.modal-overlay.open { display:flex; }
.modal { background:#1a1a2e; border:1px solid #2a2a3e; border-radius:16px; padding:32px; max-width:440px; width:90%; }
.modal h3 { font-size:16px; font-weight:700; color:#e8e8e8; margin-bottom:8px; }
.modal p { font-size:13px; color:#888; margin-bottom:20px; }
.modal-btns { display:flex; gap:12px; margin-top:20px; justify-content:flex-end; }
.btn-cancel { background:transparent; border:1px solid #2a2a3e; color:#888; border-radius:8px; padding:9px 18px; font-size:12px; font-weight:700; letter-spacing:1px; cursor:pointer; }
.btn-confirm { border:none; border-radius:8px; padding:9px 18px; font-size:12px; font-weight:700; letter-spacing:1px; cursor:pointer; }
.btn-confirm.red   { background:#ef4444; color:#fff; }

.empty-state { text-align:center; padding:60px 20px; color:var(--muted,#888); font-size:13px; letter-spacing:2px; }
</style>

<div class="shell">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="brand">
        <div class="logo-icon">T</div>
        <div class="logo-text">
          <div class="name">Tymora</div>
          <div class="tagline">Tym of Refined Aesthetics</div>
        </div>
      </div>
    </div>
    <div class="nav-section">
      <div class="nav-label" style="margin-top:12px">Store</div>
      <a class="nav-item {{#ifEquals activePage 'dashboard'}}active{{/ifEquals}}" href="/admin/dashboard">Dashboard</a>
      <a class="nav-item {{#ifEquals activePage 'categoryManagement'}}active{{/ifEquals}}" href="/admin/categoryManagement">Category</a>
      <a class="nav-item {{#ifEquals activePage 'products'}}active{{/ifEquals}}" href="/admin/products">Products</a>
      <a class="nav-item {{#ifEquals activePage 'users'}}active{{/ifEquals}}" href="/admin/users">Users</a>
      <a class="nav-item {{#ifEquals activePage 'orders'}}active{{/ifEquals}}" href="/admin/orders">Orders</a>
      <a class="nav-item {{#ifEquals activePage 'returns'}}active{{/ifEquals}}" href="/admin/returns">Returns</a>
      <a class="nav-item {{#ifEquals activePage 'reviews'}}active{{/ifEquals}}" href="/admin/reviews">Reviews</a>
      <a class="nav-item {{#ifEquals activePage 'offers'}}active{{/ifEquals}}" href="/admin/offers">Offers</a>
      <a class="nav-item {{#ifEquals activePage 'coupons'}}active{{/ifEquals}}" href="/admin/coupons">Coupons</a>
      <a class="nav-item {{#ifEquals activePage 'reports'}}active{{/ifEquals}}" href="/admin/reports">Reports</a>
      
      <a class="nav-item {{#ifEquals activePage 'settings'}}active{{/ifEquals}}" href="/admin/settings">Settings</a>
    </div>
    <div class="nav-footer">
      <a class="nav-item logout" href="#" onclick="openLogoutModal()">Logout</a>
    </div>
  </aside>

  <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>

  <div class="main">
    <header class="topbar">
      <button class="hamburger" onclick="toggleSidebar()">☰</button>
      <span class="topbar-title">Referral Management</span>

      <form method="GET" action="/admin/referrals" class="search-bar" style="margin-left:auto; display:flex; gap:10px;">
        <input class="searchbar" type="text" name="search" placeholder="Search Email or Code…" value="{{search}}">
        <select name="status" class="sort-select">
          <option value="all" {{#ifEquals statusFilter "all"}}selected{{/ifEquals}}>All Statuses</option>
          <option value="PENDING" {{#ifEquals statusFilter "PENDING"}}selected{{/ifEquals}}>Pending</option>
          <option value="COMPLETED" {{#ifEquals statusFilter "COMPLETED"}}selected{{/ifEquals}}>Completed</option>
        </select>
        <select name="source" class="sort-select">
          <option value="all" {{#ifEquals sourceFilter "all"}}selected{{/ifEquals}}>All Sources</option>
          <option value="Code" {{#ifEquals sourceFilter "Code"}}selected{{/ifEquals}}>Code</option>
          <option value="Link" {{#ifEquals sourceFilter "Link"}}selected{{/ifEquals}}>Link</option>
        </select>
        <button type="submit" class="btn-search">Filter</button>
        {{#if search}}{{/if}}
      </form>

      <div class="admin-info">
        <div class="admin-avatar">A</div>
        <div class="admin-meta"><div class="admin-name">Admin</div></div>
      </div>
    </header>

    <main class="content">
      <div class="page-header">
        <div>
          <h2>Referral Management</h2>
          <p>Track signups, sources, and reward payouts.</p>
        </div>
      </div>

      <div class="ref-stats">
        <div class="ref-stat">
          <div class="slabel">Total Referrals</div>
          <div class="svalue">{{stats.total}}</div>
        </div>
        <div class="ref-stat">
          <div class="slabel">Pending Rewards</div>
          <div class="svalue" style="color:#f59e0b">{{stats.pending}}</div>
        </div>
        <div class="ref-stat">
          <div class="slabel">Completed Rewards</div>
          <div class="svalue" style="color:#22c55e">{{stats.completed}}</div>
        </div>
      </div>

      {{#if referrals.length}}
        {{#each referrals}}
        <div class="ref-card">
          <div class="rc-top">
            <div>
              <div class="rc-user">Referred: {{this.referredName}}</div>
              <div class="rc-email">{{this.referredEmail}}</div>
              <div class="rc-user" style="color:#888; font-weight:500; font-size:12px; margin-top:8px;">Referrer: {{this.referrerName}}</div>
            </div>
            <div class="rc-date">
              <div>Signup: {{this.signupDateFormatted}}</div>
              {{#if this.firstDeliveredOrderId}}
              <div style="margin-top:4px">Order: <a href="/admin/orders/{{this.firstDeliveredOrderId}}" style="color:#c9a84c;">#{{this.firstDeliveredOrderId}}</a></div>
              {{/if}}
              {{#ifEquals this.rewardStatus "COMPLETED"}}
              <div style="margin-top:6px; font-weight:700; font-size:13px; color:#22c55e;">Rewarded: {{this.rewardDateFormatted}}</div>
              {{/ifEquals}}
            </div>
          </div>

          <div class="rc-pills">
            {{#ifEquals this.rewardStatus "PENDING"}}<span class="pill pill-pending">Status: Pending</span>{{/ifEquals}}
            {{#ifEquals this.rewardStatus "COMPLETED"}}<span class="pill pill-completed">Status: Completed</span>{{/ifEquals}}
            
            <span class="pill pill-source">Source: {{this.referralSource}}</span>
            <span class="pill" style="border-color:#555; color:#aaa;">Code: {{this.referralCodeUsed}}</span>
            <span class="pill" style="border-color:#555; color:#aaa;">Reward Val: ₹{{formatCurrency this.totalRewardValue}}</span>
          </div>
        </div>
        {{/each}}

        <div class="pagination">
          {{#if (gt currentPage 1)}}
            <a href="/admin/referrals?page={{subtract currentPage 1}}&search={{search}}&status={{statusFilter}}&source={{sourceFilter}}">Prev</a>
          {{/if}}
          <span>Page {{currentPage}} of {{totalPages}}</span>
          {{#if (lt currentPage totalPages)}}
            <a href="/admin/referrals?page={{add currentPage 1}}&search={{search}}&status={{statusFilter}}&source={{sourceFilter}}">Next</a>
          {{/if}}
        </div>

      {{else}}
        <div class="empty-state">
          <div style="font-size:40px;margin-bottom:16px">🔗</div>
          <div>No referral records found.</div>
        </div>
      {{/if}}
    </main>
  </div>
</div>

{{!-- Logout Modal --}}
<div class="modal-overlay" id="logoutModal">
  <div class="modal">
    <h3>Confirm Logout</h3>
    <p>Are you sure you want to logout?</p>
    <div class="modal-btns">
      <button class="btn-cancel" onclick="closeLogoutModal()">Cancel</button>
      <button class="btn-confirm red" onclick="confirmLogout()">Logout</button>
    </div>
  </div>
</div>

<script>
function openLogoutModal()  { document.getElementById('logoutModal').classList.add('open'); }
function closeLogoutModal() { document.getElementById('logoutModal').classList.remove('open'); }
function confirmLogout()    { window.location.href = '/admin/logout'; }

function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('overlay').classList.toggle('open');
}
</script>
