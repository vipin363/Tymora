<link href="/adminUserManagement.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<style>
/* ── Premium Button ──────────────────────────────── */
.btn-primary {
  padding: 10px 22px; background: linear-gradient(135deg,#1e40af,#3b82f6);
  color:#fff; font-weight:600; border:none; border-radius:9px;
  cursor:pointer; display:inline-flex; align-items:center; gap:8px;
  font-size:0.88rem; transition:all 0.2s; white-space:nowrap;
  width: max-content; height: max-content;
}
.btn-primary:hover { opacity:.88; transform:translateY(-1px); box-shadow:0 4px 14px rgba(59,130,246,.35); }

/* ── Table ───────────────────────────────────────── */
.table-card { margin-top:12px; overflow-x:auto; max-width:100%; border-radius:12px; background:#fff; padding:10px 0; }
.tbl { width:100%; border-collapse:collapse; }
.tbl th {
  color:#475569; font-weight:700; font-size:0.75rem; text-transform:uppercase;
  letter-spacing:.6px; padding:14px 16px; text-align:left;
  border-bottom:1px solid #e2e8f0; white-space:nowrap;
}
.tbl td { padding:14px 16px; vertical-align:middle; border-bottom:1px solid #f1f5f9; }
.tbl tbody tr:hover { background:#f8fafc; }

/* offer code pill */
.code-pill {
  font-family:monospace; font-size:0.92rem; font-weight:700; letter-spacing:1.5px;
  color:#b45309; background:#fef3c7; border:1px solid #fde68a;
  border-radius:6px; padding:4px 10px; display:inline-block;
}

/* ── Status Badges ───────────────────────────────── */
.badge {
  display:inline-flex; align-items:center; gap:5px;
  padding:4px 11px; border-radius:20px; font-size:0.73rem; font-weight:600;
}
.badge::before { content:''; width:6px; height:6px; border-radius:50%; display:inline-block; }
.badge.active   { background:rgba(34,197,94,.12);  color:#22c55e; border:1px solid rgba(34,197,94,.3);  }
.badge.active::before   { background:#22c55e; }
.badge.scheduled{ background:rgba(59,130,246,.12); color:#3b82f6; border:1px solid rgba(59,130,246,.3); }
.badge.scheduled::before{ background:#3b82f6; }
.badge.expired  { background:rgba(239,68,68,.12);  color:#ef4444; border:1px solid rgba(239,68,68,.3);  }
.badge.expired::before  { background:#ef4444; }
.badge.disabled { background:rgba(107,114,128,.12);color:#9ca3af; border:1px solid rgba(107,114,128,.3);}
.badge.disabled::before { background:#9ca3af; }

.type-pill {
  background:#f1f5f9; color:#475569; border:1px solid #e2e8f0;
  padding:4px 10px; border-radius:6px; font-size:0.7rem; text-transform:capitalize; font-weight:600;
}

/* ── Action Buttons ──────────────────────────────── */
.act-btn {
  background:#fff; border:1px solid #e2e8f0;
  border-radius:6px; padding:6px 12px; cursor:pointer; color:#475569; font-weight:600; font-size:0.75rem;
  transition:all .2s; display:inline-flex; align-items:center; justify-content:center; gap:6px; width:100%;
}
.act-btn:hover      { background:#f8fafc; }
.act-btn.edit:hover { background:#eff6ff; border-color:#bfdbfe; color:#2563eb; }
.act-btn.del:hover  { background:#fef2f2; border-color:#fecaca; color:#dc2626; }

/* ── Toggle ──────────────────────────────────────── */
.tog { position:relative; width:36px; height:18px; display:inline-block; vertical-align:middle; }
.tog input { opacity:0; width:0; height:0; }
.tog-sl { position:absolute; cursor:pointer; inset:0; background:#374151; border-radius:18px; transition:.25s; }
.tog-sl::before { content:""; position:absolute; width:12px; height:12px; left:3px; bottom:3px; background:#fff; border-radius:50%; transition:.25s; }
.tog input:checked + .tog-sl { background:#22c55e; }
.tog input:checked + .tog-sl::before { transform:translateX(18px); }

/* ── Empty State ─────────────────────────────────── */
.empty-box { text-align:center; padding:64px 20px; }
.empty-box svg { width:56px; height:56px; stroke:rgba(255,255,255,.2); margin-bottom:16px; display:block; margin-left:auto; margin-right:auto; }
.empty-box h3 { font-size:1.05rem; color:#888; margin-bottom:8px; }
.empty-box p  { color:#555; font-size:0.82rem; }

/* ─────────────────────────────────────────────────
   MODAL
───────────────────────────────────────────────── */
.mo-overlay {
  position:fixed; inset:0; background:rgba(0,0,0,.6); z-index:9999;
  display:flex; align-items:center; justify-content:center;
  opacity:0; pointer-events:none; transition:opacity .25s;
}
.mo-overlay.open { opacity:1; pointer-events:all; }

.mo-box {
  background:#fff; border-radius:18px; width:900px; max-width:96vw; max-height:92vh;
  display:flex; flex-direction:column; overflow:hidden;
  box-shadow:0 20px 60px rgba(0,0,0,.3);
  transform:translateY(22px) scale(.98); transition:transform .3s;
}
.mo-overlay.open .mo-box { transform:translateY(0) scale(1); }

.mo-head {
  padding:20px 28px; background:#f8fafc;
  border-bottom:1px solid #e2e8f0;
  display:flex; justify-content:space-between; align-items:center; flex-shrink:0;
}
.mo-head h3 { color:#0f172a; font-size:1.1rem; font-weight:700; margin:0; }
.mo-close { background:transparent; border:none; font-size:1.5rem; color:#94a3b8; cursor:pointer; line-height:1; padding:0 4px; }
.mo-close:hover { color:#334155; }

.mo-body { padding:28px; overflow-y:auto; flex:1; }

.mo-foot {
  padding:18px 28px; background:#f8fafc;
  border-top:1px solid #e2e8f0;
  display:flex; justify-content:flex-end; gap:12px; flex-shrink:0;
}

/* ── Section titles inside modal ─────────────────── */
.sec-title {
  font-size:0.78rem; font-weight:700; color:#3b82f6; text-transform:uppercase;
  letter-spacing:.8px; margin:24px 0 14px; padding-bottom:8px;
  border-bottom:1px solid #e2e8f0; display:flex; align-items:center; gap:7px;
}
.sec-title:first-child { margin-top:0; }
.sec-title svg { width:14px; height:14px; stroke:#3b82f6; flex-shrink:0; }

/* ── Form grid ───────────────────────────────────── */
.fg { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
.fg.three { grid-template-columns:1fr 1fr 1fr; }
.fg.one   { grid-template-columns:1fr; }
.full { grid-column:1/-1; }

.flabel { display:block; font-size:0.78rem; color:#475569; font-weight:600; margin-bottom:5px; }
.flabel span { color:#ef4444; }
.finput {
  width:100%; padding:10px 13px; background:#fff; border:1px solid #d1d5db;
  border-radius:8px; color:#1e293b; font-size:0.84rem; font-family:inherit;
  transition:border-color .2s; box-sizing:border-box;
}
.finput:focus { outline:none; border-color:#3b82f6; box-shadow:0 0 0 3px rgba(59,130,246,.1); }
.finput::placeholder { color:#9ca3af; }
textarea.finput { resize:vertical; min-height:72px; }

/* code field wrapper */
.code-wrap { position:relative; }
.gen-btn {
  position:absolute; right:8px; top:50%; transform:translateY(-50%);
  padding:4px 10px; background:#e2e8f0; border:none; border-radius:6px;
  font-size:0.72rem; font-weight:700; color:#334155; cursor:pointer; transition:background .15s;
}
.gen-btn:hover { background:#cbd5e1; }

/* toggle rows in modal */
.tog-row { display:flex; align-items:center; gap:10px; padding:10px 0; }
.tog-row .flabel { margin:0; font-size:0.82rem; }

/* Select2 white theme */
.select2-container--default .select2-selection--multiple {
  background:#fff; border:1px solid #d1d5db; border-radius:8px; padding:3px; min-height:42px;
}
.select2-container--default.select2-container--focus .select2-selection--multiple { border-color:#3b82f6; }
.select2-container--default .select2-selection--multiple .select2-selection__choice {
  background:#eff6ff; border:1px solid #bfdbfe; color:#1d4ed8; border-radius:6px; padding:2px 8px; margin-top:4px;
}
.select2-container--default .select2-selection--multiple .select2-selection__choice__remove { color:#1d4ed8; margin-right:5px; border:none; }
.select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover { color:#ef4444; background:transparent; }
.select2-dropdown { background:#fff; border:1px solid #d1d5db; color:#1e293b; border-radius:8px; box-shadow:0 8px 24px rgba(0,0,0,.1); }
.select2-container--default .select2-results__option--highlighted[aria-selected] { background:#eff6ff; color:#1d4ed8; }
.select2-container--default .select2-search--dropdown .select2-search__field { border:1px solid #d1d5db; border-radius:6px; padding:6px 10px; font-family:inherit; }

/* payment checkboxes */
.pay-grid { display:flex; flex-wrap:wrap; gap:10px; }
.pay-check { display:flex; align-items:center; gap:6px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:8px 14px; cursor:pointer; transition:all .2s; }
.pay-check:hover { border-color:#3b82f6; }
.pay-check input[type=checkbox]:checked ~ span { color:#1d4ed8; font-weight:600; }
.pay-check span { font-size:0.8rem; color:#334155; }

/* ── Delete modal ────────────────────────────────── */
.del-box {
  background:#fff; border-radius:16px; width:440px; max-width:95vw; padding:32px;
  box-shadow:0 16px 48px rgba(0,0,0,.15);
}
.del-box h3 { color:#ef4444; font-size:1.1rem; font-weight:700; margin-bottom:10px; }
.del-box p  { color:#64748b; font-size:0.85rem; line-height:1.65; margin-bottom:24px; }
.del-btns { display:flex; justify-content:flex-end; gap:12px; }
.btn-cancel { padding:9px 20px; border-radius:8px; border:1px solid #d1d5db; background:transparent; color:#334155; cursor:pointer; font-size:0.83rem; font-weight:500; transition:all .2s; width: max-content; height: max-content; }
.btn-cancel:hover { background:#f1f5f9; }
.btn-danger { padding:9px 20px; border-radius:8px; border:none; background:linear-gradient(135deg,#ef4444,#dc2626); color:#fff; cursor:pointer; font-size:0.83rem; font-weight:700; transition:opacity .2s; }
.btn-danger:hover { opacity:.88; }

/* ── Logout modal (re-use) ───────────────────────── */
.lo-box {
  background:#fff; border-radius:16px; width:380px; max-width:95vw; padding:28px;
  box-shadow:0 16px 40px rgba(0,0,0,.12);
}
.lo-box h3 { color:#0f172a; font-size:1rem; font-weight:700; margin-bottom:8px; }
.lo-box p  { color:#64748b; font-size:0.84rem; margin-bottom:22px; }
</style>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- SHELL                                                       -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div class="shell">

  <!-- SIDEBAR -->
  {{> admin/sidebar}}

  <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>

  <div class="main">
    <!-- TOPBAR -->
    <header class="topbar">
      <button class="hamburger" onclick="toggleSidebar()" aria-label="Menu">
        <svg viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>

      <!-- Search & Filters -->
      <form method="GET" action="/admin/offers" class="search-bar">
        <input type="text" name="search" class="searchbar" value="{{search}}" placeholder="Search offer code or title…">

        <select name="status" class="sort-select" onchange="this.form.submit()">
          <option value="all"       {{#ifEquals filterStatus "all"}}selected{{/ifEquals}}>All Status</option>
          <option value="active"    {{#ifEquals filterStatus "active"}}selected{{/ifEquals}}>Active</option>
          <option value="scheduled" {{#ifEquals filterStatus "scheduled"}}selected{{/ifEquals}}>Scheduled</option>
          <option value="expired"   {{#ifEquals filterStatus "expired"}}selected{{/ifEquals}}>Expired</option>
          <option value="disabled"  {{#ifEquals filterStatus "disabled"}}selected{{/ifEquals}}>Disabled</option>
        </select>

        <select name="discountType" class="sort-select" onchange="this.form.submit()">
          <option value="all"        {{#ifEquals filterDiscountType "all"}}selected{{/ifEquals}}>All Types</option>
          <option value="percentage" {{#ifEquals filterDiscountType "percentage"}}selected{{/ifEquals}}>Percentage</option>
          <option value="fixed"      {{#ifEquals filterDiscountType "fixed"}}selected{{/ifEquals}}>Fixed Amount</option>
        </select>

        <select name="sort" class="sort-select" onchange="this.form.submit()">
          <option value="latest"   {{#ifEquals sort "latest"}}selected{{/ifEquals}}>Latest</option>
          <option value="oldest"   {{#ifEquals sort "oldest"}}selected{{/ifEquals}}>Oldest</option>
          <option value="discount" {{#ifEquals sort "discount"}}selected{{/ifEquals}}>Highest Discount</option>
          <option value="used"     {{#ifEquals sort "used"}}selected{{/ifEquals}}>Most Used</option>
          <option value="expiring" {{#ifEquals sort "expiring"}}selected{{/ifEquals}}>Expiring Soon</option>
        </select>

        <button type="submit" class="btn-search">Apply</button>
        {{#if search}}<a href="/admin/offers" class="btn-clear">Clear</a>{{/if}}
      </form>

      <div class="admin-info">
        <div class="admin-avatar">A</div>
        <div class="admin-meta"><div class="admin-name">Admin</div></div>
      </div>
    </header>

    <!-- CONTENT -->
    <main class="content">
      <div class="page active">

        <!-- Page Header -->
        <div class="page-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;">
          <div>
            <h2>Offer Management</h2>
            <p>Create and distribute promotional offers to drive sales.</p>
          </div>
          <button class="btn-primary" onclick="openCreateModal()">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>Create Offer
          </button>
        </div>

        <!-- ── Analytics Cards ───────────────────────────── -->
        <div class="stats-grid" style="grid-template-columns:repeat(auto-fit,minmax(140px,1fr));margin-bottom:24px;">
          <div class="stat-card">
            <div class="slabel">Total Offers</div>
            <div class="svalue">{{stats.total}}</div>
          </div>
          <div class="stat-card">
            <div class="slabel">Active</div>
            <div class="svalue" style="color:#22c55e">{{stats.active}}</div>
          </div>
          <div class="stat-card">
            <div class="slabel">Scheduled</div>
            <div class="svalue" style="color:#3b82f6">{{stats.scheduled}}</div>
          </div>
          <div class="stat-card">
            <div class="slabel">Expired</div>
            <div class="svalue" style="color:#ef4444">{{stats.expired}}</div>
          </div>
          <div class="stat-card">
            <div class="slabel">Disabled</div>
            <div class="svalue" style="color:#9ca3af">{{stats.disabled}}</div>
          </div>
          <div class="stat-card">
            <div class="slabel">Total Usage</div>
            <div class="svalue" style="color:#c9a84c">{{stats.totalUsage}}</div>
          </div>
        </div>

        <!-- ── Table ─────────────────────────────────────── -->
        <div class="table-card">
          {{#if offers.length}}
          <table class="tbl">
            <thead>
                <th>Offer Name</th>
                <th>Details</th>
                <th>Discount</th>
                <th>Target</th>
                <th>Usage</th>
                <th>Validity</th>
                <th>Status</th>
                <th>Active</th>
                <th style="text-align:right">Actions</th>
              </tr>
            </thead>
            <tbody>
              {{#each offers}}
              <tr id="row-{{this._id}}">
                <td>
                  <div style="font-weight:700;color:#1e293b;font-size:0.9rem;">{{this.name}}</div>
                  {{#if this.offerBadgeText}}
                    <span class="code-pill" style="margin-top:4px; font-size: 0.7rem;">{{this.offerBadgeText}}</span>
                  {{/if}}
                </td>
                <td>
                  {{#if this.description}}
                  <div style="font-size:0.78rem;color:#64748b;max-width:180px;white-space:normal;" title="{{this.description}}">{{this.description}}</div>
                  {{else}}<span style="color:#aaa;">—</span>{{/if}}
                </td>
                <td>
                  <div style="font-weight:700;color:#b45309;font-size:0.95rem;">
                    {{#ifEquals this.discountType "percentage"}}{{this.discountValue}}% OFF{{else}}₹{{this.discountValue}} OFF{{/ifEquals}}
                  </div>
                  {{#if this.minPurchase}}<div style="font-size:0.75rem;color:#64748b;margin-top:2px;">Min ₹{{this.minPurchase}}</div>{{/if}}
                  {{#if this.maxDiscountLimit}}<div style="font-size:0.75rem;color:#64748b;margin-top:2px;">Max ₹{{this.maxDiscountLimit}}</div>{{/if}}
                </td>
                <td>
                  <span class="type-pill">{{this.offerType}}</span>
                  {{#ifEquals this.offerType "global"}}{{else}}
                  <div style="font-size:0.75rem;color:#64748b;margin-top:6px;max-width:160px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="{{this.targetsStr}}">{{this.targetsStr}}</div>
                  {{/ifEquals}}
                </td>
                <td>
                  <div style="font-size:0.85rem;color:#1e293b;font-weight:600;">{{this.usedCount}}
                    {{#if this.usageLimit}}<span style="color:#64748b;font-weight:400;font-size:0.75rem;">/ {{this.usageLimit}}</span>{{/if}}
                  </div>
                </td>
                <td>
                  <div style="font-size:0.78rem;color:#475569;font-weight:500;">{{this.startDateFormatted}}</div>
                  <div style="font-size:0.75rem;color:#64748b;margin-top:2px;">→ {{this.endDateFormatted}}</div>
                </td>
                <td><span class="badge {{toLowerCase this.status}}">{{this.status}}</span></td>
                <td>
                  <label class="tog">
                    <input type="checkbox" {{#if this.isActive}}checked{{/if}} onchange="toggleStatus('{{this._id}}',this)">
                    <span class="tog-sl"></span>
                  </label>
                </td>
                <td style="width:120px;">
                  <div style="display:flex;flex-direction:column;gap:8px;">
                    <button class="act-btn edit" title="Edit" onclick='openEditModal({{{json this}}})'>
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                      </svg> Edit
                    </button>
                    <button class="act-btn del" title="Delete" onclick="confirmDelete('{{this._id}}','{{this.name}}')">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                        <path d="M10 11v6M14 11v6"/>
                      </svg> Delete
                    </button>
                  </div>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>

          <!-- Pagination -->
          <div class="pagination">
            {{#if (gt currentPage 1)}}
            <a href="/admin/offers?page={{subtract currentPage 1}}&search={{search}}&status={{filterStatus}}&discountType={{filterDiscountType}}&sort={{sort}}">← Prev</a>
            {{/if}}
            <span>Page {{currentPage}} of {{totalPages}}</span>
            {{#if (lt currentPage totalPages)}}
            <a href="/admin/offers?page={{add currentPage 1}}&search={{search}}&status={{filterStatus}}&discountType={{filterDiscountType}}&sort={{sort}}">Next →</a>
            {{/if}}
          </div>

          {{else}}
          <div class="empty-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
              <rect x="3" y="8" width="18" height="12" rx="2"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <path d="M8 8V6a2 2 0 012-2h4a2 2 0 012 2v2"/>
            </svg>
            <h3>No Offers Found</h3>
            <p>Try adjusting your filters or create a new offer.</p>

          </div>
          {{/if}}
        </div>

      </div>
    </main>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- CREATE / EDIT OFFER MODAL                                  -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div class="mo-overlay" id="offerModal">
  <div class="mo-box">
    <div class="mo-head">
      <h3 id="modalTitle">✨ Create New Offer</h3>
      <button class="mo-close" onclick="closeOfferModal()">×</button>
    </div>

    <div class="mo-body">
      <form id="offerForm" autocomplete="off">
        <input type="hidden" id="offerId">

        <!-- ── A) Basic ───────────────────────────────── -->
        <div class="sec-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M12 8v8"/></svg>
          A) Basic Information
        </div>
        <div class="fg">
          <div class="form-group">
            <label class="flabel">Offer Name <span>*</span></label>
            <input class="finput" id="name" name="name" required placeholder="e.g. Summer Flash Sale">
          </div>
          <div class="form-group">
            <label class="flabel">Offer Badge Text <span style="color:#94a3b8;font-weight:400">(optional)</span></label>
            <input class="finput" id="offerBadgeText" name="offerBadgeText" placeholder="e.g. 50% OFF">
          </div>
          <div class="form-group full">
            <label class="flabel">Description</label>
            <textarea class="finput" id="description" name="description" rows="2" placeholder="Internal notes or customer-facing description…"></textarea>
          </div>
        </div>

        <!-- ── B) Discount ────────────────────────────── -->
        <div class="sec-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
          B) Discount Configuration
        </div>
        <div class="fg">
          <div class="form-group">
            <label class="flabel">Discount Type <span>*</span></label>
            <select class="finput" id="discountType" name="discountType" required onchange="onDiscountTypeChange()">
              <option value="percentage">Percentage (%)</option>
              <option value="fixed">Fixed Amount (₹)</option>
            </select>
          </div>
          <div class="form-group">
            <label class="flabel">Discount Value <span>*</span></label>
            <input class="finput" type="number" id="discountValue" name="discountValue" required min="1" placeholder="e.g. 20">
          </div>
          <div class="form-group" id="maxDiscContainer">
            <label class="flabel">Max Discount Cap (₹) <span style="color:#94a3b8;font-weight:400">(optional)</span></label>
            <input class="finput" type="number" id="maxDiscountLimit" name="maxDiscountLimit" min="1" placeholder="e.g. 500">
          </div>
          <div class="form-group">
            <label class="flabel">Minimum Order Value (₹)</label>
            <input class="finput" type="number" id="minPurchase" name="minPurchase" min="0" value="0">
          </div>
        </div>

        <!-- ── C) Applicability ───────────────────────── -->
        <div class="sec-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 000-7.78z"/></svg>
          C) Applicability
        </div>
        <div class="fg">
          <div class="form-group">
            <label class="flabel">Applies To <span>*</span></label>
            <select class="finput" id="offerType" name="offerType" required onchange="onOfferTypeChange()">
              <option value="global">All Products (Global)</option>
              <option value="product">Specific Products</option>
              <option value="category">Specific Categories</option>
              <option value="brand">Specific Brands</option>
            </select>
          </div>
          <div class="form-group" id="targetContainer" style="display:none;">
            <label class="flabel" id="targetLabel">Select Targets <span>*</span></label>
            <select id="targetSelect" multiple="multiple" style="width:100%;"></select>
          </div>
        </div>

        <!-- Excluded Targets -->
        <div class="fg" style="margin-top:4px;">
          <div class="form-group">
            <label class="flabel">Exclude Products <span style="color:#94a3b8;font-weight:400">(optional)</span></label>
            <select id="excludedProducts" multiple="multiple" style="width:100%;"></select>
          </div>
          <div class="form-group">
            <label class="flabel">Exclude Categories <span style="color:#94a3b8;font-weight:400">(optional)</span></label>
            <select id="excludedCategories" multiple="multiple" style="width:100%;"></select>
          </div>
        </div>

        <!-- ── D) User Restrictions ───────────────────── -->
        <div class="sec-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          D) User Restrictions
        </div>
        <div class="fg">
          <div class="form-group">
            <label class="flabel">Global Usage Limit <span style="color:#94a3b8;font-weight:400">(0 = unlimited)</span></label>
            <input class="finput" type="number" id="usageLimit" name="usageLimit" min="0" value="0">
          </div>
          <div class="form-group">
            <label class="flabel">Per User Limit</label>
            <input class="finput" type="number" id="perUserLimit" name="perUserLimit" min="1" value="1">
          </div>
          <div class="form-group full">
            <div class="tog-row">
              <label class="tog"><input type="checkbox" id="isFirstTimeUserOnly"><span class="tog-sl"></span></label>
              <label class="flabel" for="isFirstTimeUserOnly">First-time users only</label>
            </div>
          </div>
        </div>

        <!-- ── E) Payment Methods ─────────────────────── -->
        <div class="sec-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          E) Payment Method Restrictions
        </div>
        <div class="pay-grid">
          <label class="pay-check"><input type="checkbox" name="paymentMethods" value="All" id="pm-all" onchange="onPayAll(this)"><span>All Methods</span></label>
          <label class="pay-check"><input type="checkbox" name="paymentMethods" value="COD"    id="pm-cod">   <span>COD</span></label>
          <label class="pay-check"><input type="checkbox" name="paymentMethods" value="Wallet" id="pm-wal">   <span>Wallet</span></label>
          <label class="pay-check"><input type="checkbox" name="paymentMethods" value="Online" id="pm-onl">   <span>Online</span></label>
          <label class="pay-check" style="display:none;"><input type="checkbox" name="paymentMethods" value="UPI"    id="pm-upi">   <span>UPI / Card</span></label>
        </div>

        <!-- ── F) Validity ────────────────────────────── -->
        <div class="sec-title" style="margin-top:22px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          F) Validity / Dates
        </div>
        <div class="fg">
          <div class="form-group">
            <label class="flabel">Start Date <span>*</span></label>
            <input class="finput" type="date" id="startDate" name="startDate" required>
          </div>
          <div class="form-group">
            <label class="flabel">Expiry Date <span>*</span></label>
            <input class="finput" type="date" id="endDate" name="endDate" required>
          </div>
        </div>

        <!-- ── G) Advanced ────────────────────────────── -->
        <div class="sec-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
          G) Advanced Options
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px 20px;">
          <div class="tog-row" style="display:none;"><label class="tog"><input type="checkbox" id="isFreeShipping"><span class="tog-sl"></span></label><label class="flabel" for="isFreeShipping">Includes Free Shipping</label></div>
          <div class="tog-row" style="display:none;"><label class="tog"><input type="checkbox" id="isStackable"><span class="tog-sl"></span></label><label class="flabel" for="isStackable">Stackable with other offers</label></div>
          <div class="tog-row" style="display:none;"><label class="tog"><input type="checkbox" id="autoApply"><span class="tog-sl"></span></label><label class="flabel" for="autoApply">Auto-Apply at Checkout</label></div>
          <div class="tog-row"><label class="tog"><input type="checkbox" id="isActive" checked><span class="tog-sl"></span></label><label class="flabel" for="isActive">Active (enable offer)</label></div>
        </div>
        <div class="fg" style="margin-top:14px; display:none;">
          <div class="form-group">
            <label class="flabel">Priority Level <span style="color:#94a3b8;font-weight:400">(higher = preferred)</span></label>
            <input class="finput" type="number" id="priority" name="priority" min="0" value="0">
          </div>
        </div>

      </form>
    </div><!-- end mo-body -->

    <div class="mo-foot">
      <button type="button" class="btn-cancel" onclick="closeOfferModal()">Cancel</button>
      <button type="button" class="btn-primary" onclick="saveOffer()">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Save Offer
      </button>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- DELETE MODAL                                               -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div class="mo-overlay" id="deleteModal">
  <div class="del-box">
    <h3>⚠️ Delete Offer</h3>
    <p>You are about to permanently delete offer <strong id="delCode" style="color:#ef4444;font-family:monospace;"></strong>. This action cannot be undone and the offer will immediately stop working for all users.</p>
    <div class="del-btns">
      <button class="btn-cancel" onclick="closeDeleteModal()">Cancel</button>
      <button class="btn-danger" onclick="executeDelete()">Delete Permanently</button>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->

</div>

<div class="toast-wrap" id="toastWrap"></div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- DATA PASSED FROM CONTROLLER                                 -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
const ALL_PRODUCTS   = {{{json products}}};
const ALL_CATEGORIES = {{{json categories}}};
const ALL_BRANDS     = {{{json brands}}};
</script>

<script>
// ── Select2 Setup ─────────────────────────────────────────────
$(document).ready(function () {
  const s2opts = (placeholder, parent) => ({
    placeholder, allowClear: true, width: '100%',
    dropdownParent: parent ? $(parent) : undefined
  });

  $('#targetSelect').select2(s2opts('Search and select…', '#offerModal'));
  $('#excludedProducts').select2(s2opts('Exclude products…', '#offerModal'));
  $('#excludedCategories').select2(s2opts('Exclude categories…', '#offerModal'));
});

// ── Sidebar / Nav ─────────────────────────────────────────────





// ── Discount Type Change ──────────────────────────────────────
function onDiscountTypeChange() {
  const t = document.getElementById('discountType').value;
  const maxC = document.getElementById('maxDiscContainer');
  const dv   = document.getElementById('discountValue');
  if (t === 'percentage') {
    maxC.style.display = '';
    dv.setAttribute('max', '100');
    dv.placeholder = 'e.g. 20 (max 100)';
  } else {
    maxC.style.display = 'none';
    document.getElementById('maxDiscountLimit').value = '';
    dv.removeAttribute('max');
    dv.placeholder = 'e.g. 150';
  }
}

// ── Offer Type Change (target selector) ──────────────────────
function onOfferTypeChange() {
  const type = document.getElementById('offerType').value;
  const container = document.getElementById('targetContainer');
  const sel = $('#targetSelect');
  sel.empty();

  if (type === 'global') {
    container.style.display = 'none';
    sel.prop('required', false);
    return;
  }

  container.style.display = '';
  sel.prop('required', true);

  const labelMap = { product: 'Select Products', category: 'Select Categories', brand: 'Select Brands' };
  document.getElementById('targetLabel').innerHTML = `${labelMap[type] || 'Select Targets'} <span style="color:#ef4444">*</span>`;

  let data = [], key = 'name';
  if (type === 'product')  { data = ALL_PRODUCTS;   key = 'name'; }
  if (type === 'category') { data = ALL_CATEGORIES; key = 'name'; }
  if (type === 'brand')    { data = ALL_BRANDS;     key = 'name'; }

  data.forEach(item => sel.append(new Option(item[key] || item.name || '—', item._id, false, false)));
  sel.trigger('change');
}

// ── Payment All toggle ────────────────────────────────────────
function onPayAll(cb) {
  const others = document.querySelectorAll('input[name="paymentMethods"]:not(#pm-all)');
  others.forEach(o => { o.checked = false; o.disabled = cb.checked; });
}

// ── Populate excluded dropdowns ───────────────────────────────
function populateExcluded() {
  const ep = $('#excludedProducts');
  const ec = $('#excludedCategories');
  ep.empty(); ec.empty();
  ALL_PRODUCTS  .forEach(p => ep.append(new Option(p.name || '—', p._id, false, false)));
  ALL_CATEGORIES.forEach(c => ec.append(new Option(c.name || '—', c._id, false, false)));
  ep.trigger('change'); ec.trigger('change');
}

// ── Open Create Modal ─────────────────────────────────────────
function openCreateModal() {
  document.getElementById('offerForm').reset();
  document.getElementById('offerId').value = '';
  document.getElementById('modalTitle').textContent = '✨ Create New Offer';

  const today = new Date().toISOString().split('T')[0];
  document.getElementById('startDate').value = today;
  document.getElementById('endDate').value   = today;
  document.getElementById('isActive').checked = true;
  document.getElementById('pm-all').checked   = true;
  onPayAll(document.getElementById('pm-all'));

  $('#targetSelect').val(null).trigger('change');
  onOfferTypeChange();
  onDiscountTypeChange();
  populateExcluded();
  $('#excludedProducts').val(null).trigger('change');
  $('#excludedCategories').val(null).trigger('change');

  document.getElementById('offerModal').classList.add('open');
}

// ── Open Edit Modal ───────────────────────────────────────────
function openEditModal(c) {
  document.getElementById('offerId').value      = c._id;
  document.getElementById('modalTitle').textContent = '✏️ Edit Offer';
  document.getElementById('name').value          = c.name || '';
  document.getElementById('offerBadgeText').value = c.offerBadgeText || '';
  document.getElementById('description').value   = c.description || '';
  document.getElementById('discountType').value  = c.discountType;
  onDiscountTypeChange();
  document.getElementById('discountValue').value    = c.discountValue;
  document.getElementById('maxDiscountLimit').value = c.maxDiscountLimit || '';
  document.getElementById('minPurchase').value      = c.minPurchase || 0;
  document.getElementById('usageLimit').value       = c.usageLimit || 0;
  document.getElementById('perUserLimit').value     = c.perUserLimit || 1;
  document.getElementById('priority').value         = c.priority || 0;
  document.getElementById('startDate').value        = c.startDateFormatted || '';
  document.getElementById('endDate').value          = c.endDateFormatted   || '';
  document.getElementById('isFirstTimeUserOnly').checked = !!c.isFirstTimeUserOnly;
  document.getElementById('isFreeShipping').checked      = !!c.isFreeShipping;
  document.getElementById('isStackable').checked         = !!c.isStackable;
  document.getElementById('autoApply').checked           = !!c.autoApply;
  document.getElementById('isActive').checked            = !!c.isActive;

  // Payment methods
  ['COD','Wallet','Online','UPI','All'].forEach(m => {
    const el = document.getElementById('pm-' + m.toLowerCase());
    if (el) el.checked = (c.paymentMethods || ['All']).includes(m);
  });
  const allChecked = document.getElementById('pm-all').checked;
  document.querySelectorAll('input[name="paymentMethods"]:not(#pm-all)').forEach(o => o.disabled = allChecked);

  // Offer type & targets
  document.getElementById('offerType').value = c.offerType || 'global';
  onOfferTypeChange();
  populateExcluded();

  setTimeout(() => {
    if (c.offerType === 'product')  {
      const ids = (c.applicableProducts  || []).map(p => p._id || p);
      $('#targetSelect').val(ids).trigger('change');
    }
    if (c.offerType === 'category') {
      const ids = (c.applicableCategories || []).map(x => x._id || x);
      $('#targetSelect').val(ids).trigger('change');
    }
    if (c.offerType === 'brand') {
      const ids = (c.applicableBrands || []).map(x => x._id || x);
      $('#targetSelect').val(ids).trigger('change');
    }
    const ep = (c.excludedProducts   || []).map(x => x._id || x);
    const ec = (c.excludedCategories || []).map(x => x._id || x);
    $('#excludedProducts').val(ep).trigger('change');
    $('#excludedCategories').val(ec).trigger('change');
  }, 60);

  document.getElementById('offerModal').classList.add('open');
}

function closeOfferModal() {
  document.getElementById('offerModal').classList.remove('open');
}

// ── Save (create or update) ───────────────────────────────────
async function saveOffer() {
  const form = document.getElementById('offerForm');
  if (!form.checkValidity()) { form.reportValidity(); return; }

  const id   = document.getElementById('offerId').value;
  const type = document.getElementById('offerType').value;

  // Collect payment methods
  const pmChecked = [...document.querySelectorAll('input[name="paymentMethods"]:checked')].map(x => x.value);
  const paymentMethods = pmChecked.length ? pmChecked : ['All'];

  const body = {
    name:         document.getElementById('name').value.trim(),
    offerBadgeText: document.getElementById('offerBadgeText').value.trim(),
    description:  document.getElementById('description').value.trim(),
    discountType: document.getElementById('discountType').value,
    discountValue: Number(document.getElementById('discountValue').value),
    maxDiscountLimit: document.getElementById('maxDiscountLimit').value || null,
    minPurchaseAmount: Number(document.getElementById('minPurchase').value),
    offerType:    type,
    usageLimit:   Number(document.getElementById('usageLimit').value),
    perUserLimit: Number(document.getElementById('perUserLimit').value),
    priority:     Number(document.getElementById('priority').value),
    startDate:    document.getElementById('startDate').value,
    endDate:      document.getElementById('endDate').value,
    isFirstTimeUserOnly: document.getElementById('isFirstTimeUserOnly').checked,
    isFreeShipping:      document.getElementById('isFreeShipping').checked,
    isStackable:         document.getElementById('isStackable').checked,
    autoApply:           document.getElementById('autoApply').checked,
    isActive:            document.getElementById('isActive').checked,
    paymentMethods,
  };

  // Target arrays
  if (type === 'product')  body.applicableProducts   = $('#targetSelect').val() || [];
  if (type === 'category') body.applicableCategories = $('#targetSelect').val() || [];
  if (type === 'brand')    body.applicableBrands     = $('#targetSelect').val() || [];
  body.excludedProducts   = $('#excludedProducts').val()   || [];
  body.excludedCategories = $('#excludedCategories').val() || [];

  // Client-side guard
  if (!body.name) { showToast('Offer name is required', 'red'); return; }
  if (body.discountType === 'percentage' && body.discountValue > 100) { showToast('Percentage cannot exceed 100%', 'red'); return; }
  if (new Date(body.startDate) >= new Date(body.endDate)) { showToast('Expiry date must be after start date', 'red'); return; }
  if (type !== 'global' && (($('#targetSelect').val() || []).length === 0)) { showToast('Please select at least one target', 'red'); return; }

  const url    = id ? `/admin/offers/${id}` : '/admin/offers';
  const method = id ? 'PUT' : 'POST';

  try {
    const res    = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const result = await res.json();
    if (result.success) {
      showToast(result.message, 'green');
      closeOfferModal();
      setTimeout(() => window.location.reload(), 800);
    } else {
      showToast(result.message || 'Failed to save', 'red');
    }
  } catch { showToast('Network error', 'red'); }
}

// ── Toggle Status ─────────────────────────────────────────────
async function toggleStatus(id, cb) {
  try {
    const res  = await fetch(`/admin/offers/${id}/status`, { method: 'PATCH' });
    const data = await res.json();
    if (data.success) {
      showToast(data.message, 'green');
      setTimeout(() => window.location.reload(), 400);
    } else {
      showToast(data.message || 'Failed', 'red');
      cb.checked = !cb.checked;
    }
  } catch { showToast('Network error', 'red'); cb.checked = !cb.checked; }
}

// ── Delete ────────────────────────────────────────────────────
let _delId = null;
function confirmDelete(id, code) {
  _delId = id;
  document.getElementById('delCode').textContent = code;
  document.getElementById('deleteModal').classList.add('open');
}
function closeDeleteModal() { _delId = null; document.getElementById('deleteModal').classList.remove('open'); }
async function executeDelete() {
  if (!_delId) return;
  document.getElementById('deleteModal').classList.remove('open');
  try {
    const res  = await fetch(`/admin/offers/${_delId}`, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) {
      showToast('Offer deleted', 'green');
      const row = document.getElementById(`row-${_delId}`);
      if (row) { row.style.cssText = 'transition:all .3s;opacity:0;transform:translateX(-20px);'; setTimeout(() => row.remove(), 300); }
    } else { showToast(data.message || 'Delete failed', 'red'); }
  } catch { showToast('Network error', 'red'); }
  _delId = null;
}

// ── Toast ─────────────────────────────────────────────────────
function showToast(msg, type = 'green') {
  const icons = { green: '<polyline points="20 6 9 17 4 12"/>', red: '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>' };
  const wrap = document.getElementById('toastWrap');
  const t = document.createElement('div'); t.className = 'toast';
  t.innerHTML = `<div class="toast-icon ${type}"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">${icons[type] || icons.green}</svg></div><span>${msg}</span>`;
  wrap.appendChild(t);
  requestAnimationFrame(() => requestAnimationFrame(() => t.classList.add('show')));
  setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 400); }, 3500);
}
</script>
