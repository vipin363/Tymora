<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>TYMORA</title>
<link rel="shortcut icon" href="/image/favicon.jpeg" type="image/jpeg">
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,500;1,600&family=Montserrat:wght@200;300;400;500;600;700&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet"/>
<link href="/navBar.css" rel="stylesheet">
<link href="/footer.css" rel="stylesheet">
<link href="/productCard.css" rel="stylesheet">
</head>
<body>

    <!-- NAVBAR -->
<nav>
   <button class="hamburger" id="hamburgerBtn" aria-label="Menu">
        <span></span>
        <span></span>
        <span></span>
    </button>
    <a class="nav-logo" href="/user/home">TYMORA</a>

    <ul class="nav-links">
        <li><a href="/user/home">Home</a></li>
        <li class="nav-dropdown-li"><button class="nav-dropdown-toggle">Collections <svg width="10" height="10" viewBox="0 0 24 24" fill="none" 
         stroke="currentColor" stroke-width="2.5">
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </button>
 <div class="nav-dropdown">
    {{#each navCategories}}
      <a href="/user/shop?category={{this._id}}" class="dd-item">
        {{#if this.image}}
          <img src="{{this.image}}" alt="{{this.name}}"/>
        {{/if}}
        <span>{{this.name}}</span>
      </a>
    {{else}}
      <p class="dd-empty">No collections yet</p>
    {{/each}}
  </div>
</li>
        <li><a href="/user/shop">Shop</a></li>
        <li><a href="#">Deals</a></li>
        <li><a href="#">About Us</a></li>
    </ul>

    <div class="nav-right">
        <div class="nav-search">
            <svg width="13" height="13" fill="none" stroke="#888" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.35-4.35" />
            </svg>
            <input type="text" placeholder="Search watches…" />
        </div>

         <!-- MOBILE search icon (hidden on desktop) -->
        <button class="nav-search-toggle" id="searchToggle" title="Search" aria-label="Search">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.35-4.35" />
            </svg>
        </button>

        <button class="nav-icon-btn" title="Wishlist">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path
                    d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
            </svg>
        </button>

        <button class="nav-icon-btn" title="Cart">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <circle cx="9" cy="21" r="1" />
                <circle cx="20" cy="21" r="1" />
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
            </svg>
            <span class="cart-badge">2</span>
        </button>

        {{#if user}}
        <a href="/user/profile" class="nav-icon-btn" title="Account">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
        </svg>
        </a>
    {{else}}
    <a href="/user/login" class="login-btn">Login</a>
    {{/if}}
    </div>
</nav>

<div class="menu-overlay" id="menuOverlay"></div>
<!-- MOBILE SEARCH DROPDOWN -->
<div class="mobile-search-bar" id="mobileSearchBar">
    <input type="text" id="mobileSearchInput" placeholder="Search watches…" />
</div>



{{{body}}}

<!-- FOOTER HTML -->

<footer class="tymora-footer">

  <div class="footer-top">

    <!-- LEFT BRAND -->
    <div class="footer-brand">
      <h2>TYMORA</h2>

      <p>
        Curating the world’s most exceptional<br>
        timepieces since 1924. Excellence in every<br>
        second.
      </p>

      <div class="footer-icons">
        <span>↔</span>
        <span>@</span>
      </div>
    </div>

    <!-- COLLECTIONS -->
    <div class="footer-col">
      <h4>COLLECTIONS</h4>
      <a href="#">GRAND COMPLICATIONS</a>
      <a href="#">HERITAGE DRESS</a>
      <a href="#">SPORT PROFESSIONAL</a>
      <a href="#">SKELETON ART</a>
    </div>

    <!-- LEGAL -->
    <div class="footer-col">
      <h4>LEGAL</h4>
      <a href="#">PRIVACY POLICY</a>
      <a href="#">TERMS OF SERVICE</a>
      <a href="#">AUTHENTICITY GUARANTEE</a>
      <a href="#">SHIPPING & RETURNS</a>
    </div>

    <!-- CUSTOMER CARE -->
    <div class="footer-col">
      <h4>CUSTOMER CARE</h4>
      <a href="#">CONTACT US</a>
      <a href="#">CARE GUIDE</a>
      <a href="#">BOOK A CONSULTATION</a>
      <a href="#">FAQ</a>
    </div>

    <!-- RIGHT -->
    <div class="footer-right">
      <div class="footer-icons-top">
        <span>▭</span>
        <span>🏛</span>
      </div>

      <button class="secure-btn">🔒 SSL SECURED</button>
    </div>

  </div>

  <div class="footer-line"></div>

  <div class="footer-bottom">
    <p>© 2026 TYMORA HOROLOGY. ALL RIGHTS RESERVED.</p>

    <div class="footer-cities">
      <span>INDIA</span>
      <span>LONDON</span>
      <span>DUBAI</span>
      <span>NEW YORK</span>
    </div>
  </div>

</footer>

<script src="/js/main.js"></script>
</body>
</html>
